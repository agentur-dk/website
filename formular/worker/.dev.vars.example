# Nur für `npm run dev` auf dem eigenen Rechner.
# Auf `.dev.vars` kopieren und ausfüllen — die Datei steht in .gitignore.
# In der Cloud kommt dieser Wert aus `wrangler secret put`, nicht von hier.
MAILERSEND_TOKEN=

# Optional. Bleibt das Feld leer, wird der Schlüssel für die
# Zeitstempel-Signatur aus dem Token abgeleitet.
SIGNATUR_GEHEIMNIS=
