---
/**
 * TabNav — Sektions-Navigation (Anker-Links).
 *
 * Hinweis: Die Legacy-Seiten (leistungen.html) nutzen kein echtes Tab-Muster
 * (kein role=tablist/tabpanel). Dieser Komponente ist daher als barrierefreie
 * Anker-Link-Navigation umgesetzt, die zu Sektionen auf derselben Seite springt.
 * Bei Bedarf kann in einer späteren Phase ein echtes ARIA-Tab-Muster ergänzt werden,
 * sobald eine Seite mit explizitem Tab-Inhalt portiert wird.
 */

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items: NavItem[];
  ariaLabel?: string;
}

const { items, ariaLabel = 'Sektions-Navigation' } = Astro.props;
---

<nav class="tabnav" aria-label={ariaLabel}>
  <ul class="tabnav__list" role="list">
    {items.map((item) => (
      <li class="tabnav__item">
        <a href={item.href} class="tabnav__link">{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabnav {
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .tabnav::-webkit-scrollbar {
    display: none;
  }

  .tabnav__list {
    display: flex;
    align-items: stretch;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    min-width: 100%;
  }

  .tabnav__item {
    display: flex;
  }

  .tabnav__link {
    display: flex;
    align-items: center;
    padding: 0.875rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .tabnav__link:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-border-strong);
  }

  .tabnav__link:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .tabnav__link[aria-current="true"],
  .tabnav__link.is-active {
    color: var(--color-primary-light);
    border-bottom-color: var(--color-primary);
    font-weight: 600;
  }
</style>

<script>
  // Highlight the active link based on URL hash
  function syncTabNav() {
    const hash = window.location.hash;
    document.querySelectorAll<HTMLAnchorElement>('.tabnav__link').forEach((link) => {
      const isActive = hash && link.getAttribute('href') === hash;
      link.setAttribute('aria-current', isActive ? 'true' : 'false');
      link.classList.toggle('is-active', Boolean(isActive));
    });
  }

  syncTabNav();
  window.addEventListener('hashchange', syncTabNav);
</script>
