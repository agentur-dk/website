---
/**
 * Wer am anderen Ende sitzt — als Stimme, nicht als Galerie.
 *
 * ── Was sich am 22.09.2026 geändert hat ───────────────────────────────
 * Vorher standen hier fünf Porträts, vier davon Dither-Flächen als
 * Platzhalter. Auf der Startseite braucht es das Team nicht zweimal:
 * Wer wissen will, wer dazugehört, geht auf „Über uns" — der Knopf
 * dafür steht unten. Hier spricht einer, und das reicht.
 *
 * ── Warum eine Sprachnachricht ────────────────────────────────────────
 * „Kurze Wege" ist eine Behauptung, solange niemand hört, zu wem sie
 * kurz sind. Eine Stimme ist der Beleg, den ein weiterer Absatz in der
 * Wir-Form nicht liefern kann.
 *
 * ── Zum Transkript ────────────────────────────────────────────────────
 * Wortlaut wie gesprochen, vom Sprecher selbst geliefert. Nicht
 * geglättet: Die kleinen Unebenheiten gesprochener Sprache sind der
 * Grund, warum man einer Aufnahme mehr glaubt als einem Werbetext.
 */
import Sprachnachricht from './Sprachnachricht.astro';

const base = import.meta.env.BASE_URL;

const transkript = [
  'Hallo, ich bin Daniel Kontelis – Gründer der agentur dk in Köln.',
  'In den Medien bin ich seit über 20 Jahren. In der Zeit lernt man vor allem eins: Die Erfahrung liegt nicht in der Art der Umsetzung, sondern in der Kommunikation – tiefes Verständnis von Kundenwünschen und Zielgruppen.',
  'Technisch sind wir auch vorne dabei. Beratung, Planung, Umsetzung — alles aus einer Hand.',
  'Und wer einmal da ist, bleibt meistens. Fast alle Kunden schon seit vielen Jahren.',
  'Rufen Sie einfach an – wir laden Sie gerne zu einem unverbindlichen Beratungsgespräch ein.',
];
---

<section class="section section--hell" aria-labelledby="kernteam-heading">
  <div class="container">
    <p class="section-label">Wer für Sie arbeitet</p>
    <h2 id="kernteam-heading" class="kt__heading">Kurze Wege heißt: Sie kennen die Leute</h2>
    <p class="kt__lead">
      Fünf Menschen in Köln, die seit Jahren zusammenarbeiten. Bei größeren
      Projekten kommen erprobte Leute dazu – Ihr Ansprechpartner bleibt derselbe.
    </p>

    <Sprachnachricht transkript={transkript} class="kt__nachricht" />

    <p class="kt__weiter">
      <a href={`${base}ueber-uns.html`} class="btn btn--secondary">
        Das ganze Team ansehen
      </a>
    </p>
  </div>
</section>

<style>
  /* Aus der abgeloesten Fassung uebernommen. Beim Neuschreiben war der
     Stilblock mitgegangen und die Ueberschrift stand in 19,2 px — also
     in Fliesstextgroesse. Im Browser gemessen, nicht im Markup vermutet.

     `font-weight: 700` steht hier wirkungslos: Das Mono-Thema setzt
     alle Ueberschriften ueber `.theme-mono.theme-mono :is(h1..h6)` auf
     400 und gewinnt mit (0,2,1) gegen die Spezifitaet einer scoped
     Klasse (0,2,0). Nachgemessen — die Ueberschrift rendert in 400.
     Das ist richtig so: Auf dieser Seite stehen alle Ueberschriften in
     400, und eine Ausnahme waere ein Bruch. Die Zeile bleibt nur als
     Hinweis stehen, damit sie niemand als Fehler wieder anfasst. */
  .kt__heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    line-height: 1.15;
    letter-spacing: -.02em;
    margin: .35rem 0 .75rem;
    text-wrap: balance;
  }

  .kt__lead {
    color: var(--color-text-muted);
    max-width: 54ch;
    margin: 0 0 2.5rem;
  }
</style>
