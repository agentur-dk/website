---
/**
 * Wer am anderen Ende sitzt.
 *
 * ── Warum es diesen Abschnitt gibt ────────────────────────────────────
 * Die Startseite sprach bis zum 21.09.2026 in der Wir-Form, ohne dass
 * ein einziger Mensch darin vorkam. „Kurze Wege" ist eine Behauptung,
 * solange niemand sieht, zu wem die Wege kurz sind.
 *
 * ── Zu den Bildern ────────────────────────────────────────────────────
 * Vier der fünf Porträts sind Dither-Flächen, keine Fotos. Das ist
 * Absicht und kein Provisorium mit schlechtem Gewissen: Ein
 * KI-erzeugtes Foto einer realen Person sähe aus wie eine Aufnahme und
 * wäre keine. Eine erkennbar abstrakte Fläche behauptet nichts. Sobald
 * echte Porträts vorliegen, treten sie an dieselbe Stelle.
 *
 * ── Zu den Zeilen unter den Namen ─────────────────────────────────────
 * Keine erfundenen Zitate. Was hier steht, sagt die Agentur über ihre
 * Leute — nicht die Leute über sich selbst. Ein Satz in
 * Anführungszeichen, den jemand nie gesagt hat, ist eine Fälschung,
 * auch wenn er nett gemeint ist.
 */
import { Image } from 'astro:assets';
import { existsSync } from 'node:fs';
import Dither from './ui/Dither.astro';
import portraet from '../assets/team/daniel-kontelis.jpg';
import { siteConfig } from '../config/site.config';

const base = import.meta.env.BASE_URL;

/* Der Player erscheint nur, wenn die Aufnahme wirklich da ist. Ein
   Abspielknopf, der ins Leere greift, ist schlimmer als keiner. */
const AUDIO = 'audio/daniel-kontelis-begruessung.mp3';
const hatAudio = existsSync(new URL(`../../public/${AUDIO}`, import.meta.url));

/* Das Transkript ist Pflicht, nicht Zugabe: WCAG 1.2.1 verlangt zu
   reinem Ton eine Textalternative. Eine Agentur, die BFSG verkauft und
   das auf der eigenen Seite bricht, verkauft sich selbst nicht ab. */
const transkript = [
  'Hallo, ich bin Daniel Kontelis von der agentur dk aus Köln.',
  'Wir machen das seit vielen Jahren – und in den Jahren haben wir vor allem eines gelernt: Die meisten Unternehmen brauchen nicht mehr Technik, sondern die richtige. Was heute funktioniert, sieht anders aus als vor fünf Jahren, und wir bauen mit dem, was jetzt trägt.',
  'Beratung, Planung und Umsetzung kommen bei uns aus einer Hand. Sie müssen nicht drei Dienstleister koordinieren, und niemand schiebt etwas auf den anderen.',
  'Woran wir merken, dass das aufgeht: Wer einmal bei uns ist, bleibt meistens. Manche Kunden betreuen wir seit über fünf Jahren.',
  'Erzählen Sie mir einfach, was Sie vorhaben. Im ersten Gespräch sortieren wir gemeinsam, was Sie wirklich brauchen – und was Sie sich sparen können.',
];

/* Die Porträts der Kollegen liegen noch nicht vor. Statt zu warten,
   sucht die Komponente selbst nach ihnen: Liegt `src/assets/team/
   <datei>` da, wird das Bild gezeigt; sonst bleibt die Dither-Fläche.

   `import.meta.glob` mit `eager` löst die Dateien zur Bauzeit auf —
   ein einfaches `import` würde den Bau abbrechen, solange die Datei
   fehlt. So genügt es, die Bilder abzulegen und neu zu bauen. Kein
   Eingriff in den Code, keine Stelle, die jemand vergessen kann. */
const bilder = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/team/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const bildVon = (datei: string): ImageMetadata | undefined =>
  bilder[`../assets/team/${datei}`]?.default;

const team = [
  { name: 'Robin Kindopp',  rolle: 'Projektmanagement, WordPress',
    zeile: 'Wenn es um WordPress geht oder Ihr Projekt läuft, sprechen Sie meistens mit ihm.',
    feld: 'pulse' as const, datei: 'robin-kindopp.jpg' },
  { name: 'Filipos Makkas', rolle: 'Projektmanagement, Design',
    zeile: 'Hält Gestaltung und Zeitplan zusammen – und sagt Ihnen, wenn beides nicht gleichzeitig geht.',
    feld: 'drift' as const, datei: 'filipos-makkas.jpg' },
  { name: 'Julius Heinisch', rolle: 'Programmierung, Datenbanken',
    zeile: 'Alles, was hinter der Oberfläche passiert: Schnittstellen, Datenbanken, Sonderfälle.',
    feld: 'fade' as const, datei: 'julius-heinisch.jpg' },
  { name: 'Shakil Rifaat',  rolle: 'UX- und Interface-Design',
    zeile: 'Sorgt dafür, dass Besucher finden, was sie suchen, ohne darüber nachzudenken.',
    feld: 'brain' as const, datei: 'shakil-rifaat.jpg' },
];
---

<section class="section section--hell" aria-labelledby="kernteam-heading">
  <div class="container">
    <p class="section-label">Wer für Sie arbeitet</p>
    <h2 id="kernteam-heading" class="kt__heading">Kurze Wege heißt: Sie kennen die Leute</h2>
    <p class="kt__lead">
      Fünf Menschen in Köln, die seit Jahren zusammenarbeiten. Bei größeren
      Projekten kommen erprobte Leute dazu – Ihr Ansprechpartner bleibt derselbe.
    </p>

    <div class="kt__oben">
      <figure class="kt__haupt">
        <Image src={portraet} alt="Daniel Kontelis" width={240} height={240}
               class="kt__foto" loading="lazy" />
        <figcaption>
          <p class="kt__name">Daniel Kontelis</p>
          <p class="kt__rolle">Ihr Ansprechpartner</p>
          <p class="kt__kontakt">
            <a href={`tel:${siteConfig.contact.phone}`}>0221 986 55 229</a><br />
            <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
          </p>
        </figcaption>
      </figure>

      <div class="kt__wort">
        {hatAudio && (
          <>
            <p class="kt__wort-titel">Kurz vorgestellt</p>
            {/* `preload="none"`: Ohne Klick wird nichts geladen — das
                ist auch eine Datenschutzfrage, nicht nur eine der
                Ladezeit. */}
            <audio class="kt__audio" controls preload="none" src={`${base}${AUDIO}`}>
              Ihr Browser kann diese Aufnahme nicht abspielen. Der Text steht darunter.
            </audio>
          </>
        )}
        <details class="kt__transkript" open={!hatAudio}>
          <summary>{hatAudio ? 'Was gesagt wird (Transkript)' : 'Ein Wort vorab'}</summary>
          {transkript.map((satz) => <p>{satz}</p>)}
        </details>
      </div>
    </div>

    <ul class="kt__liste" role="list">
      {team.map((m) => (
        <li class="ktkarte">
          {bildVon(m.datei)
            ? <Image src={bildVon(m.datei)!} alt={m.name} width={320} height={320}
                     class="ktkarte__bild ktkarte__foto" loading="lazy" />
            : <div class="ktkarte__bild" aria-hidden="true">
                <Dither field={m.feld} cell={3} />
              </div>}
          <p class="ktkarte__name">{m.name}</p>
          <p class="ktkarte__rolle">{m.rolle}</p>
          <p class="ktkarte__zeile">{m.zeile}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .kt__heading {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem); line-height: 1.15;
    letter-spacing: -.02em; margin: .35rem 0 .75rem; text-wrap: balance;
  }
  .kt__lead { color: var(--color-text-muted); max-width: 54ch; margin: 0 0 2.5rem; }

  .kt__oben {
    display: grid; gap: 2rem; align-items: start;
    grid-template-columns: minmax(12rem, 16rem) 1fr;
    margin-bottom: 3rem;
  }
  @media (max-width: 40rem) { .kt__oben { grid-template-columns: 1fr; } }

  .kt__haupt { margin: 0; }
  .kt__foto {
    width: 100%; height: auto; aspect-ratio: 1;
    object-fit: cover; border-radius: var(--radius-md);
    filter: grayscale(1) contrast(1.05);
  }
  .kt__name {
    font-family: var(--font-display); font-weight: 700;
    font-size: 1.1rem; margin: .9rem 0 .1rem;
  }
  .kt__rolle { color: var(--color-text-muted); font-size: .9rem; margin: 0 0 .5rem; }
  .kt__kontakt { font-size: .9rem; margin: 0; line-height: 1.6; }

  /* Ohne Aufnahme steht hier nur das Transkript — dann braucht der
     Block keine eigene Breite. Mit Aufnahme hält er beides zusammen. */
  .kt__wort { min-width: 0; }
  .kt__wort-titel {
    font-family: var(--font-mono); font-size: .75rem;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--color-text-muted); margin: 0 0 .6rem;
  }
  .kt__audio { width: 100%; max-width: 28rem; margin-bottom: 1.25rem; }

  .kt__transkript {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.1rem; max-width: 56ch;
  }
  .kt__transkript > summary {
    cursor: pointer; font-weight: 600; font-size: .9rem;
    margin-bottom: .6rem;
  }
  .kt__transkript > p {
    margin: 0 0 .7rem; color: var(--color-text-muted);
    font-size: .95rem; line-height: 1.55;
  }
  .kt__transkript > p:last-child { margin-bottom: 0; }

  .kt__liste {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .ktkarte {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem;
  }
  /* Dunkel, nicht hell: Die Dither-Komponente zeichnet mit
     `--color-bg` als Grund. In einem hellen Abschnitt heißt das hell
     auf hell — die Fläche sah leer aus, nicht abstrakt. Auf dunklem
     Grund wird aus derselben Fläche ein Bild, und die ASCII-Ästhetik
     der Seite bekommt einen Platz mitten im Hellen. */
  .ktkarte__bild {
    aspect-ratio: 1; margin-bottom: .9rem;
    border-radius: var(--radius-md); overflow: hidden;
    background: #101010;
    --color-bg: #101010;
  }
  /* Dasselbe Maß wie die Dither-Fläche, damit der Wechsel von
     Platzhalter zu Foto das Raster nicht verschiebt. Graustufen wie
     beim Hauptporträt: Die Seite hat eine Farbe, und die ist blau. */
  .ktkarte__foto {
    width: 100%; height: auto; object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }
  .ktkarte__name {
    font-family: var(--font-display); font-weight: 700;
    font-size: 1rem; margin: 0 0 .1rem;
  }
  .ktkarte__rolle {
    font-family: var(--font-mono); font-size: .75rem;
    color: var(--color-accent); margin: 0 0 .5rem;
    letter-spacing: .04em;
  }
  .ktkarte__zeile {
    margin: 0; font-size: .88rem; line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
