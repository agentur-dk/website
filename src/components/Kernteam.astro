---
/**
 * Wer am anderen Ende sitzt — als Stimme, nicht als Galerie.
 *
 * Das Team steht auf „Über uns"; hier spricht einer, und das reicht.
 *
 * ── Warum eine Sprachnachricht ────────────────────────────────────────
 * „Kurze Wege" ist eine Behauptung, solange niemand hört, zu wem sie
 * kurz sind. Eine Stimme ist der Beleg, den ein weiterer Absatz in der
 * Wir-Form nicht liefern kann.
 *
 * ── Zum Transkript ────────────────────────────────────────────────────
 * Wortlaut wie gesprochen, vom Sprecher selbst geliefert. Nicht
 * geglättet: Die kleinen Unebenheiten gesprochener Sprache sind der
 * Grund, warum man einer Aufnahme mehr glaubt als einem Werbetext.
 */
import Sprachnachricht from './Sprachnachricht.astro';
import { LANG } from '../data/sprachnachricht';

const base = import.meta.env.BASE_URL;

---

<section class="kt-buehne section section--lg section--hell" aria-labelledby="kernteam-heading">
  <div class="container kt-buehne__bild">
    <!--
      Zwei Spalten: links, was zu lesen ist, rechts die Nachricht.
      Nebeneinander, weil beides dasselbe sagt — der Text behauptet
      kurze Wege, die Stimme belegt sie. Untereinander laese man erst
      die Behauptung und traefe den Beleg erst nach dem Scrollen.

      Unterhalb von 900 px steht die Nachricht darunter und nimmt die
      volle Breite: Nebeneinander blieben fuer die Blase keine 200 px.
    -->
    <div class="kt">
      <div class="kt__text">
        <p class="section-label">Wer für Sie arbeitet</p>
        <h2 id="kernteam-heading" class="kt__heading"><span class="kt__zeile">Kurze Wege heißt:</span> <span class="kt__zeile">Sie kennen die Leute</span></h2>
        <p class="kt__lead">
          Menschen, die seit Jahren zusammenarbeiten. Ihr Ansprechpartner
          bleibt derselbe.
        </p>
      </div>

      <Sprachnachricht aufnahme={LANG} class="kt__nachricht" />

      <!--
        Der Knopf steht als eigenes Rasterfeld und nicht im Textblock:
        Untereinander soll er NACH der Nachricht kommen — erst hoeren,
        dann weitergehen. Im Textblock stuende er davor.
      -->
      <p class="kt__weiter">
        <a href={`${base}ueber-uns.html`} class="btn btn--secondary">
          Das ganze Team ansehen
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  /* Aus der abgeloesten Fassung uebernommen. Beim Neuschreiben war der
     Stilblock mitgegangen und die Ueberschrift stand in 19,2 px — also
     in Fliesstextgroesse. Im Browser gemessen, nicht im Markup vermutet.

     `font-weight: 700` steht hier wirkungslos: Das Mono-Thema setzt
     alle Ueberschriften ueber `.theme-mono.theme-mono :is(h1..h6)` auf
     400 und gewinnt mit (0,2,1) gegen die Spezifitaet einer scoped
     Klasse (0,2,0). Nachgemessen — die Ueberschrift rendert in 400.
     Das ist richtig so: Auf dieser Seite stehen alle Ueberschriften in
     400, und eine Ausnahme waere ein Bruch. Die Zeile bleibt nur als
     Hinweis stehen, damit sie niemand als Fehler wieder anfasst. */
  .kt__heading {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    margin: .35rem 0 .75rem;
    text-wrap: balance;
  }

  .kt__lead {
    color: var(--color-text-muted);
    max-width: 54ch;
    margin: 0 0 2.5rem;
  }

  /* Der Höhepunkt der Startseite: Am Schreibtisch bleibt der Abschnitt
     beim Scrollen stehen, die Überschrift setzt sich Zeile für Zeile
     zusammen, die Nachricht fährt herein, und danach bleibt Zeit zum
     Hören. Am Telefon steht er still: Dort wäre ein festgehaltener
     Bildschirm nur Scrollen ohne Wirkung. Nur Lage und Ausschnitt
     bewegen sich, nie die Deckkraft.

     Zeitleiste und Bereich stehen in eigenen Regeln mit verdoppelter
     Klasse: Der Verdichter zöge sie sonst in die Kurzschreibweise
     `animation`, die Chrome dort nicht annimmt, und nichts liefe. */
  .kt__zeile { display: block; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 900px) and (min-height: 640px) {
      :global(html:not([data-motion="paused"])) .kt-buehne {
        view-timeline: --kt-buehne block;
        min-height: 190svh;
      }
      :global(html:not([data-motion="paused"])) .kt-buehne__bild {
        position: sticky;
        top: 0;
        min-height: 100svh;
        display: grid;
        align-content: center;
      }
      :global(html:not([data-motion="paused"])) .kt__zeile {
        animation: kt-zeile linear both;
      }
      :global(html:not([data-motion="paused"])) .kt__zeile.kt__zeile {
        animation-timeline: --kt-buehne;
        animation-range: contain 0% contain 22%;
      }
      :global(html:not([data-motion="paused"])) .kt__zeile.kt__zeile + .kt__zeile {
        animation-range: contain 10% contain 32%;
      }
      :global(html:not([data-motion="paused"])) .kt :global(.kt__nachricht) {
        animation: kt-nachricht linear both;
      }
      :global(html:not([data-motion="paused"])) .kt :global(.kt__nachricht.kt__nachricht) {
        animation-timeline: --kt-buehne;
        animation-range: contain 15% contain 45%;
      }
    }
  }
  @keyframes kt-zeile {
    from { clip-path: inset(0 0 100% 0); transform: translateY(0.5em); }
    to   { clip-path: inset(0 0 -0.2em 0); transform: none; }
  }
  @keyframes kt-nachricht {
    from { clip-path: inset(0 0 0 100%); transform: translateX(12%) scale(0.94); }
    to   { clip-path: inset(0); transform: none; }
  }
</style>
