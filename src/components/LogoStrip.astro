---
/**
 * Vertrauensleiste: Kundenlogos bzw. Kundennamen in einer Endlosschleife.
 *
 * Bildmarken werden weiß dargestellt: `brightness(0)` färbt alles Sichtbare
 * schwarz und lässt die Transparenz stehen, `invert(1)` dreht das auf Weiß.
 * Aus jedem mehrfarbigen Logo wird damit eine saubere Silhouette — der
 * übliche Weg für eine Logowand auf dunklem Grund, und der einzige, der
 * ohne eine eigens gelieferte Weißversion je Marke auskommt.
 *
 * Fehlt die Datei, setzt die Leiste den Namen. Beides ist so abgestimmt,
 * dass eine gemischte Reihe nicht wie ein Fehler aussieht.
 */
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { kunden } from '../data/kunden';

const base = import.meta.env.BASE_URL;

/* Beim Build prüfen, ob jede eingetragene Datei wirklich unter public/logos/
   liegt. Ohne die Prüfung fiele ein Tippfehler im Dateinamen nur dadurch auf,
   dass in der Leiste eine Lücke klafft — und das sieht man leicht nicht. */
/*
 * Marken mit eigener Fallstudie bleiben draußen.
 *
 * Sie standen sonst zweimal auf derselben Seite: hier als Bildmarke und
 * weiter unten als Überschrift ihrer Fallstudie. Zweimal derselbe Name
 * wirkt nicht doppelt so überzeugend, sondern nach kurzer Liste.
 *
 * Der Streifen zeigt die Breite, die Fallstudie zeigt die Tiefe.
 */
/**
 * Die Eigenmasse einer Bilddatei, in ihren eigenen Einheiten.
 *
 * ── Warum das sein muss ───────────────────────────────────────────────
 * Die Logos laden verzoegert (`loading="lazy"`), und ein noch nicht
 * geladenes Bild ohne Groessenangabe ist NULL Pixel breit. Die Spur der
 * Laufschrift ist die Summe ihrer Kinder — sie faengt also schmal an und
 * waechst, waehrend die Bilder eintreffen.
 *
 * Das ist nicht nur ein Sprung im Satz, sondern eine wandernde
 * Geschwindigkeit: Die Animation verschiebt um -50 % der EIGENEN Breite
 * in 40 s. Schmale Spur heisst wenige Pixel je Sekunde. Auf einem
 * schmalen Bildschirm kommt ein grosser Teil der Spur nie ins Sichtfeld,
 * die Bilder dort laden also gar nicht, und die Leiste bleibt dauerhaft
 * langsam. Genau das war am Telefon zu sehen.
 *
 * Mit `width`/`height` am `<img>` kennt der Browser das Seitenverhaeltnis
 * vor dem ersten Byte und haelt den Platz frei. Die Spur hat damit von
 * Anfang an ihre endgueltige Breite.
 *
 * Eager laden waere die falsche Antwort: Die sechzehn Dateien wiegen
 * zusammen 415 kB und stehen direkt unter dem Kopfbereich.
 */
function eigenmasse(pfad: string): { breite: number; hoehe: number } {
  const puffer = readFileSync(pfad);

  if (pfad.endsWith('.svg')) {
    const kopf = puffer.toString('utf8', 0, 4000);
    /* viewBox zuerst: Sie steht fast immer da und ist verlaesslicher als
       width/height, die in Prozent oder Millimetern stehen duerfen. */
    const kasten = kopf.match(
      /viewBox\s*=\s*["']\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)/i);
    if (kasten) return { breite: Number(kasten[1]), hoehe: Number(kasten[2]) };
    const b = kopf.match(/\bwidth\s*=\s*["']([\d.]+)(?:px)?["']/i);
    const h = kopf.match(/\bheight\s*=\s*["']([\d.]+)(?:px)?["']/i);
    if (b && h) return { breite: Number(b[1]), hoehe: Number(h[1]) };
    throw new Error(
      `LogoStrip: ${pfad} hat weder viewBox noch width/height in Pixeln. ` +
      `Ohne Seitenverhaeltnis laeuft die Leiste ungleichmaessig — ` +
      `viewBox in der Datei ergaenzen.`);
  }

  /* PNG: Breite und Hoehe stehen im IHDR, ab Byte 16, je vier Bytes. */
  if (puffer.length > 24 && puffer.readUInt32BE(0) === 0x89504e47) {
    return { breite: puffer.readUInt32BE(16), hoehe: puffer.readUInt32BE(20) };
  }

  throw new Error(
    `LogoStrip: ${pfad} ist weder SVG noch PNG. Die Leiste braucht die ` +
    `Eigenmasse, um Platz freizuhalten — Datei umwandeln oder ersetzen.`);
}

const eintraege = kunden.filter((k) => !k.fallstudie).map((k) => {
  if (!k.logo) return { ...k, datei: null };
  const pfad = join('public', 'logos', k.logo);
  if (!existsSync(pfad)) {
    throw new Error(
      `LogoStrip: "${k.logo}" ist für ${k.name} eingetragen, liegt aber nicht ` +
      `unter public/logos/. Datei ablegen oder den Eintrag in ` +
      `src/data/kunden.ts entfernen.`
    );
  }
  /* Die Hoehe in Pixeln, wie die CSS sie setzt (1 rem = 16 px). Breite
     und Hoehe am <img> sind nur das Verhaeltnis — die CSS bestimmt die
     tatsaechliche Groesse, der Browser rechnet die Breite daraus. */
  const masse = eigenmasse(pfad);
  const hoehePx = Math.round((k.hoehe ?? 2.4) * 16);
  return {
    ...k,
    datei: `${base}logos/${k.logo}`,
    breitePx: Math.round((masse.breite / masse.hoehe) * hoehePx),
    hoehePx,
  };
});

/* Zweiter Durchlauf nur für die nahtlose Schleife. Für Screenreader
   ausgeblendet, damit die Namen nicht doppelt vorgelesen werden. */
const durchlaeufe = [
  { liste: eintraege, versteckt: false },
  { liste: eintraege, versteckt: true },
];
---

<section class="logo-strip" aria-labelledby="logo-strip-heading">
  <div class="container">
    <h2 class="logo-strip__label" id="logo-strip-heading">Zusammenarbeit mit</h2>

    <div class="logo-strip__track-wrap">
      <ul class="logo-strip__track" role="list">
        {durchlaeufe.map(({ liste, versteckt }) =>
          liste.map((k) => (
            <li class="logo-strip__item" {...versteckt ? { 'aria-hidden': 'true' } : {}}>
              {k.datei ? (
                <img
                  class:list={['logo-strip__logo',
                    k.eigeneFarben && 'logo-strip__logo--eigen']}
                  src={k.datei}
                  alt={versteckt ? '' : k.name}
                  width={k.breitePx}
                  height={k.hoehePx}
                  loading="lazy"
                  decoding="async"
                  style={`--logo-hoehe: ${k.hoehe ?? 2.4}rem`}
                />
              ) : (
                <span class="logo-strip__name">{k.name}</span>
              )}
            </li>
          ))
        )}
      </ul>
    </div>
  </div>
</section>

<style>
  .logo-strip {
    padding-block: 2.5rem 3rem;
    overflow: hidden;
  }

  /* Die Laufschrift soll über die volle Fensterbreite laufen, nicht im
     Satzspiegel stehen: Sonst reißt sie an der Containerkante ab, obwohl
     die Maske ein Auslaufen andeutet. Nur hier — .container behält seine
     Breite überall sonst. Der :global()-Zusatz ist nötig, weil .container
     aus global.css kommt und Astros Scope-Attribut nicht trägt. */
  .logo-strip :global(.container) {
    max-width: none;
    width: 100%;
    margin-inline: 0;
    padding-inline: 0;
  }

  .logo-strip__label {
    text-align: center;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 2rem;
  }

  .logo-strip__track-wrap {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right, transparent 0%, black 10%, black 90%, transparent 100%);
    mask-image: linear-gradient(
      to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .logo-strip__track {
    display: flex;
    align-items: center;
    gap: 5.2rem;
    width: max-content;
    animation: logo-scroll 40s linear infinite;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .logo-strip__item {
    display: flex;
    align-items: center;
    /* Gleiche Zeilenhöhe für Bild- und Wortmarken, damit eine gemischte
       Reihe eine gemeinsame Grundlinie behält. */
    height: 5.3rem;
  }

  /* Aus jeder Bildmarke wird eine weiße Silhouette. */
  .logo-strip__logo {
    height: var(--logo-hoehe, 2.4rem);
    width: auto;
    max-width: 19rem;
    object-fit: contain;
    filter: brightness(0) invert(1);
    /* Nicht ganz deckend: die Logos sollen die Überschriften der Seite
       nicht überstrahlen. Auf Weiß über #121212 bleibt der Kontrast
       auch bei 0,75 weit über der Schwelle für Grafikobjekte. */
    opacity: 0.75;
  }

  /* Die Ausnahme vom Weißfilter. Warum sie für eine Marke gilt, steht als
     Begründung bei `eigeneFarben` in src/data/kunden.ts — dort steht sie
     neben der Entscheidung und nicht neben der Technik. */
  .logo-strip__logo--eigen {
    filter: none;
  }

  /* Wortmarke als Rückfall. Bewusst ohne Rahmen und Kästchen: gerahmte
     Namen sehen aus wie Platzhalter, nicht wie Referenzen. */
  .logo-strip__name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.015em;
    color: var(--color-text);
    opacity: 0.75;
    white-space: nowrap;
  }

  @keyframes logo-scroll {
    from { transform: translateX(0); }
    /* Die Hälfte, weil die Liste zweimal dasselbe enthält —
       an dieser Stelle sieht der Sprung an den Anfang nahtlos aus. */
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-strip__track {
      animation: none;
      /* Ohne Lauf würde die zweite Hälfte rechts abgeschnitten
         herumstehen; zentriert wirkt die Reihe wie gesetzt. */
      justify-content: center;
      width: 100%;
      flex-wrap: wrap;
      gap: 2.3rem 3.45rem;
    }
    .logo-strip__track-wrap {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .logo-strip__item[aria-hidden="true"] {
      display: none;
    }
  }

  html[data-motion="paused"] .logo-strip__track {
    animation-play-state: paused;
  }

  /* Bis zum 23.09.2026 stand hier eine Ausnahme fuer schmale Fenster:
     kleinerer Abstand, kleinere Wortmarken. Sie hat die Leiste langsamer
     laufen lassen, ohne dass jemand die Dauer angefasst haette.

     Der Zusammenhang: Die Animation verschiebt die Spur um -50 % IHRER
     EIGENEN Breite, und zwar in 40 s. Ein kleinerer Abstand macht die
     Spur schmaler, also sind es in denselben 40 s weniger Pixel.
     Gemessen: 3686 px Spur und 46,1 px/s ab 641 px Fensterbreite,
     3266 px Spur und 40,8 px/s darunter — elf Prozent langsamer.

     Die Ausnahme ist weg. Die Leiste laeuft auf jeder Breite gleich,
     und wer kuenftig den Abstand aendert, aendert damit wieder die
     Geschwindigkeit: Das ist der Preis einer Dauer in Sekunden statt
     in Pixeln pro Sekunde, und er ist jetzt wenigstens an einer
     einzigen Stelle zu zahlen. */
</style>
