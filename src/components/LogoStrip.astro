---
interface Logo {
  name: string;
  src?: string;
  alt?: string;
}

interface Props {
  logos: Logo[];
  label?: string;
}

const { logos, label = 'Unsere Kunden' } = Astro.props;
---

<section class="logo-strip" aria-label={label}>
  {label && <p class="logo-strip__label" aria-hidden="true">{label}</p>}
  <div class="logo-strip__track-wrapper">
    <ul class="logo-strip__track" role="list" aria-label="Kundenlogos">
      {logos.map((logo) => (
        <li class="logo-strip__item">
          {logo.src
            ? <img src={logo.src} alt={logo.alt ?? logo.name} class="logo-strip__img" width="120" height="40" loading="lazy" />
            : <span class="logo-strip__placeholder">{logo.name}</span>
          }
        </li>
      ))}
      {/* Duplicate list for seamless infinite loop – hidden from AT */}
      {logos.map((logo) => (
        <li class="logo-strip__item" aria-hidden="true">
          {logo.src
            ? <img src={logo.src} alt="" class="logo-strip__img" width="120" height="40" loading="lazy" />
            : <span class="logo-strip__placeholder">{logo.name}</span>
          }
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logo-strip {
    padding-block: 3rem;
    overflow: hidden;
  }

  .logo-strip__label {
    text-align: center;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .logo-strip__track-wrapper {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .logo-strip__track-wrapper:hover .logo-strip__track {
    animation-play-state: paused;
  }

  .logo-strip__track {
    display: flex;
    align-items: center;
    gap: 3rem;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    animation: logo-scroll 24s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-strip__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
  }

  @keyframes logo-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .logo-strip__item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-strip__img {
    height: 40px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1) brightness(0.7);
    transition: filter var(--transition-base);
    max-width: 140px;
  }

  .logo-strip__img:hover {
    filter: grayscale(0) brightness(1);
  }

  .logo-strip__placeholder {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    color: var(--color-text-faint);
    white-space: nowrap;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
</style>
