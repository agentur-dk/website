---
/**
 * Formular-Endpunkt – wird mit dem PHP-Skript auf dk-dk.de finalisiert.
 * Kein Formspree! Eigener PHP-Mailer (PHPMailer/SMTP).
 */
const FORM_ENDPOINT = 'https://dk-dk.de/formular/send.php';
const base = import.meta.env.BASE_URL;

interface Props {
  page?: string;
  heading?: string;
}

const { page = 'Unbekannte Seite', heading = 'Projekt anfragen' } = Astro.props;

const topics = [
  'Barrierefreie Website (BFSG)',
  'WordPress-Relaunch',
  'SEO & GEO',
  'Online-Marketing',
  'Social Recruiting',
  'Corporate Design',
  'KI-Services',
  'Sonstiges',
];
import Icon from './ui/Icon.astro';
---

<section class="lf-section" id="contact" aria-labelledby="lf-heading">
  <div class="lf-inner">
    <h2 id="lf-heading" class="lf-heading">{heading}</h2>

    <!-- Status-Region (aria-live) -->
    <div id="lf-status" role="status" aria-live="polite" aria-atomic="true" class="lf-status sr-only"></div>

    <form
      id="lf-form"
      class="lf-form"
      novalidate
      data-endpoint={FORM_ENDPOINT}
    >
      <!-- Seiten-Tracking -->
      <input type="hidden" name="page" value={page} />
      <!-- Spam: Zeitstempel (wird per JS gesetzt) -->
      <input type="hidden" name="form_started" id="lf-started" value="" />
      <!-- Honeypot: nur Bots füllen dieses Feld aus -->
      <input
        type="text"
        name="_gotcha"
        class="lf-honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <!-- Fortschrittsanzeige -->
      <ol class="lf-steps" aria-label="Formular-Fortschritt">
        <li class="lf-steps__item lf-steps__item--active" id="lf-step-ind-1">
          <span class="lf-steps__num" aria-hidden="true">1</span> Anliegen
        </li>
        <li class="lf-steps__item" id="lf-step-ind-2">
          <span class="lf-steps__num" aria-hidden="true">2</span> Kontakt
        </li>
      </ol>

      <!-- Schritt 1: Themen -->
      <div id="lf-step-1" class="lf-step">
        <h3 class="lf-step__title">Worum geht es?</h3>
        <fieldset class="lf-fieldset">
          <legend class="lf-legend">
            Ihr Anliegen
            <span class="lf-optional">(Mehrfachauswahl möglich)</span>
          </legend>
          <div class="lf-topics">
            {topics.map((topic) => (
              <label class="lf-topic" data-topic={topic === 'Sonstiges' ? 'other-trigger' : undefined}>
                <input
                  type="checkbox"
                  name="interesse[]"
                  value={topic}
                  class="lf-topic__input"
                />
                <span class="lf-topic__box" aria-hidden="true">
                  <Icon name="check" size={14} />
                </span>
                <span class="lf-topic__label">{topic}</span>
              </label>
            ))}
          </div>
          <!-- Sonstiges-Freitext (erscheint bei Auswahl "Sonstiges") -->
          <div id="lf-other-field" class="lf-other" hidden>
            <label for="lf-other-text" class="lf-label">
              Bitte beschreiben Sie Ihr Anliegen kurz
            </label>
            <textarea
              id="lf-other-text"
              name="anliegen_text"
              class="lf-control lf-textarea"
              rows="3"
              aria-describedby="lf-other-error"
            ></textarea>
            <span id="lf-other-error" class="lf-error" role="alert" hidden>
              Bitte geben Sie Ihr Anliegen ein.
            </span>
          </div>
        </fieldset>

        <div class="lf-step__nav lf-step__nav--end">
          <button type="button" class="lf-btn lf-btn--primary" id="lf-next">
            Weiter
          </button>
        </div>
      </div>

      <!-- Schritt 2: Kontaktdaten -->
      <div id="lf-step-2" class="lf-step" hidden>
        <h3 class="lf-step__title">Ihre Kontaktdaten</h3>

        <div class="lf-row">
          <div class="lf-group">
            <label for="lf-name" class="lf-label">
              Name
              <span aria-hidden="true">*</span>
              <span class="sr-only">(Pflichtfeld)</span>
            </label>
            <input
              type="text"
              id="lf-name"
              name="name"
              class="lf-control"
              autocomplete="name"
              required
              aria-required="true"
              aria-describedby="lf-name-error"
            />
            <span id="lf-name-error" class="lf-error" role="alert" hidden>
              Bitte geben Sie Ihren Namen ein.
            </span>
          </div>
          <div class="lf-group">
            <label for="lf-email" class="lf-label">
              E-Mail
              <span aria-hidden="true">*</span>
              <span class="sr-only">(Pflichtfeld)</span>
            </label>
            <input
              type="email"
              id="lf-email"
              name="email"
              class="lf-control"
              autocomplete="email"
              required
              aria-required="true"
              aria-describedby="lf-email-error"
            />
            <span id="lf-email-error" class="lf-error" role="alert" hidden>
              Bitte geben Sie eine gültige E-Mail-Adresse ein.
            </span>
          </div>
        </div>

        <div class="lf-group">
          <label for="lf-website" class="lf-label">
            Ihre Website
            <span class="lf-optional">(optional)</span>
          </label>
          <input
            type="url"
            id="lf-website"
            name="website_url"
            class="lf-control"
            placeholder="https://ihre-domain.de"
            autocomplete="url"
            aria-describedby="lf-website-error"
          />
          <span id="lf-website-error" class="lf-error" role="alert" hidden>
            Bitte geben Sie eine gültige URL ein (z.&nbsp;B. https://beispiel.de).
          </span>
        </div>

        <div class="lf-group">
          <label for="lf-message" class="lf-label">
            Nachricht
            <span aria-hidden="true">*</span>
            <span class="sr-only">(Pflichtfeld)</span>
          </label>
          <textarea
            id="lf-message"
            name="message"
            class="lf-control lf-textarea"
            rows="5"
            required
            minlength="10"
            aria-required="true"
            aria-describedby="lf-message-error"
          ></textarea>
          <span id="lf-message-error" class="lf-error" role="alert" hidden>
            Bitte geben Sie Ihre Nachricht ein (mindestens 10 Zeichen).
          </span>
        </div>

        <p class="lf-privacy">
          Bitte beachten Sie unsere
          <a href={`${base}datenschutz.html`} class="lf-privacy__link">Datenschutzerklärung</a>.
        </p>

        <div class="lf-step__nav">
          <button type="button" class="lf-btn lf-btn--ghost" id="lf-prev">
            Zurück
          </button>
          <button type="submit" class="lf-btn lf-btn--primary" id="lf-submit">
            Anfrage senden
          </button>
        </div>
      </div>
    </form>
  </div>
</section>

<style>
  .lf-section {
    padding-block: 5rem;
  }

  .lf-inner {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .lf-heading {
    font-family: var(--font-display);
    font-size: clamp(1.9375rem, 4vw, 2.4375rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 2.5rem;
    text-align: center;
  }

  /* Honeypot: visuell unsichtbar, für AT versteckt */
  .lf-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Fortschritt */
  .lf-steps {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    counter-reset: none;
  }

  .lf-steps__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lf-steps__item--active {
    color: var(--color-primary-light);
    font-weight: 700;
  }

  .lf-steps__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background-color: var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .lf-steps__item--active .lf-steps__num {
    background-color: var(--color-primary);
    color: var(--color-on-gradient);
  }

  /* Steps */
  .lf-step__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 1.5rem;
  }

  /* Topics */
  .lf-fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }

  .lf-legend {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .lf-topics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 0.625rem;
    margin-bottom: 1.25rem;
  }

  .lf-topic {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
    min-height: 44px;
  }

  .lf-topic:hover {
    border-color: var(--color-primary);
    background-color: var(--color-surface-alt);
  }

  .lf-topic:has(.lf-topic__input:checked) {
    border-color: var(--color-primary);
    background-color: var(--color-surface-alt);
  }

  .lf-topic__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .lf-topic__box {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .lf-topic:has(.lf-topic__input:checked) .lf-topic__box {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-gradient);
  }

  .lf-topic__input:focus-visible + .lf-topic__box {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .lf-topic__label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
  }

  /* Sonstiges-Freitext */
  .lf-other {
    margin-top: 0.5rem;
    padding: 1rem;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Formularfelder */
  .lf-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .lf-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }

  .lf-row .lf-group {
    margin-bottom: 0;
  }

  .lf-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .lf-optional {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-text-faint);
    margin-left: 0.25rem;
  }

  .lf-control {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.625rem 0.875rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    min-height: 44px;
    width: 100%;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .lf-control::placeholder {
    color: var(--color-text-faint);
  }

  .lf-control:focus {
    outline: none;
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px rgba(109, 179, 242, 0.2);
  }

  .lf-control[aria-invalid="true"] {
    border-color: var(--color-error);
  }

  .lf-textarea {
    min-height: 120px;
    resize: vertical;
  }

  .lf-error {
    font-size: 0.8125rem;
    color: var(--color-error);
    font-weight: 500;
  }

  /* Privacy */
  .lf-privacy {
    font-size: 0.8125rem;
    color: var(--color-text-faint);
    margin: 1rem 0 1.5rem;
    line-height: 1.5;
  }

  .lf-privacy__link {
    color: var(--color-primary-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lf-privacy__link:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Navigation */
  .lf-step__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .lf-step__nav--end {
    justify-content: flex-end;
  }

  /* Buttons */
  .lf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: var(--radius-md);
    min-height: 44px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), opacity var(--transition-fast);
  }

  .lf-btn:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .lf-btn--primary {
    background-color: var(--color-primary);
    color: var(--color-on-gradient);
    border-color: var(--color-primary);
  }

  .lf-btn--primary:hover:not(:disabled) {
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .lf-btn--primary:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .lf-btn--ghost {
    background-color: transparent;
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  .lf-btn--ghost:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-text);
  }

  /* Status */
  .lf-status {
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .lf-status:empty {
    display: none;
  }

  .lf-status--success {
    background-color: rgba(93, 191, 106, 0.12);
    border: 1px solid var(--color-success);
    color: var(--color-success);
  }

  .lf-status--error {
    background-color: rgba(255, 107, 107, 0.1);
    border: 1px solid var(--color-error);
    color: var(--color-error-text);
  }

  /* Screenreader */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { validateEmail, validateName, validateMessage, isHoneypotFilled, isSpamSubmit } from '../lib/form-validation';

  (function () {
    const formEl = document.getElementById('lf-form') as HTMLFormElement | null;
    if (!formEl) return;
    const form: HTMLFormElement = formEl;

    const startedInput = document.getElementById('lf-started') as HTMLInputElement | null;
    const step1 = document.getElementById('lf-step-1') as HTMLElement | null;
    const step2 = document.getElementById('lf-step-2') as HTMLElement | null;
    const ind1 = document.getElementById('lf-step-ind-1');
    const ind2 = document.getElementById('lf-step-ind-2');
    const nextBtn = document.getElementById('lf-next') as HTMLButtonElement | null;
    const prevBtn = document.getElementById('lf-prev') as HTMLButtonElement | null;
    const submitBtn = document.getElementById('lf-submit') as HTMLButtonElement | null;
    const statusEl = document.getElementById('lf-status') as HTMLElement | null;

    // Set timestamp for spam detection
    if (startedInput) startedInput.value = String(Date.now());

    // Sonstiges toggle
    const otherTrigger = form.querySelector<HTMLInputElement>('[data-topic="other-trigger"] input');
    const otherField = document.getElementById('lf-other-field');
    otherTrigger?.addEventListener('change', () => {
      if (otherField) otherField.hidden = !otherTrigger.checked;
    });

    function showStep(num: 1 | 2) {
      if (step1) step1.hidden = num !== 1;
      if (step2) step2.hidden = num !== 2;
      ind1?.classList.toggle('lf-steps__item--active', num === 1);
      ind2?.classList.toggle('lf-steps__item--active', num === 2);
      // Move focus to step heading
      const heading = (num === 1 ? step1 : step2)?.querySelector<HTMLElement>('.lf-step__title');
      heading?.setAttribute('tabindex', '-1');
      heading?.focus();
    }

    function showError(inputEl: HTMLInputElement | HTMLTextAreaElement, errorId: string, show: boolean) {
      const err = document.getElementById(errorId);
      if (!err) return;
      err.hidden = !show;
      inputEl.setAttribute('aria-invalid', show ? 'true' : 'false');
    }

    function validateStep2(): boolean {
      let valid = true;

      const nameEl = form.querySelector<HTMLInputElement>('#lf-name');
      const emailEl = form.querySelector<HTMLInputElement>('#lf-email');
      const websiteEl = form.querySelector<HTMLInputElement>('#lf-website');
      const messageEl = form.querySelector<HTMLTextAreaElement>('#lf-message');

      if (nameEl && !validateName(nameEl.value)) {
        showError(nameEl, 'lf-name-error', true);
        if (valid) nameEl.focus();
        valid = false;
      } else if (nameEl) {
        showError(nameEl, 'lf-name-error', false);
      }

      if (emailEl && !validateEmail(emailEl.value)) {
        showError(emailEl, 'lf-email-error', true);
        if (valid) emailEl.focus();
        valid = false;
      } else if (emailEl) {
        showError(emailEl, 'lf-email-error', false);
      }

      if (websiteEl && websiteEl.value.trim()) {
        try {
          new URL(websiteEl.value.trim());
          showError(websiteEl, 'lf-website-error', false);
        } catch {
          showError(websiteEl, 'lf-website-error', true);
          if (valid) websiteEl.focus();
          valid = false;
        }
      } else if (websiteEl) {
        showError(websiteEl, 'lf-website-error', false);
      }

      if (messageEl && !validateMessage(messageEl.value)) {
        showError(messageEl, 'lf-message-error', true);
        if (valid) messageEl.focus();
        valid = false;
      } else if (messageEl) {
        showError(messageEl, 'lf-message-error', false);
      }

      return valid;
    }

    nextBtn?.addEventListener('click', () => showStep(2));
    prevBtn?.addEventListener('click', () => showStep(1));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot check
      const gotcha = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
      if (gotcha && isHoneypotFilled(gotcha.value)) return; // Bot — silently ignore

      // Timing check (< 2.5s = likely bot)
      const started = Number(startedInput?.value ?? 0);
      if (isSpamSubmit(started, Date.now())) return; // Silently drop

      if (!validateStep2()) return;

      // Disable submit while sending
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet…';
      }
      if (statusEl) {
        statusEl.textContent = '';
        statusEl.className = 'lf-status sr-only';
      }

      const endpoint = form.dataset.endpoint ?? '';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });

        if (res.ok) {
          if (statusEl) {
            statusEl.textContent = 'Vielen Dank! Wir melden uns innerhalb von 24 Stunden bei Ihnen.';
            statusEl.className = 'lf-status lf-status--success';
          }
          form.reset();
          showStep(1);
        } else {
          throw new Error('Server-Fehler');
        }
      } catch {
        if (statusEl) {
          statusEl.textContent = 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt an mail@dk-dk.de.';
          statusEl.className = 'lf-status lf-status--error';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Anfrage senden';
        }
      }
    });
  })();
</script>
