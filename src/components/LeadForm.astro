    font-family: var(--font-display);
    color: var(--color-text);
    line-height: 1.1;
    margin: 0 0 2.5rem;
    text-wrap: balance;
  }

  /* Nur für Screenreader — die sichtbare Rückmeldung übernimmt der Dankeblock. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* Grundzustand der Statusmeldung: Sie ist nur für Screenreader da,
