  .lf-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .lf-form {
    max-width: var(--container-narrow);
  }
  /* Eine eigene Fläche, damit das Formular nicht wie ein weiterer
     Abschnitt aussieht. Der Anlauf an der Oberkante nimmt die Farbe des
     Fortschrittsbalkens auf. */
  /* Der Grund ist gedämpft, weil die Karten darauf weiß sind — auf Weiß
     trüge allein der Rahmen die Trennung, mit 1,4:1 unter den 3:1 von
     WCAG 1.4.11. */
  .lf-form {
    position: relative;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    overflow: hidden;
  }
  .lf-form::before {
