---
/**
 * LeadForm.astro — das Anfrageformular, dreistufig.
 *
 * Vorher lagen Anliegen und alles andere in zwei Schritten, der zweite
 * davon mit Name, E-Mail, Website und Nachricht auf einmal. Das ist der
 * Punkt, an dem Formulare abgebrochen werden: sechs Felder gleichzeitig,
 * bevor man weiß, wie lang es noch dauert.
 *
 * Jetzt sind es drei überschaubare Schritte mit einer Leiste darüber, die
 * zeigt, wo man steht und was noch kommt:
 *
 *   1  Anliegen   — die Themen-Auswahl wie bisher
 *   2  Nachricht  — nur das Textfeld, sonst nichts
 *   3  Kontakt    — Vorname, Nachname, E-Mail, Firma, Website + Absenden
 *
 * Ohne JavaScript sind alle drei Schritte sichtbar und das Formular
 * abschickbar; die Schritte entstehen erst im Skript. Ein Formular, das
 * ohne JS gar nichts tut, wäre für den Blueprint („Progressive
 * Enhancement") und für die Barrierefreiheit gleichermaßen falsch.
 */
import Icon from './ui/Icon.astro';

import { FORM_ENDPOINT } from '../config/site.config';

const base = import.meta.env.BASE_URL;

interface Props {
  /** Sprechender Name der Seite — landet als verstecktes Feld in der Mail. */
  readonly page?: string;
  readonly heading?: string;
}

const { page = 'Unbekannte Seite', heading = 'Projekt anfragen' } = Astro.props;

const topics = [
  'Barrierefreie Website (BFSG)',
  'WordPress-Relaunch',
  'SEO & GEO',
  'Online-Marketing',
  'Social Recruiting',
  'Corporate Design',
  'KI-Services',
  'Sonstiges',
];

const schritte = [
  { nr: 1, name: 'Anliegen'  },
  { nr: 2, name: 'Nachricht' },
  { nr: 3, name: 'Kontakt'   },
];
---

<section class="lf-section" id="contact" aria-labelledby="lf-heading">
  <div class="lf-inner">
    <h2 id="lf-heading" class="lf-heading">{heading}</h2>

    <!-- Status-Region: Erfolg und Fehler werden hier angesagt. -->
    <div id="lf-status" role="status" aria-live="polite" aria-atomic="true" class="lf-status sr-only"></div>

    <form id="lf-form" class="lf-form" novalidate data-endpoint={FORM_ENDPOINT}>
      <!-- Auf welcher Seite wurde das Formular ausgefüllt? Der sprechende
           Name kommt aus der Seite, die volle Adresse setzt das Skript. -->
      <input type="hidden" name="page" value={page} />
      <input type="hidden" name="page_url" id="lf-page-url" value="" />
      <!-- Zusammengesetzt aus Vor- und Nachname, damit der Mailer unverändert bleibt. -->
      <input type="hidden" name="name" id="lf-name-combined" value="" />
      <!-- Spam: Zeitstempel (wird per JS gesetzt) -->
      <input type="hidden" name="form_started" id="lf-started" value="" />
      <!-- Signierter Zeitstempel vom Server. Er wird erst geholt, wenn
           jemand den letzten Schritt erreicht — ein Aufruf je Anfrage
           statt einer je Seitenaufruf. -->
      <input type="hidden" name="ts_server" id="lf-ts" value="" />
      <input type="hidden" name="ts_sig" id="lf-ts-sig" value="" />
      <!-- Zwei Honigtöpfe, absichtlich unterschiedlich versteckt: `hp_email`
           per `display: none`, `_gotcha` außerhalb des Bildschirms. Manche
           Bots erkennen `display: none` und lassen solche Felder aus,
           andere füllen alles, was sie im Markup finden. Beide sind für
           Tastatur und Screenreader unerreichbar. -->
      <input type="email" name="hp_email" id="lf-hp-email" class="lf-honeypot-none"
        tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="text" name="_gotcha" class="lf-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <!-- Beleg, dass jemand das Formular wirklich bedient hat. Ein Bot,
           der Werte per Skript setzt, löst keine Eingabe-Ereignisse aus. -->
      <input type="hidden" name="interaktion" id="lf-interaktion" value="0" />

      <!-- Fortschritt. Ohne JS bleibt die Leiste verborgen: Sie würde einen
           Schritt behaupten, den es dann nicht gibt. -->
      <div class="lf-progress" id="lf-progress" hidden>
        <ol class="lf-progress__list">
          {schritte.map((s) => (
            <li class="lf-progress__item" data-step-ind={s.nr}>
              <span class="lf-progress__marke" aria-hidden="true">
                <span class="lf-progress__nr">{s.nr}</span>
                <span class="lf-progress__haken"><Icon name="check" size={14} /></span>
              </span>
              <span class="lf-progress__name">{s.name}</span>
            </li>
          ))}
        </ol>
        <div class="lf-progress__schiene" aria-hidden="true">
          <div class="lf-progress__balken" id="lf-progress-bar"></div>
        </div>
      </div>

      <!-- Schritt 1: Anliegen -->
      <div id="lf-step-1" class="lf-step" data-step="1">
        <p class="lf-step__zaehler" data-step-count>Schritt 1 von 3</p>
        <h3 class="lf-step__title">Worum geht es?</h3>

        <fieldset class="lf-fieldset">
          <legend class="lf-legend">
            Ihr Anliegen
            <span class="lf-optional">(Mehrfachauswahl möglich)</span>
          </legend>
          <div class="lf-topics">
            {topics.map((topic) => (
              <label class="lf-topic" data-topic={topic === 'Sonstiges' ? 'other-trigger' : undefined}>
                <input type="checkbox" name="interesse[]" value={topic} class="lf-topic__input" />
                <span class="lf-topic__box" aria-hidden="true"><Icon name="check" size={14} /></span>
                <span class="lf-topic__label">{topic}</span>
              </label>
            ))}
          </div>
          <span id="lf-topics-error" class="lf-error" role="alert" hidden>
            Bitte wählen Sie mindestens ein Thema aus.
          </span>

          <!-- Sonstiges-Freitext (erscheint bei Auswahl „Sonstiges") -->
          <div id="lf-other-field" class="lf-other" hidden>
            <label for="lf-other-text" class="lf-label">Bitte beschreiben Sie Ihr Anliegen kurz</label>
            <textarea id="lf-other-text" name="anliegen_text" class="lf-control lf-textarea" rows="3"
              aria-describedby="lf-other-error"></textarea>
            <span id="lf-other-error" class="lf-error" role="alert" hidden>
              Bitte geben Sie Ihr Anliegen ein.
            </span>
          </div>
        </fieldset>

        <div class="lf-step__nav lf-step__nav--end">
          <button type="button" class="lf-btn lf-btn--primary" data-next="2">
            Weiter
            <Icon name="arrow-right" size={16} />
          </button>
        </div>
      </div>

      <!-- Schritt 2: Nachricht -->
      <div id="lf-step-2" class="lf-step" data-step="2">
        <p class="lf-step__zaehler" data-step-count>Schritt 2 von 3</p>
        <h3 class="lf-step__title">Was sollen wir wissen?</h3>
        <p class="lf-step__lead">
          Je konkreter, desto genauer die Einschätzung — Zeitrahmen, Budgetvorstellung
          oder ein Link auf die bestehende Seite helfen uns am meisten.
        </p>

        <div class="lf-group">
          <label for="lf-message" class="lf-label">
            Ihre Nachricht
            <span aria-hidden="true">*</span>
            <span class="sr-only">(Pflichtfeld)</span>
          </label>
          <textarea id="lf-message" name="message" class="lf-control lf-textarea lf-textarea--gross"
            rows="7" required minlength="10" aria-required="true"
            aria-describedby="lf-message-error"></textarea>
          <span id="lf-message-error" class="lf-error" role="alert" hidden>
            Bitte geben Sie Ihre Nachricht ein (mindestens 10 Zeichen).
          </span>
        </div>

        <div class="lf-step__nav">
          <button type="button" class="lf-btn lf-btn--ghost" data-prev="1">Zurück</button>
          <button type="button" class="lf-btn lf-btn--primary" data-next="3">
            Weiter
            <Icon name="arrow-right" size={16} />
          </button>
        </div>
      </div>

      <!-- Schritt 3: Kontaktdaten -->
      <div id="lf-step-3" class="lf-step" data-step="3">
        <p class="lf-step__zaehler" data-step-count>Schritt 3 von 3</p>
        <h3 class="lf-step__title">Wohin dürfen wir antworten?</h3>

        <div class="lf-row">
          <div class="lf-group">
            <label for="lf-vorname" class="lf-label">
              Vorname
              <span aria-hidden="true">*</span>
              <span class="sr-only">(Pflichtfeld)</span>
            </label>
            <input type="text" id="lf-vorname" name="vorname" class="lf-control"
              autocomplete="given-name" autocapitalize="words" enterkeyhint="next"
              required aria-required="true" aria-describedby="lf-vorname-error" />
            <span id="lf-vorname-error" class="lf-error" role="alert" hidden>
              Bitte geben Sie Ihren Vornamen ein.
            </span>
          </div>
          <div class="lf-group">
            <label for="lf-nachname" class="lf-label">
              Nachname
              <span aria-hidden="true">*</span>
              <span class="sr-only">(Pflichtfeld)</span>
            </label>
            <input type="text" id="lf-nachname" name="nachname" class="lf-control"
              autocomplete="family-name" autocapitalize="words" enterkeyhint="next"
              required aria-required="true" aria-describedby="lf-nachname-error" />
            <span id="lf-nachname-error" class="lf-error" role="alert" hidden>
              Bitte geben Sie Ihren Nachnamen ein.
            </span>
          </div>
        </div>

        <div class="lf-group">
          <label for="lf-email" class="lf-label">
            E-Mail
            <span aria-hidden="true">*</span>
            <span class="sr-only">(Pflichtfeld)</span>
          </label>
          <!-- autocapitalize und spellcheck aus: iOS schreibt sonst den
               ersten Buchstaben der Adresse groß und unterringelt sie. -->
          <input type="email" id="lf-email" name="email" class="lf-control"
            autocomplete="email" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="next"
            required aria-required="true" aria-describedby="lf-email-error" />
          <span id="lf-email-error" class="lf-error" role="alert" hidden>
            Bitte geben Sie eine gültige E-Mail-Adresse ein.
          </span>
        </div>

        <div class="lf-row">
          <div class="lf-group">
            <label for="lf-firma" class="lf-label">
              Firma
              <span class="lf-optional">(optional)</span>
            </label>
            <input type="text" id="lf-firma" name="firma" class="lf-control"
              autocomplete="organization" autocapitalize="words" enterkeyhint="next" />
          </div>
          <div class="lf-group">
            <label for="lf-website" class="lf-label">
              Ihre Website
              <span class="lf-optional">(optional)</span>
            </label>
            <input type="url" id="lf-website" name="website_url" class="lf-control"
              placeholder="https://ihre-domain.de" autocomplete="url"
              autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send"
              aria-describedby="lf-website-error" />
            <span id="lf-website-error" class="lf-error" role="alert" hidden>
              Bitte geben Sie eine gültige Adresse ein (z.&nbsp;B. https://beispiel.de).
            </span>
          </div>
        </div>

        <!-- Rechenprobe. Die Aufgabe entsteht erst im Browser: Stünde sie
             im ausgelieferten HTML, wäre es für alle Besucher dieselbe und
             ein Bot müsste sie genau einmal lernen. Bis das Skript sie
             gesetzt hat, bleibt der Block verborgen. -->
        <div class="lf-group lf-rechnung" id="lf-rechnung" hidden>
          <label for="lf-rechenprobe" class="lf-label">
            Sicherheitsfrage: Wie viel ist <span id="lf-rechnung-frage">…</span>?
            <span aria-hidden="true">*</span>
            <span class="sr-only">(Pflichtfeld)</span>
          </label>
          <input type="text" id="lf-rechenprobe" class="lf-control lf-control--kurz"
            inputmode="numeric" autocomplete="off" enterkeyhint="send"
            aria-describedby="lf-rechnung-hinweis lf-rechnung-error" />
          <span id="lf-rechnung-hinweis" class="lf-hinweis">
            Eine kurze Rechenaufgabe hält automatische Anfragen ab.
          </span>
          <span id="lf-rechnung-error" class="lf-error" role="alert" hidden>
            Das Ergebnis stimmt noch nicht. Es steht eine neue Aufgabe bereit.
          </span>
        </div>

        <p class="lf-privacy">
          Bitte beachten Sie unsere
          <a href={`${base}datenschutz.html`} class="lf-privacy__link">Datenschutzerklärung</a>.
        </p>

        <div class="lf-step__nav">
          <button type="button" class="lf-btn lf-btn--ghost" data-prev="2">Zurück</button>
          <button type="submit" class="lf-btn lf-btn--primary" id="lf-submit">Anfrage absenden</button>
        </div>
      </div>
    </form>

    <!-- Bestätigung: ersetzt das Formular nach dem Absenden. -->
    <div id="lf-danke" class="lf-danke" hidden>
      <span class="lf-danke__marke" aria-hidden="true"><Icon name="check" size={28} /></span>
      <h3 class="lf-danke__title">Anfrage ist raus.</h3>
      <p class="lf-danke__text">
        Vielen Dank — wir melden uns innerhalb von 24 Stunden bei Ihnen.
        Falls es eilt: <a href="tel:+4922198655229" class="lf-privacy__link">+49 221 986 55 229</a>.
      </p>
    </div>
  </div>
</section>

<script>
  import {
    validateEmail, validateName, validateMessage,
    isHoneypotFilled, isSpamSubmit, validateMathAnswer,
  } from '../lib/form-validation';

  (function () {
    const formEl = document.getElementById('lf-form') as HTMLFormElement | null;
    if (!formEl) return;
    const form: HTMLFormElement = formEl;

    const ANZAHL = 3;
    const schritte = [1, 2, 3].map((n) => document.getElementById(`lf-step-${n}`) as HTMLElement | null);
    const fortschritt = document.getElementById('lf-progress');
    const balken = document.getElementById('lf-progress-bar');
    const statusEl = document.getElementById('lf-status');
    const danke = document.getElementById('lf-danke');
    const submitBtn = document.getElementById('lf-submit') as HTMLButtonElement | null;
    const startedInput = document.getElementById('lf-started') as HTMLInputElement | null;

    // Erst jetzt wird das Formular mehrseitig: Ohne Skript standen alle
    // drei Blöcke untereinander und ließen sich in einem Rutsch ausfüllen.
    if (fortschritt) fortschritt.hidden = false;

    // Echte Bedienung mitschreiben. Kein Bewegungsprofil, keine
    // Speicherung, keine Auswertung von Inhalten: Es zählt nur, ob
    // überhaupt eine Eingabe stattgefunden hat.
    const interaktion = document.getElementById('lf-interaktion') as HTMLInputElement | null;
    let bedient = false;
    for (const ereignis of ['pointerdown', 'keydown', 'input'] as const) {
      form.addEventListener(ereignis, () => {
        bedient = true;
        if (interaktion) interaktion.value = '1';
      }, { once: true, passive: true });
    }

    // ---- Rechenprobe ------------------------------------------------
    // Zwei einstellige Zahlen, Summe höchstens 18 — lösbar im Kopf, ohne
    // Stift, ohne Nachdenken. crypto.getRandomValues statt Math.random:
    // kostet nichts und ist die Gewohnheit, die man behalten will.
    const rechnung = document.getElementById('lf-rechnung');
    const rechnungFrage = document.getElementById('lf-rechnung-frage');
    const rechenprobe = document.getElementById('lf-rechenprobe') as HTMLInputElement | null;
    let summandA = 0;
    let summandB = 0;

    function zufall(bis: number): number {
      const feld = new Uint32Array(1);
      crypto.getRandomValues(feld);
      /* `feld[0]` ist nach `getRandomValues` immer belegt — der Typ weiss das
         nicht, seit jeder Indexzugriff als moeglicherweise leer gilt. */
      return ((feld[0] ?? 0) % bis) + 1;
    }

    function neueAufgabe(): void {
      summandA = zufall(9);
      summandB = zufall(9);
      if (rechnungFrage) rechnungFrage.textContent = `${summandA} + ${summandB}`;
      if (rechenprobe) {
        rechenprobe.value = '';
        rechenprobe.setAttribute('aria-invalid', 'false');
      }
    }

    if (rechnung && rechnungFrage && rechenprobe) {
      neueAufgabe();
      rechnung.hidden = false;
      rechenprobe.setAttribute('required', 'required');
      rechenprobe.setAttribute('aria-required', 'true');
    }

    const seiteUrl = document.getElementById('lf-page-url') as HTMLInputElement | null;
    if (seiteUrl) seiteUrl.value = window.location.href;
    if (startedInput) startedInput.value = String(Date.now());

    const langsam = window.matchMedia('(prefers-reduced-motion: reduce)');
    let aktuell = 1;

    /** Etwas in den Blick holen; der klebende Header bleibt frei. */
    function hinScrollen(el: HTMLElement): void {
      el.scrollIntoView({ block: 'start', behavior: langsam.matches ? 'auto' : 'smooth' });
    }

    /** Formular gegen die Bestätigung tauschen. */
    function zeigeDanke(): void {
      form.hidden = true;
      if (!danke) return;
      danke.hidden = false;
      const dankeTitel = danke.querySelector<HTMLElement>('.lf-danke__title');
      dankeTitel?.setAttribute('tabindex', '-1');
      dankeTitel?.focus({ preventScroll: true });
      hinScrollen(danke);
    }

    function feld<T extends HTMLElement>(id: string): T | null {
      return document.getElementById(id) as T | null;
    }

    function zeigeFehler(el: HTMLElement | null, fehlerId: string, an: boolean): void {
      const meldung = document.getElementById(fehlerId);
      if (meldung) meldung.hidden = !an;
      el?.setAttribute('aria-invalid', an ? 'true' : 'false');
    }

    /** Prüft einen Schritt und setzt den Fokus auf das erste beanstandete Feld. */
    function pruefe(nr: number): boolean {
      let ok = true;
      const ersterFehler = (el: HTMLElement | null) => {
        if (ok && el) el.focus();
        ok = false;
      };

      if (nr === 1) {
        const gewaehlt = form.querySelectorAll<HTMLInputElement>('input[name="interesse[]"]:checked');
        const leer = gewaehlt.length === 0;
        const meldung = document.getElementById('lf-topics-error');
        if (meldung) meldung.hidden = !leer;
        if (leer) ersterFehler(form.querySelector<HTMLInputElement>('input[name="interesse[]"]'));

        const sonstiges = form.querySelector<HTMLInputElement>('[data-topic="other-trigger"] input');
        const text = feld<HTMLTextAreaElement>('lf-other-text');
        if (sonstiges?.checked && text && text.value.trim().length === 0) {
          zeigeFehler(text, 'lf-other-error', true);
          ersterFehler(text);
        } else if (text) {
          zeigeFehler(text, 'lf-other-error', false);
        }
      }

      if (nr === 2) {
        const nachricht = feld<HTMLTextAreaElement>('lf-message');
        const gut = nachricht !== null && validateMessage(nachricht.value);
        zeigeFehler(nachricht, 'lf-message-error', !gut);
        if (!gut) ersterFehler(nachricht);
      }

      if (nr === 3) {
        const vorname = feld<HTMLInputElement>('lf-vorname');
        const nachname = feld<HTMLInputElement>('lf-nachname');
        const email = feld<HTMLInputElement>('lf-email');
        const website = feld<HTMLInputElement>('lf-website');

        for (const [el, id] of [[vorname, 'lf-vorname-error'], [nachname, 'lf-nachname-error']] as const) {
          const gut = el !== null && validateName(el.value);
          zeigeFehler(el, id, !gut);
          if (!gut) ersterFehler(el);
        }

        const mailOk = email !== null && validateEmail(email.value);
        zeigeFehler(email, 'lf-email-error', !mailOk);
        if (!mailOk) ersterFehler(email);

        // Die Website ist freiwillig; wer sie einträgt, soll aber merken,
        // wenn „meine-seite.de" ohne Schema nicht als Adresse durchgeht.
        if (website && website.value.trim().length > 0) {
          let gueltig = true;
          try {
            new URL(website.value.trim());
          } catch {
            gueltig = false;
          }
          zeigeFehler(website, 'lf-website-error', !gueltig);
          if (!gueltig) ersterFehler(website);
        } else if (website) {
          zeigeFehler(website, 'lf-website-error', false);
        }

        // Die Rechenprobe zuletzt: Wer sie falsch hat, bekommt eine neue
        // Aufgabe. Die alte stehen zu lassen lädt zum Durchprobieren ein.
        if (rechenprobe && rechnung && !rechnung.hidden) {
          const stimmt = validateMathAnswer(summandA, summandB, rechenprobe.value);
          zeigeFehler(rechenprobe, 'lf-rechnung-error', !stimmt);
          if (!stimmt) {
            ersterFehler(rechenprobe);
            const merkeFokus = document.activeElement === rechenprobe;
            neueAufgabe();
            rechenprobe.setAttribute('aria-invalid', 'true');
            if (merkeFokus) rechenprobe.focus();
          }
        }
      }

      return ok;
    }

    function zeichneFortschritt(): void {
      if (balken) balken.style.width = `${((aktuell - 1) / (ANZAHL - 1)) * 100}%`;
      for (const item of document.querySelectorAll<HTMLElement>('[data-step-ind]')) {
        const nr = Number(item.dataset.stepInd);
        item.classList.toggle('lf-progress__item--aktiv', nr === aktuell);
        item.classList.toggle('lf-progress__item--fertig', nr < aktuell);
        // aria-current sagt Screenreadern, wo sie stehen — die Farbe allein
        // sagt es ihnen nicht.
        if (nr === aktuell) item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
      }
    }

    function zeige(nr: number, ansagen = true): void {
      aktuell = nr;
      schritte.forEach((el, i) => {
        if (!el) return;
        const dran = i + 1 === nr;
        el.hidden = !dran;
        if (dran && !langsam.matches) {
          // Neu anstoßen, sonst spielt die Einblendung beim zweiten Mal nicht.
          el.classList.remove('lf-step--ein');
          void el.offsetWidth;
          el.classList.add('lf-step--ein');
        }
      });
      zeichneFortschritt();

      const titel = schritte[nr - 1]?.querySelector<HTMLElement>('.lf-step__title');
      if (titel && ansagen) {
        titel.setAttribute('tabindex', '-1');
        titel.focus({ preventScroll: true });

        // Und dann sichtbar machen. Ohne das steht der Kopf des neuen
        // Schritts auf dem Telefon außerhalb des Bildes: Der Knopf
        // „Weiter" sitzt am Ende eines langen Schritts, der neue Schritt
        // beginnt weit darüber. Gemessen bei 390 × 664: Der Zähler lag
        // nach dem Wechsel bei y = −263, die Fortschrittsleiste bei
        // −347. Man landete mitten im nächsten Schritt und sah nicht,
        // dass sich überhaupt etwas geändert hat.
        //
        // Angesteuert wird die Leiste, nicht der Titel: Sie ist die
        // Antwort auf „wo bin ich". `scroll-padding-top` am <html>
        // hält den klebenden Header frei.
        hinScrollen(fortschritt ?? titel);
      }
    }

    // „Sonstiges" blendet das Freitextfeld ein.
    const sonstigesSchalter = form.querySelector<HTMLInputElement>('[data-topic="other-trigger"] input');
    const sonstigesFeld = document.getElementById('lf-other-field');
    sonstigesSchalter?.addEventListener('change', () => {
      if (sonstigesFeld) sonstigesFeld.hidden = !sonstigesSchalter.checked;
    });

    // Sobald ein Thema angehakt wird, verschwindet die Beanstandung.
    for (const box of form.querySelectorAll<HTMLInputElement>('input[name="interesse[]"]')) {
      box.addEventListener('change', () => {
        const meldung = document.getElementById('lf-topics-error');
        if (meldung && form.querySelectorAll('input[name="interesse[]"]:checked').length > 0) {
          meldung.hidden = true;
        }
      });
    }

    /**
     * Signierten Zeitstempel beim Endpunkt abholen.
     *
     * Im Browser lässt sich jeder Zeitwert setzen; die Signatur entsteht
     * mit einem Geheimnis, das nur auf dem Server liegt. Schlägt der Abruf
     * fehl — Endpunkt nicht erreichbar, Netz weg —, bleibt es beim
     * unsignierten Wert aus dem Formular. Lieber eine schwächere Schranke
     * als ein Formular, das sich nicht absenden lässt.
     */
    let zeitstempelGeholt = false;
    /** Trennt die erreichte Grenze vom echten Fehler — die Meldungen unterscheiden sich. */
    class FormularFehler extends Error {
      constructor(readonly art: 'zu_viele' | 'allgemein') {
        super(art);
      }
    }

    async function holeZeitstempel(): Promise<void> {
      if (zeitstempelGeholt) return;
      zeitstempelGeholt = true;
      try {
        const antwort = await fetch(`${form.dataset.endpoint}?challenge=1`, { method: 'GET' });
        if (!antwort.ok) return;
        const daten = (await antwort.json()) as { ts?: number; sig?: string };
        const tsFeld = feld<HTMLInputElement>('lf-ts');
        const sigFeld = feld<HTMLInputElement>('lf-ts-sig');
        if (tsFeld && sigFeld && daten.ts && daten.sig) {
          tsFeld.value = String(daten.ts);
          sigFeld.value = daten.sig;
        }
      } catch (e) {
        /* Endpunkt nicht erreichbar — ohne Signatur weiter. */
      }
    }

    for (const btn of form.querySelectorAll<HTMLButtonElement>('[data-next]')) {
      btn.addEventListener('click', () => {
        if (!pruefe(aktuell)) return;
        const ziel = Number(btn.dataset.next);
        if (ziel === ANZAHL) void holeZeitstempel();
        zeige(ziel);
      });
    }
    for (const btn of form.querySelectorAll<HTMLButtonElement>('[data-prev]')) {
      // Zurück prüft nicht: Wer einen Schritt zurückgeht, will korrigieren,
      // nicht erst eine Beanstandung wegklicken.
      btn.addEventListener('click', () => zeige(Number(btn.dataset.prev)));
    }

    // Enter in einem Eingabefeld löst sonst das Absenden aus, weil der
    // einzige Submit-Knopf in Schritt 3 sitzt — auf dem Telefon heißt die
    // Taste dort oft „Los". In den Schritten davor führt sie jetzt weiter.
    // In einem mehrzeiligen Feld bleibt Enter ein Zeilenumbruch.
    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const ziel = e.target as HTMLElement | null;
      if (ziel instanceof HTMLTextAreaElement) return;
      if (ziel instanceof HTMLButtonElement) return;
      if (aktuell >= ANZAHL) return;
      e.preventDefault();
      if (pruefe(aktuell)) zeige(aktuell + 1);
    });

    zeige(1, false);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honigtopf gefüllt: Der Absender bekommt den ganz normalen
      // Dankeblock zu sehen, gesendet wird nichts. Ein Bot, der eine
      // Fehlermeldung bekäme, wüsste, dass er aufgeflogen ist, und
      // probierte es beim nächsten Mal ohne das Feld.
      for (const name of ['hp_email', '_gotcha']) {
        const topf = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
        if (topf && isHoneypotFilled(topf.value)) {
          zeigeDanke();
          return;
        }
      }

      const gestartet = Number(startedInput?.value ?? 0);
      if (isSpamSubmit(gestartet, Date.now())) return;

      // Niemand füllt ein Formular aus, ohne es anzufassen.
      if (!bedient) return;

      // Jeden Schritt prüfen, nicht nur den letzten: Wer über die Tastatur
      // direkt absendet, hätte sonst die ersten beiden übersprungen.
      for (const nr of [1, 2, 3]) {
        if (!pruefe(nr)) {
          zeige(nr);
          return;
        }
      }

      // Der Mailer erwartet weiterhin ein Feld `name`; Vor- und Nachname
      // gehen zusätzlich einzeln mit.
      const zusammen = feld<HTMLInputElement>('lf-name-combined');
      if (zusammen) {
        const v = feld<HTMLInputElement>('lf-vorname')?.value.trim() ?? '';
        const n = feld<HTMLInputElement>('lf-nachname')?.value.trim() ?? '';
        zusammen.value = `${v} ${n}`.trim();
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet…';
      }
      if (statusEl) {
        statusEl.textContent = '';
        statusEl.className = 'lf-status sr-only';
      }

      // Object.fromEntries behält bei mehrfach vorkommenden Namen nur den
      // letzten Wert. Bei „interesse[]" ging damit alles außer dem zuletzt
      // angehakten Thema verloren — wer drei Themen wählte, verschickte
      // eines. Mehrfachwerte werden deshalb zusammengefasst statt
      // überschrieben, und zwar als Text: Der Mailer bekam an dieser Stelle
      // schon immer eine Zeichenkette, ein Array wäre eine Änderung an
      // seinem Eingang.
      const daten: Record<string, FormDataEntryValue | string> = {};
      for (const [schluessel, wert] of new FormData(form)) {
        const vorhanden = daten[schluessel];
        daten[schluessel] = vorhanden === undefined || vorhanden === ''
          ? wert
          : `${String(vorhanden)}, ${String(wert)}`;
      }

      try {
        const res = await fetch(form.dataset.endpoint ?? '', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(daten),
        });
        if (!res.ok) {
          // „Es ist ein Fehler aufgetreten" ist bei einer erreichten
          // Grenze schlicht falsch: Es ist kein Fehler, und ein erneuter
          // Versuch hilft sofort auch nicht. Der Text muss sagen, was
          // los ist und was zu tun ist.
          const grund = await res
            .json()
            .then((a: { fehler?: string }) => a.fehler ?? '')
            .catch(() => '');
          throw new FormularFehler(grund === 'zu_viele' ? 'zu_viele' : 'allgemein');
        }

        if (statusEl) {
          statusEl.textContent = 'Vielen Dank! Wir melden uns innerhalb von 24 Stunden bei Ihnen.';
          statusEl.className = 'lf-status sr-only';
        }
        zeigeDanke();
      } catch (fehler) {
        if (statusEl) {
          statusEl.textContent =
            fehler instanceof FormularFehler && fehler.art === 'zu_viele'
              ? 'Von diesem Anschluss wurden in der letzten Stunde bereits mehrere Anfragen gesendet. '
                + 'Bitte warten Sie einen Moment oder schreiben Sie uns direkt an mail@dk-dk.de.'
              : 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt an mail@dk-dk.de.';
          statusEl.className = 'lf-status lf-status--error';
          // Sonst steht die Meldung am Kopf des Formulars, während der
          // Nutzer unten auf dem Absenden-Knopf steht. Auf dem Telefon
          // gemessen: 418 px oberhalb des Bildrands — für ihn ist einfach
          // nichts passiert.
          hinScrollen(statusEl);
          statusEl.setAttribute('tabindex', '-1');
          statusEl.focus({ preventScroll: true });
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Anfrage absenden';
        }
      }
    });
  })();
</script>

<style>
  .lf-section {
    padding-block: 5rem;
  }
  .lf-inner {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  /* Das Formular steht als eigene Fläche auf dem Seitengrund. Vorher lief
     es ohne Rahmen im Text mit und sah aus wie ein weiterer Abschnitt —
     nichts sagte „hier passiert etwas". Der feine Anlauf an der Oberkante
     nimmt die Akzentfarbe des Fortschrittsbalkens auf. */
  .lf-form {
    position: relative;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    overflow: hidden;
  }
  .lf-form::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(to right, var(--color-accent), transparent 62%);
  }

  .lf-heading {
    font-family: var(--font-display);
    font-size: clamp(1.9375rem, 4vw, 2.4375rem);
    color: var(--color-text);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 2.5rem;
    text-wrap: balance;
  }

  /* Nur für Screenreader — die sichtbare Rückmeldung übernimmt der Dankeblock. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* Grundzustand der Statusmeldung: Sie ist nur für Screenreader da,
     solange nichts schiefgeht. Erst .lf-status--error macht sie sichtbar. */
  .lf-status {
    font-size: 0.9375rem;
  }
  .lf-status--error {
    position: static;
    scroll-margin-top: 6rem;
    width: auto;
    height: auto;
    margin: 0 0 1.5rem;
    padding: 0.875rem 1rem;
    clip: auto;
    overflow: visible;
    white-space: normal;
    border: 1px solid var(--color-error);
    border-radius: var(--radius-md);
    color: var(--color-error-text);
    font-size: 0.9375rem;
  }

  /* Zwei Verstecke. `display: none` ist das offensichtlichere — manche
     Bots erkennen es und lassen das Feld aus, andere füllen stur alles.
     Deshalb daneben die Variante, die aus dem Bildschirm geschoben wird. */
  .lf-honeypot-none {
    display: none;
  }

  /* Honeypot: visuell unsichtbar, für Hilfstechnik versteckt. */
  .lf-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  /* ---- Fortschritt ------------------------------------------------ */
  .lf-progress {
    margin-bottom: 2.5rem;
  }
  .lf-progress__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 0.875rem;
    padding: 0;
  }
  .lf-progress__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    color: var(--color-text-faint);
    transition: color var(--transition-base);
  }
  .lf-progress__item--aktiv,
  .lf-progress__item--fertig {
    color: var(--color-text);
  }

  .lf-progress__marke {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: border-color var(--transition-base), background-color var(--transition-base),
      color var(--transition-base);
  }
  .lf-progress__item--aktiv .lf-progress__marke {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .lf-progress__item--fertig .lf-progress__marke {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-text-inverse);
  }
  /* Ziffer und Haken liegen übereinander; erledigt heißt Haken statt Ziffer. */
  .lf-progress__nr,
  .lf-progress__haken {
    grid-area: 1 / 1;
    display: inline-flex;
    transition: opacity var(--transition-fast);
  }
  .lf-progress__haken {
    opacity: 0;
  }
  .lf-progress__item--fertig .lf-progress__nr {
    opacity: 0;
  }
  .lf-progress__item--fertig .lf-progress__haken {
    opacity: 1;
  }

  .lf-progress__name {
    font-size: 0.875rem;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lf-progress__schiene {
    height: 2px;
    border-radius: 2px;
    background: var(--color-border);
    overflow: hidden;
  }
  .lf-progress__balken {
    width: 0;
    height: 100%;
    background: var(--color-accent);
    transition: width 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---- Schritte --------------------------------------------------- */
  .lf-step__zaehler {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }
  .lf-step__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }
  .lf-step__title:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }
  .lf-step__lead {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 52ch;
    margin: 0 0 1.75rem;
  }

  /* Einblenden beim Schrittwechsel. Das Skript hängt die Klasse an und
     entfernt sie vorher wieder, damit sie beim zweiten Mal erneut greift. */
  .lf-step--ein {
    animation: lf-ein 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes lf-ein {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  .lf-step__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .lf-step__nav--end {
    justify-content: flex-end;
  }

  /* ---- Felder ----------------------------------------------------- */
  .lf-fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .lf-legend {
    padding: 0;
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 1rem;
  }
  .lf-optional {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-left: 0.375rem;
  }

  .lf-topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 0.625rem;
  }
  .lf-topic {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    /* 44px Zielhöhe — WCAG 2.5.8 fordert mindestens 24px. */
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: border-color var(--transition-base), background-color var(--transition-base),
      color var(--transition-base);
  }
  .lf-topic:hover {
    border-color: var(--color-border-strong);
  }
  .lf-topic:has(.lf-topic__input:checked) {
    border-color: var(--color-accent);
    background: var(--color-surface-alt);
    color: var(--color-text);
  }
  .lf-topic:hover {
    border-color: var(--color-text-faint);
  }
  .lf-topic:has(.lf-topic__input:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .lf-topic__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .lf-topic__box {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm, 4px);
    color: var(--color-text-inverse);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }
  .lf-topic__box > :global(svg) {
    opacity: 0;
    transition: opacity var(--transition-fast);
  }
  .lf-topic:has(.lf-topic__input:checked) .lf-topic__box {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .lf-topic:has(.lf-topic__input:checked) .lf-topic__box > :global(svg) {
    opacity: 1;
  }
  .lf-topic__label {
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .lf-other {
    margin-top: 1.25rem;
  }
  .lf-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.25rem;
  }
  .lf-group {
    margin-bottom: 1.25rem;
  }
  .lf-row .lf-group {
    margin-bottom: 0;
  }
  .lf-row + .lf-group,
  .lf-row + .lf-row {
    margin-top: 1.25rem;
  }
  .lf-label {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .lf-control {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 1rem;
    transition: border-color var(--transition-base), background-color var(--transition-base);
