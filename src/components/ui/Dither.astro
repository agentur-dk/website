---
/**
 * Eine gerasterte Fläche, im Browser aus einer Formel gezeichnet
 * (src/lib/dither.ts) — sie kostet den Pfad zur Formel statt eines PNG.
 * Ausnahmslos dekorativ (`aria-hidden`); wo sie etwas zeigt, beschriftet
 * der Container.
 *
 * Die Schleife hält an, wenn die Fläche aus dem Bild läuft, der
 * Bewegungs-Schalter auf „pausiert" steht oder `prefers-reduced-motion`
 * gilt. Dann steht ein Standbild (WCAG 2.2.2).
 */
import type { FieldName } from '../../lib/dither';

interface Props {
  readonly field: FieldName;
  /**
   * Aus dieser Liste wird je Besuch eine Formel gezogen; `field` ist die
   * Rückfallebene ohne JavaScript oder Speicher.
   */
  readonly pool?: readonly FieldName[];
  /** Schlüssel, unter dem die Wahl in der Sitzung liegt. */
  readonly poolKey?: string;
  /** Kantenlänge einer Rasterzelle in CSS-Pixeln; größer = grober = billiger. */
  readonly cell?: number;
  /** Die Bewegungen sind langsam, 16 fps genügen. Jedes Bild kostet einen
   *  vollen Rasterdurchlauf auf dem Hauptthread — 24 fps kosteten auf
   *  gedrosseltem Mobilgerät Lighthouse-Punkte. */
  readonly fps?: number;
  /** 'fein' nimmt die 8×8-Matrix — weichere Verläufe, weniger Struktur. */
  readonly raster?: 'kraeftig' | 'fein';
  readonly class?: string;
}

const { field, pool, poolKey = 'hero', cell = 3, fps = 16, raster = 'kraeftig', class: className } = Astro.props;
---

<canvas
  class:list={['dither', className]}
  data-dither
  data-field={field}
  data-pool={pool?.join(',')}
  data-pool-key={pool ? poolKey : undefined}
  data-cell={cell}
  data-fps={fps}
  data-raster={raster}
  aria-hidden="true"></canvas>

<script>
  import { BAYER4, BAYER8, FIELDS, STATIC_FIELDS, paintDither, type FieldName } from '../../lib/dither';

  interface Flaeche {
    field: FieldName;
    cell: number;
    matrix: readonly (readonly number[])[];
    /** Feste Bildrate: ohne Drossel liefe die Schleife mit 120 Hz für nichts. */
    interval: number;
    animiert: boolean;
    sichtbar: boolean;
    /** Erst beim Sichtbarwerden zeichnen — siehe Kommentar am Beobachter. */
    gezeichnet: boolean;
    zuletzt: number;
  }

  const STANDBILD = 1600; // Zeitpunkt des Standbilds — ein Moment mit Struktur.

  /**
   * Eine Formel je Besuch: sessionStorage endet mit dem Tab — localStorage
   * hielte die Wahl monatelang, ein Cookie ginge an den Server.
   * Math.random läuft im Browser, die ausgelieferte Datei bleibt gleich.
   * Ist der Speicher gesperrt, wechselt das Bild eben beim Neuladen.
   */
  function waehle(canvas: HTMLCanvasElement): FieldName {
    const fest = (canvas.dataset.field ?? 'wave') as FieldName;
    const auswahl = (canvas.dataset.pool ?? '').split(',').filter(Boolean) as FieldName[];
    if (auswahl.length === 0) return fest;

    const schluessel = `dk-flaeche-${canvas.dataset.poolKey ?? 'hero'}`;
    try {
      const gemerkt = sessionStorage.getItem(schluessel) as FieldName | null;
      if (gemerkt !== null && auswahl.includes(gemerkt)) return gemerkt;
    } catch (e) { /* Speicher gesperrt */ }

    /* Ein Index in eine nichtleere Liste — der Typ kennt die Laenge nicht.
       `auswahl[0]!` waere kuerzer; der Rueckfall ist ehrlicher, weil er auch
       dann etwas liefert, wenn jemand die Liste leert. */
    const gezogen = auswahl[Math.floor(Math.random() * auswahl.length)] ?? auswahl[0]!;
    try {
      sessionStorage.setItem(schluessel, gezogen);
    } catch (e) { /* Speicher gesperrt */ }
    return gezogen;
  }

  const flaechen = new Map<HTMLCanvasElement, Flaeche>();
  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-dither]')) {
    const field = waehle(canvas);
    flaechen.set(canvas, {
      field,
      cell: Number(canvas.dataset.cell) || 3,
      matrix: canvas.dataset.raster === 'fein' ? BAYER8 : BAYER4,
      interval: 1000 / (Number(canvas.dataset.fps) || 16),
      animiert: !STATIC_FIELDS.includes(field),
      sichtbar: false,
      gezeichnet: false,
      zuletzt: -1,
    });
  }

  if (flaechen.size > 0) {
    const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)');
    let handle = 0;
    let start = 0;

    function zeichne(canvas: HTMLCanvasElement, f: Flaeche, t: number): void {
      paintDither(canvas, FIELDS[f.field], t, { cell: f.cell, matrix: f.matrix, transparent: true });
      f.gezeichnet = true;
    }

    function angehalten(): boolean {
      return reduziert.matches || document.documentElement.dataset.motion === 'paused';
    }

    function schleife(t: number): void {
      if (!start) start = t;
      for (const [canvas, f] of flaechen) {
        if (!f.animiert || !f.sichtbar) continue;
        if (f.zuletzt >= 0 && t - f.zuletzt < f.interval) continue;
        zeichne(canvas, f, t - start);
        f.zuletzt = t;
      }
      handle = requestAnimationFrame(schleife);
    }

    function starte(): void {
      if (handle || angehalten()) return;
      handle = requestAnimationFrame(schleife);
    }

    function stoppe(): void {
      if (!handle) return;
      cancelAnimationFrame(handle);
      handle = 0;
    }

    // Gezeichnet wird erst in Sichtweite: Alle Flächen der Startseite beim
    // Laden zu rastern kostete auf Mobilgeräten Lighthouse-Punkte. 120 px
    // Vorlauf, damit eine Fläche beim Hereinscrollen nicht anspringt.
    const sicht = new IntersectionObserver(
      (eintraege) => {
        for (const e of eintraege) {
          const canvas = e.target as HTMLCanvasElement;
          const f = flaechen.get(canvas);
          if (!f) continue;
          f.sichtbar = e.isIntersecting;
          if (e.isIntersecting && (!f.gezeichnet || !f.animiert || angehalten())) {
            zeichne(canvas, f, STANDBILD);
          }
        }
      },
      { rootMargin: '120px' }
    );
    for (const canvas of flaechen.keys()) sicht.observe(canvas);

    // Neu messen, wenn sich die Fläche ändert — das Raster hängt an der
    // Pixelbreite, nicht am Layout. Entprellt, weil ResizeObserver bei einer
    // laufenden Größenänderung pro Frame feuert.
    let messTimer = 0;
    const groesse = new ResizeObserver(() => {
      clearTimeout(messTimer);
      messTimer = window.setTimeout(() => {
        const still = angehalten();
        for (const [canvas, f] of flaechen) {
          f.zuletzt = -1;
          if (f.sichtbar && (still || !f.animiert)) zeichne(canvas, f, STANDBILD);
        }
      }, 120);
    });
    for (const canvas of flaechen.keys()) groesse.observe(canvas);

    function neuBewerten(): void {
      if (angehalten()) {
        stoppe();
        for (const [canvas, f] of flaechen) if (f.sichtbar) zeichne(canvas, f, STANDBILD);
      } else {
        starte();
      }
    }

    document.addEventListener('dk:motionchange', neuBewerten);
    reduziert.addEventListener('change', neuBewerten);

    // Die Schleife startet erst nach `load`, sonst fallen Rasterdurchläufe
    // in das Fenster, in dem der Browser den ersten Inhalt zeichnet. Bis
    // dahin steht dasselbe Standbild.
    if (document.readyState === 'complete') neuBewerten();
    else window.addEventListener('load', neuBewerten, { once: true });
  }
</script>

<style>
  .dither {
    display: block;
    width: 100%;
    height: 100%;
    /* Der ganze Trick: Das Canvas ist absichtlich winzig und wird hart
       hochskaliert. Ohne diese Zeile glättet der Browser die Kanten weg
       und aus dem Raster wird Matsch. */
    image-rendering: pixelated;
  }
</style>
