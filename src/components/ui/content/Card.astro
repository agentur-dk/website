---
import { cn } from '../../../lib/cn';

interface Props {
  class?: string;
  href?:  string;
}

const { class: extraClass, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

{href ? (
  <a href={href} class={cn('card', extraClass)}>
    <slot />
  </a>
) : (
  <div class={cn('card', extraClass)}>
    <slot />
  </div>
)}
