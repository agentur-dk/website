---
import { cn } from '../../../lib/cn';

type Size = 'default' | 'wide' | 'narrow';

interface Props {
  size?:  Size;
  as?:    string;
  class?: string;
}

const {
  size  = 'default',
  as:   Tag = 'div',
  class: extraClass,
} = Astro.props;

const classes = cn(
  size === 'default' && 'container',
  size === 'wide'    && 'container--wide',
  size === 'narrow'  && 'container--narrow',
  extraClass,
);
---

<Tag class={classes}>
  <slot />
</Tag>
