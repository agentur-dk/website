---
import { cn } from '../../../lib/cn';

type Spacing = 'sm' | 'md' | 'lg';
type Theme   = 'dark' | 'light' | 'hero';

interface Props {
  spacing?: Spacing;
  theme?:   Theme;
  id?:      string;
  class?:   string;
  [key: string]: unknown;
}

const {
  spacing   = 'md',
  theme,
  id,
  class:    extraClass,
  ...rest
} = Astro.props;

const classes = cn(
  'section',
  spacing === 'sm' && 'section--sm',
  spacing === 'lg' && 'section--lg',
  theme === 'light' && 'section--light',
  theme === 'dark'  && 'section--dark',
  theme === 'hero'  && 'section--hero',
  extraClass,
);
---

<section id={id} class={classes} {...rest}>
  <slot />
</section>
