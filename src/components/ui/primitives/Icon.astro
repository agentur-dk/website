---

<svg
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  class={extraClass}
>
  <path d={paths[name]} fill="currentColor" />
</svg>
