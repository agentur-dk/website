---
/**
 * Inline-SVG-Set — eckig, kein astro-icon-Dependency.
 * Füge neue Icons als <symbol> im Set unten hinzu.
 */
type IconName =
  | 'chevron-down'
  | 'chevron-right'
  | 'arrow-right'
  | 'arrow-up'
  | 'close'
  | 'menu'
  | 'check'
  | 'plus'
  | 'mail'
  | 'phone'
  | 'location'
  | 'linkedin'
  | 'external-link';

interface Props {
  name:   IconName;
  size?:  number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: extraClass, label } = Astro.props;

const paths: Record<IconName, string> = {
