---
import { cn } from '../../../lib/cn';

interface SelectOption {
  value: string;
  label: string;
}

interface Props {
  id:       string;
  name?:    string;
  label:    string;
  options:  SelectOption[];
  required?: boolean;
  class?:   string;
  error?:   string;
}

const {
  id,
  name     = id,
  label,
  options,
  required = false,
  class:   extraClass,
  error,
} = Astro.props;
---

<div class={cn('form-field', extraClass)}>
  <label for={id} class="form-label">
    {label}{required && <span aria-hidden="true"> *</span>}
  </label>
  <div class="form-select-wrap">
    <select
      id={id}
      name={name}
      required={required}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={error ? `${id}-error` : undefined}
      class="form-select"
    >
      {options.map((opt) => (
        <option value={opt.value}>{opt.label}</option>
      ))}
    </select>
    <svg aria-hidden="true" class="form-select-chevron" width="16" height="16" viewBox="0 0 24 24">
      <path d="M7 10l5 5 5-5z" fill="currentColor" />
    </svg>
  </div>
  {error && (
    <span id={`${id}-error`} class="form-error" role="alert">{error}</span>
  )}
</div>

<style>
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .form-select-wrap {
    position: relative;
  }
  .form-select {
    width: 100%;
    min-height: 44px;
    padding: 0.625rem 2.25rem 0.625rem 0.875rem;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
    appearance: none;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }
  .form-select:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(28, 96, 173, 0.25);
  }
  .form-select[aria-invalid="true"] {
    border-color: var(--color-error);
  }
  .form-select-chevron {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-text-muted);
  }
  .form-error {
    font-size: 0.8125rem;
    color: var(--color-error-text);
  }
</style>
