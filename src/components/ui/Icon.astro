---
/**
 * Icon.astro — die einzige Stelle, an der auf dieser Website ein <svg>
 * entsteht.
 *
 * Der Pfad kommt aus `src/lib/icons.ts`; hier wird nur das Gerüst gebaut.
 * Icons sind ausnahmslos dekorativ (`aria-hidden="true"`, `focusable="false"`):
 * Die Bedeutung trägt der sichtbare Text daneben oder das `aria-label` des
 * umgebenden Knopfes. Wer ein Icon als einzigen Inhalt eines Bedienelements
 * einsetzt, beschriftet dieses Element.
 *
 * Die Farbe folgt `currentColor`, die Größe steht als width/height im Markup
 * (kein Layout-Shift), und `class` reicht Klassen für Zustände durch —
 * etwa das Drehen des Aufklapper-Pluszeichens.
 */
import { ICONS, type IconName } from '../../lib/icons';

interface Props {
  /** Schlüssel aus dem Icon-Verzeichnis. */
  readonly name: IconName;
  /** Kantenlänge in Pixeln; Standard 24. */
  readonly size?: number;
  /** Linienstärke; Standard 2 (bei großen Icons eher 1.5–1.8). */
  readonly strokeWidth?: number;
  /** Zusätzliche Klassen für Zustände oder Positionierung. */
  readonly class?: string;
}

const { name, size = 24, strokeWidth = 2, class: className } = Astro.props;

const d: string | undefined = ICONS[name];
if (d === undefined) {
  throw new Error(`Icon "${name}" fehlt in src/lib/icons.ts`);
}
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
><path d={d} /></svg>
