---
import { cn } from '../../../lib/cn';

type Role = 'alert' | 'status' | 'log';

interface Props {
  variant?: 'error' | 'success' | 'info';
  role?:    Role;
  class?:   string;
}

const {
  variant = 'info',
  role    = 'alert',
  class:  extraClass,
} = Astro.props;
---

<div
  role={role}
  class={cn('alert', `alert--${variant}`, extraClass)}
>
  <slot />
</div>

<style>
  .alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .alert--error {
    background-color: rgba(255, 107, 107, 0.1);
    border-color: var(--color-error);
    color: var(--color-error-text);
  }
  .alert--success {
    background-color: rgba(93, 191, 106, 0.1);
    border-color: var(--color-success);
    color: var(--color-success);
  }
  .alert--info {
    background-color: rgba(28, 96, 173, 0.1);
    border-color: var(--color-primary);
    color: var(--color-accent);
  }
</style>
