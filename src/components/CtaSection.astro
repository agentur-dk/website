---
interface Props {
  title: string;
  text: string;
  buttonLabel: string;
  buttonHref: string;
}

const { title, text, buttonLabel, buttonHref } = Astro.props;
---

<section class="cta-section" aria-labelledby="cta-heading">
  <div class="cta-inner">
    <div class="cta-content">
      <h2 id="cta-heading" class="cta-title">{title}</h2>
      <p class="cta-text">{text}</p>
    </div>
    <div class="cta-actions">
      <a href={buttonHref} class="cta-btn">{buttonLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--gradient-footer);
    padding-block: 5rem;
  }

  .cta-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.9375rem, 4vw, 2.4375rem);
    font-weight: 700;
    color: var(--color-on-gradient);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 0.75rem;
  }

  .cta-text {
    font-size: 1.125rem;
    color: var(--color-text-on-gradient);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    background-color: var(--color-on-gradient);
    color: var(--color-bg);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    border-radius: var(--radius-md);
    min-height: 44px;
    transition: opacity var(--transition-fast);
  }

  .cta-btn:hover {
    opacity: 0.88;
  }

  .cta-btn:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
</style>
