---
/**
 * Abschluss-CTA am Seitenende.
 *
 * Der Verlauf (--gradient-footer) gehoert ab jetzt allein dem Footer.
 * Vorher trugen ihn auch .closing-cta, .content-cta und diese Komponente:
 * direkt uebereinander ergab das eine durchgehende Verlaufsflaeche mit
 * einer sichtbaren Naht an der Stelle, wo der Verlauf neu anfing.
 *
 * Die Optik hier ist stattdessen die Absenderzeile eines Briefbogens:
 * eine Haarlinie mit kurzem Akzentstueck, darunter links die Einladung
 * und rechts die zwei Wege zu uns. Ruhig, kontrastarm, ohne Flaeche --
 * damit der Footer darunter die einzige farbige Flaeche der Seite bleibt.
 */
import { siteConfig } from '../config/site.config';

interface Props {
  /** Kleine Zeile ueber der Ueberschrift. */
  label?: string;
  title: string;
  text: string;
  buttonLabel: string;
  buttonHref: string;
  /** Externe Ziele (z. B. Calendly) bekommen target/rel. */
  external?: boolean;
  /** Telefonblock ausblenden, wo er nicht passt. */
  showPhone?: boolean;
}

const {
  label = 'Kontakt aufnehmen',
  title,
  text,
  buttonLabel,
  buttonHref,
  external = false,
  showPhone = true,
} = Astro.props;

const { phone, phoneDisplay, hours } = siteConfig.contact;
---

<section class="cta-section" aria-labelledby="cta-heading">
  <div class="cta-section__inner">
    <div class="cta-section__rule" aria-hidden="true"></div>

    <div class="cta-section__grid">
      <div class="cta-section__text">
        <p class="cta-section__label">{label}</p>
        <h2 id="cta-heading" class="cta-section__title">{title}</h2>
        <p class="cta-section__sub">{text}</p>
      </div>

      <div class="cta-section__actions">
        <a
          href={buttonHref}
          class="btn btn--primary btn--lg cta-section__btn"
          {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
        >
          {buttonLabel}
        </a>

        {showPhone && (
          <div class="cta-section__direct">
            <p class="cta-section__direct-label">Lieber telefonieren</p>
            <a href={`tel:${phone}`} class="cta-section__phone">{phoneDisplay}</a>
            <p class="cta-section__hours">{hours}</p>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background-color: var(--color-bg);
    /* Viel Luft nach unten, damit der Footer-Verlauf auf freiem Grund
       anfaengt und nicht direkt an der Schrift klebt. */
    padding-block: 5rem 7rem;
  }

  .cta-section__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* Absenderzeile: kurzes Akzentstueck links, danach Haarlinie.
     Das Akzentstueck steht buendig ueber dem Label darunter. */
  .cta-section__rule {
    height: 1px;
    margin-bottom: 2.5rem;
    background: linear-gradient(
      to right,
      var(--color-primary-light) 0,
      var(--color-primary-light) 3.5rem,
      var(--color-border) 3.5rem,
      var(--color-border) 100%
    );
  }

  .cta-section__grid {
    display: grid;
    /* Rechte Spalte mit fester Breite, damit die Aktionen buendig mit
       dem rechten Ende der Haarlinie abschliessen. */
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 19rem);
    gap: 3rem 4rem;
    align-items: start;
  }

  .cta-section__label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }

  .cta-section__title {
    font-family: var(--font-display);
    font-size: clamp(1.9375rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
    max-width: 14ch;
  }

  .cta-section__sub {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 42ch;
    margin: 1rem 0 0;
  }

  .cta-section__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    /* Optischer Ausgleich: der Button soll auf der Hoehe der
       Ueberschrift stehen, nicht auf Hoehe des Labels darueber. */
    padding-top: 1.75rem;
  }

  .cta-section__btn {
    align-self: stretch;
  }

  .cta-section__direct-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin: 0 0 0.375rem;
  }

  /* Die Nummer ist hier Inhalt, kein Nachsatz -- deshalb in der
     Auszeichnungsschrift und in Textfarbe statt als Fliesstextlink. */
  .cta-section__phone {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 0.125rem;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .cta-section__phone:hover {
    color: var(--color-primary-light);
    border-bottom-color: var(--color-primary-light);
  }

  .cta-section__phone:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .cta-section__hours {
    font-size: 0.875rem;
    color: var(--color-text-faint);
    margin: 0.625rem 0 0;
  }

  @media (max-width: 860px) {
    .cta-section {
      padding-block: 3.5rem 5rem;
    }
    .cta-section__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .cta-section__title {
      max-width: 20ch;
    }
    .cta-section__actions {
      padding-top: 0;
    }
  }
</style>
