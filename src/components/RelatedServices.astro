---
/**
 * RelatedServices.astro — der Querverweis am Fuß einer Leistungsseite.
 *
 * Vorher stand an dieser Stelle eine nackte Liste, die sich die Klassen
 * des Footers auslieh (`.footer-col__list`, `.footer-col__link`). Sie sah
 * aus wie ein versehentlich in den Inhalt gerutschter Footer: vier blaue
 * Zeilen ohne Kontext, ohne Symbol, ohne einen Satz dazu, warum man dort
 * weiterlesen sollte.
 *
 * Jetzt sind es Karten mit dem Symbol der jeweiligen Leistung, dem Namen
 * und dem Einzeiler, der ohnehin schon in `site.config.ts` steht — dort
 * speist er die llms.txt und die Sitemap. Damit gibt es genau eine
 * Quelle für die Beschreibung einer Leistung; ein zweiter, hier
 * abgeschriebener Text würde beim nächsten Mal auseinanderlaufen.
 */
import Icon from './ui/Icon.astro';
import { pages } from '../config/site.config';
import type { IconName } from '../lib/icons';

interface Props {
  /** Slugs der Seiten, auf die verwiesen wird — Reihenfolge zählt. */
  readonly slugs: readonly string[];
  /** Überschrift; die BFSG-Seite nennt sie anders. */
  readonly heading?: string;
}

/** Dasselbe Symbol wie auf der Leistungskarte der Startseite. */
const SYMBOLE: Record<string, IconName> = {
  'bfsg-wordpress-website-agentur': 'accessibility',
  'corporate-design':               'palette',
  'ki-services':                    'cpu',
  'online-marketing':               'megaphone',
  'seo-geo':                        'search-check',
  'social-recruiting':              'users',
  'website-leasing':                'briefcase-business',
  'wordpress-entwicklung':          'code',
};

const { slugs, heading = 'Passende Leistungen' } = Astro.props;
const base = import.meta.env.BASE_URL;

const eintraege = slugs
  .map((slug) => pages.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);
---

<section class="verwandt section section--sm" aria-labelledby="verwandt-heading">
  <div class="container">
    <h2 id="verwandt-heading" class="section__heading verwandt__heading">{heading}</h2>
    <ul class="verwandt__grid" role="list">
      {eintraege.map((eintrag) => (
        <li>
          <a href={`${base}${eintrag.slug}.html`} class="verwandt__karte">
            <span class="verwandt__symbol" aria-hidden="true">
              <Icon name={SYMBOLE[eintrag.slug] ?? 'arrow-right'} size={22} strokeWidth={1.6} />
            </span>
            <span class="verwandt__titel">{eintrag.label}</span>
            <span class="verwandt__text">{eintrag.summary}</span>
            <span class="verwandt__pfeil" aria-hidden="true">
              <Icon name="arrow-right" size={16} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Die Sektion schließt an ein Trennerband an und steht auf dem
     Seitengrund, nicht auf der Kartenfarbe. */
  .verwandt {
    background: var(--color-bg);
  }

  .verwandt__heading {
    margin: 0 0 2rem;
  }

  .verwandt__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .verwandt__karte {
    position: relative;
    display: grid;
    /* Symbol und Titel in einer Zeile, der Text darunter über beide
       Spalten — so stehen die Titel aller Karten auf einer Höhe, auch
       wenn ein Name umbricht. */
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.5rem 0.875rem;
    height: 100%;
    padding: 1.5rem 1.5rem 3.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color var(--transition-base), background-color var(--transition-base);
  }
  .verwandt__karte:hover,
  .verwandt__karte:focus-visible {
    border-color: var(--color-border-strong);
    background: var(--color-surface-alt);
  }

  .verwandt__symbol {
    display: inline-flex;
    color: var(--color-accent);
  }

  .verwandt__titel {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-text);
    /* Platz für zwei Zeilen, auch wenn der Name nur eine braucht: Sonst
       ist die Titelzeile in jeder Karte unterschiedlich hoch und der
       Beschreibungstext startet nebeneinander auf drei verschiedenen
       Höhen. „Online-Marketing" passt in eine Zeile, „BFSG &
       Barrierefreiheit" nicht. */
    min-height: 2.5em;
    display: flex;
    align-items: center;
  }

  .verwandt__text {
    grid-column: 1 / -1;
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Der Pfeil sitzt unten links auf der Grundlinie der Karte und rückt
     im Hover nach rechts — die Bewegung ersetzt eine zweite Farbe. */
  .verwandt__pfeil {
    position: absolute;
    bottom: 1.375rem;
    left: 1.5rem;
    display: inline-flex;
    color: var(--color-accent);
    transition: transform var(--transition-base);
  }
  .verwandt__karte:hover .verwandt__pfeil,
  .verwandt__karte:focus-visible .verwandt__pfeil {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .verwandt__karte,
    .verwandt__pfeil {
      transition: none;
    }
  }
</style>
