---
/**
 * Einwilligungsbanner — CookieConsent (vanilla-cookieconsent, MIT).
 *
 * **Vergleichsfassung zu SimpleCMP auf `main`.** Gleiche Aufgabe, gleiche
 * Zusagen, gleiche Messpunkte — damit die Entscheidung auf Zahlen fällt
 * und nicht auf Sternen.
 *
 * Unterschiede, die zählen:
 *
 * — **Über npm statt selbst gebautes Bundle.** Die Fassung steht in
 *   package.json, `npm update` zieht nach, Astro bündelt nur das
 *   Gebrauchte. Bei SimpleCMP gibt es weder npm-Paket noch fertige
 *   Bundles; das Bundle dort ist selbst gebaut und ohne Fassungsverwaltung.
 *
 * — **Blockiert über das Markup.** Das Google-Tag steht als
 *   `type="text/plain"` mit `data-category` im Dokument; ohne
 *   Einwilligung führt der Browser es gar nicht erst aus. Die
 *   SimpleCMP-Fassung legt das Skript nach der Zustimmung per JavaScript
 *   an — das hängt daran, dass unser eigener Code richtig läuft.
 *
 * — **Deutsche Texte stehen hier.** CookieConsent liefert keine mit. Das
 *   ist die bessere Aufteilung: Die Wortwahl gehört zur Seite. Bei
 *   SimpleCMP zwingt sie zum großen Bundle, weil die Sprachdateien nur
 *   darin stecken.
 *
 * Kein CDN, aus demselben Grund wie bisher: Ein Aufruf an jsdelivr
 * überträgt die IP jedes Besuchers an einen Dritten, bevor eine
 * Einwilligung vorliegt. Das Paket wird lokal gebündelt.
 *
 * `anonymize_ip` bleibt — die Datenschutzerklärung sagt es zu, und ein
 * Werkzeugwechsel ist kein Anlass, eine Zusage fallen zu lassen.
 */
const base = import.meta.env.BASE_URL;
const GA_ID = 'G-KJ0TV1QCMB';
---

<script
  type="text/plain"
  data-category="analytics"
  src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
  async
></script>
<script
  type="text/plain"
  data-category="analytics"
  is:inline
  set:html={`window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};` +
    `gtag('js',new Date());gtag('config','${GA_ID}',{anonymize_ip:true});`}
></script>

<!--
  Kein `define:vars`: Astro macht daraus ein Inline-Skript ohne Modultyp,
  und die `import`-Zeilen brechen mit »Cannot use import statement outside
  a module«. Im Browser gemessen, im Markup nicht zu sehen. Der Basispfad
  kommt deshalb über import.meta.env, das Vite beim Bauen einsetzt.
-->
<script>
  import * as CookieConsent from 'vanilla-cookieconsent';
  import 'vanilla-cookieconsent/dist/cookieconsent.css';

  const base = import.meta.env.BASE_URL;

  void CookieConsent.run({
    mode: 'opt-in',
    manageScriptTags: true,
    // Nimmt die Messcookies weg, wenn jemand die Einwilligung zurückzieht.
    // Ohne das bliebe der Widerruf folgenlos.
    autoClearCookies: true,
    // Der Banner soll auch in der Messung erscheinen; sonst sähe die
    // Leistungsmessung besser aus als die Wirklichkeit.
    hideFromBots: false,
    cookie: { name: 'dk_consent_v2' },

    guiOptions: {
      consentModal: { layout: 'box', position: 'bottom right' },
      preferencesModal: { layout: 'box' },
    },

    categories: {
      necessary: { enabled: true, readOnly: true },
      analytics: {
        autoClear: { cookies: [{ name: /^_ga/ }, { name: '_gid' }, { name: '_gat' }] },
      },
    },

    language: {
      default: 'de',
      translations: {
        de: {
          consentModal: {
            title: 'Datenschutz-Einstellungen',
            description:
              'Diese Seite nutzt localStorage und sessionStorage für Dinge, die ohne ' +
              'sie nicht funktionieren: Ihre Auswahl hier, den Bewegungsschalter und ' +
              'die Darstellung im Seitenkopf. Zusätzlich möchten wir anonymisiert ' +
              'messen, welche Seiten aufgerufen werden. Ohne Ihre Zustimmung wird ' +
              'dafür nichts geladen.',
            acceptAllBtn: 'Alle akzeptieren',
            acceptNecessaryBtn: 'Nur notwendige',
            showPreferencesBtn: 'Einzeln auswählen',
          },
          preferencesModal: {
            title: 'Datenschutz-Einstellungen',
            acceptAllBtn: 'Alle akzeptieren',
            acceptNecessaryBtn: 'Nur notwendige',
            savePreferencesBtn: 'Auswahl speichern',
            closeIconLabel: 'Schließen',
            sections: [
              {
                title: 'Notwendig',
                description:
                  'Speichert Ihre Auswahl auf dieser Seite sowie den ' +
                  'Bewegungsschalter. Ohne diese Einträge müssten Sie bei jedem ' +
                  'Aufruf neu entscheiden. Sie lassen sich nicht abwählen.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Statistik — Google Analytics',
                description:
                  'Misst anonymisiert, welche Seiten aufgerufen werden; die ' +
                  'IP-Adresse wird gekürzt. Ohne Ihre Einwilligung wird das ' +
                  'Google-Tag nicht geladen und keine Anfrage gestellt.',
                linkedCategory: 'analytics',
              },
              {
                title: 'Mehr dazu',
                description:
                  `Einzelheiten in der <a href="${base}datenschutz.html">Datenschutzerklärung</a>. ` +
                  `Verantwortlich ist die im <a href="${base}impressum.html">Impressum</a> ` +
                  'genannte Stelle. Sie können Ihre Auswahl jederzeit ändern.',
              },
            ],
          },
        },
      },
    },
  });

  // Widerruf von überall — Art. 7 Abs. 3 DSGVO verlangt, dass das
  // Zurücknehmen so leicht ist wie das Erteilen.
  for (const a of document.querySelectorAll('a[href="#datenschutz-einstellungen"]')) {
    a.addEventListener('click', (e) => { e.preventDefault(); CookieConsent.showPreferences(); });
  }
</script>
