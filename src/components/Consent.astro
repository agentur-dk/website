---
/**
 * Einwilligungsbanner — CookieConsent (vanilla-cookieconsent, MIT), nach
 * der agenturweiten Regel in `~/Claude-Projekte/CLAUDE.md`.
 *
 * Über npm statt als abgelegtes Bundle, damit `npm update` die Fassung
 * nachzieht. Kein CDN: Der Banner darf nicht selbst der erste Aufruf an
 * einen Dritten vor der Einwilligung sein. Blockiert wird über das Markup
 * (`type="text/plain"` mit `data-category`) — das hält auch, wenn unser
 * eigener Code nicht läuft.
 *
 * Die deutschen Texte stehen hier, weil die Wortwahl zur Seite gehört. Der
 * Banner läuft auf jeder Seite, auch auf Datenschutz und Impressum, sonst
 * fehlte der Knopf zum Ändern genau dort, wohin der Widerruf verweist.
 * `anonymize_ip` bleibt, weil die Datenschutzerklärung es zusagt.
 */
const GA_ID = 'G-KJ0TV1QCMB';
---

<script
  type="text/plain"
  data-category="analytics"
  src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
  async
></script>
<script
  type="text/plain"
  data-category="analytics"
  is:inline
  set:html={`window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};` +
    `gtag('js',new Date());gtag('config','${GA_ID}',{anonymize_ip:true});`}
></script>

{/*
  Kein `define:vars`: Astro macht daraus ein Inline-Skript ohne Modultyp,
  und die `import`-Zeilen brechen. Der Basispfad kommt deshalb über
  import.meta.env.
*/}
<script>
  import * as CookieConsent from 'vanilla-cookieconsent';
  // Die Festlegungen, an denen die Wirksamkeit hängt, stehen einmal für
  // alle Projekte in @dk/basis.
  import { erzeugeKonfiguration } from '../lib/einwilligung-basis';
  import 'vanilla-cookieconsent/dist/cookieconsent.css';

  const base = import.meta.env.BASE_URL;
  let vorher = false;

  /*
   * Der Zustand hängt als data-einbettungen am <html> (wie data-motion),
   * damit CSS den Platzhalter wegnehmen kann, sobald der Player laden darf.
   */
  function merkeEinbettungen(): void {
    document.documentElement.dataset.einbettungen =
      CookieConsent.acceptedCategory('einbettungen') ? 'erlaubt' : 'gesperrt';
  }

  void CookieConsent.run({
    ...erzeugeKonfiguration({ speicher: 'dk_consent_v2', datenschutz: base + 'datenschutz.html' }),

    manageScriptTags: true,
    autoClearCookies: true,
    // Der Banner soll auch in der Messung erscheinen, sonst sähe die
    // Leistungsmessung besser aus als die Wirklichkeit.
    hideFromBots: false,

    categories: {
      necessary: { enabled: true, readOnly: true },
      analytics: {
        autoClear: { cookies: [{ name: /^_ga/ }, { name: '_gid' }, { name: '_gat' }] },
      },
      /*
       * Ein eigener Zweck, nicht unter „Statistik": Wer der Messung
       * zustimmt, hat nicht einem Player zugestimmt, der die IP an einen
       * anderen Anbieter überträgt (granular je Dienst, Art. 4 Nr. 11 DSGVO).
       */
      einbettungen: {},
    },

    language: {
      default: 'de',
      translations: {
        de: {
          consentModal: {
            title: 'Cookie-Einstellungen',
            description:
              'Diese Seite nutzt localStorage und sessionStorage für Dinge, die ohne ' +
              'sie nicht funktionieren: Ihre Auswahl hier, den Bewegungsschalter und ' +
              'die Darstellung im Seitenkopf. Zusätzlich möchten wir anonymisiert ' +
              'messen, welche Seiten aufgerufen werden, und auf einer Seite einen ' +
              'Podcast-Player einbetten. Ohne Ihre Zustimmung wird dafür nichts ' +
              'geladen.',
            acceptAllBtn: 'Alle akzeptieren',
            acceptNecessaryBtn: 'Nur notwendige',
            showPreferencesBtn: 'Einzeln auswählen',
          },
          preferencesModal: {
            title: 'Cookie-Einstellungen',
            acceptAllBtn: 'Alle akzeptieren',
            acceptNecessaryBtn: 'Nur notwendige',
            savePreferencesBtn: 'Auswahl speichern',
            closeIconLabel: 'Schließen',
            sections: [
              {
                title: 'Notwendig',
                description:
                  'Speichert Ihre Auswahl auf dieser Seite sowie den ' +
                  'Bewegungsschalter. Ohne diese Einträge müssten Sie bei jedem ' +
                  'Aufruf neu entscheiden. Sie lassen sich nicht abwählen.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Statistik — Google Analytics',
                description:
                  'Misst anonymisiert, welche Seiten aufgerufen werden; die ' +
                  'IP-Adresse wird gekürzt. Ohne Ihre Einwilligung wird das ' +
                  'Google-Tag nicht geladen und keine Anfrage gestellt.',
                linkedCategory: 'analytics',
              },
              {
                title: 'Eingebettete Inhalte — Podigee',
                description:
                  'Der Podcast-Player auf der Seite „Unsere Marken" wird von ' +
                  'Podigee (Berlin) geladen. Dabei erfährt Podigee Ihre ' +
                  'IP-Adresse. Ohne Ihre Einwilligung wird der Player nicht ' +
                  'geladen; die Folge bleibt über einen gewöhnlichen Link ' +
                  'erreichbar.',
                linkedCategory: 'einbettungen',
              },
              {
                title: 'Mehr dazu',
                description:
                  `Einzelheiten in der <a href="${base}datenschutz.html">Datenschutzerklärung</a>. ` +
                  `Verantwortlich ist die im <a href="${base}impressum.html">Impressum</a> ` +
                  'genannte Stelle. Sie können Ihre Auswahl jederzeit ändern.',
              },
            ],
          },
        },
      },
    },

    onChange: () => {
      const jetzt = CookieConsent.acceptedCategory('analytics');
      const widerrufen = vorher && !jetzt;
      vorher = jetzt;
      merkeEinbettungen();
      if (widerrufen) window.location.reload();
    },
    onFirstConsent: () => { vorher = CookieConsent.acceptedCategory('analytics'); merkeEinbettungen(); },
    onConsent: () => { vorher = CookieConsent.acceptedCategory('analytics'); merkeEinbettungen(); },
  });

  /*
   * Beim Widerruf neu laden: `autoClearCookies` nimmt nur die Cookies weg,
   * ein geladenes Google-Tag sendet bis zum Neuladen weiter — der Widerruf
   * wäre sonst folgenlos (Art. 7 Abs. 3 DSGVO). Beim Erteilen nicht nötig,
   * dort trägt CookieConsent das Skript selbst nach.
   */
  // Widerruf so leicht wie das Erteilen (Art. 7 Abs. 3 DSGVO): der Knopf
  // in jeder Fußzeile und ein Anker für die Datenschutzerklärung.
  for (const a of document.querySelectorAll(
    '[data-consent-oeffnen], a[href="#datenschutz-einstellungen"]',
  )) {
    a.addEventListener('click', (e) => { e.preventDefault(); CookieConsent.showPreferences(); });
  }
</script>
