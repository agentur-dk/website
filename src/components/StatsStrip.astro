---
interface Stat {
  number: string;
  label: string;
  suffix?: string;
}

interface Props {
  stats: Stat[];
  heading?: string;
}

const { stats, heading } = Astro.props;
---

<section class="stats-strip" aria-label="Kennzahlen">
  <div class="stats-inner">
    {heading && <h2 class="stats-heading">{heading}</h2>}
    <ul class="stats-list" role="list">
      {stats.map((stat) => (
        <li class="stats-item">
          <strong class="stats-number">
            {stat.number}{stat.suffix && <span class="stats-suffix" aria-hidden="true">{stat.suffix}</span>}
            {stat.suffix && <span class="sr-only"> {stat.suffix}</span>}
          </strong>
          <span class="stats-label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats-strip {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--raum-abschnitt);
  }

  .stats-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .stats-heading {
    font-family: var(--font-display);
    font-size: var(--dk-schrift-text);
    font-weight: 700;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0 0 2rem;
    letter-spacing: -0.01em;
  }

  .stats-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: var(--rinne-5) var(--rinne-5);
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .stats-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--rinne-1);
  }

  .stats-number {
    font-family: var(--font-display);
    font-size: var(--dk-schrift-titel-1);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stats-suffix {
    font-size: 0.6em;
    vertical-align: super;
    color: var(--color-accent);
  }

  .stats-label {
    font-size: var(--dk-schrift-karte);
    font-weight: 500;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
