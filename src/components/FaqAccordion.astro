---
/**
 * FAQ-Accordion.
 *
 * Bezieht die Einträge über den Seiten-Slug aus src/data/faq.ts — derselben
 * Quelle, aus der das FAQPage-JSON-LD entsteht. Vorher standen die Fragen
 * doppelt im Repo (einmal als Markup, einmal als handgeschriebenes Schema);
 * ein Mismatch zwischen beidem wertet Google als Verstoß gegen die
 * Richtlinien für strukturierte Daten.
 */
import { faqFor, type FaqItem } from '../data/faq';
import Icon from './ui/Icon.astro';

interface Props {
  /** Seiten-Slug; lädt Überschrift und Einträge aus den zentralen FAQ-Daten. */
  slug?:    string;
  /** Alternativ: Einträge direkt übergeben (für Sonderfälle). */
  items?:   FaqItem[];
  heading?: string;
}

const { slug, items: itemsProp, heading: headingProp } = Astro.props;

const set     = slug !== undefined ? faqFor(slug) : undefined;
const items   = itemsProp ?? set?.items ?? [];
const heading = headingProp ?? set?.heading;

// Deterministische ID aus dem Slug statt Math.random(): sonst änderten sich
// die Element-IDs bei jedem Build, was reproduzierbare Builds unmöglich macht.
const baseId = `faq-${(slug ?? 'default').replace(/[^a-z0-9]+/gi, '-')}`;
---

<!--
  Weiss statt dunkel. Der FAQ-Block ist auf den meisten Seiten der
  laengste zusammenhaengende Textteil — dunkel gesetzt zog er die
  ganze Seite ins Dunkle. Auf heller Flaeche liest er sich wie das,
  was er ist: Nachschlagetext, kein Bildteil.
-->
<section class="faq-section section--hell" aria-labelledby={heading ? `${baseId}-heading` : undefined}>
  <div class="faq-inner">
    {heading && (
      <h2 id={`${baseId}-heading`} class="faq-heading">{heading}</h2>
    )}
    <dl class="faq-list">
      {items.map((item, i) => {
        const btnId = `${baseId}-btn-${i}`;
        const panelId = `${baseId}-panel-${i}`;
        return (
          <div class="faq-item">
            <dt class="faq-term">
              <button
                type="button"
                id={btnId}
                class="faq-btn"
                aria-expanded="false"
                aria-controls={panelId}
              >
                <span class="faq-btn__text">{item.question}</span>
                <span class="faq-btn__icon" aria-hidden="true">
                  <Icon name="chevron-down" size={20} />
                </span>
              </button>
            </dt>
            <dd
              id={panelId}
              class="faq-panel"
              role="region"
              aria-labelledby={btnId}
              hidden
            >
              <div class="faq-panel__inner">
                {item.answer}
              </div>
            </dd>
          </div>
        );
      })}
    </dl>
  </div>
</section>

<style>
  .faq-section {
    padding-block: var(--raum-abschnitt);
  }

  /* Bis zum 24.09.2026 saß dieser Abschnitt in einem 720-px-Kasten,
     mittig. Seine Überschrift begann damit 210 px weiter rechts als
     jede andere Abschnittsüberschrift der Seite — gemessen 384 statt
     174 px. Beim Scrollen las sich das wie ein eingeschobener Fremdkörper.

     Jetzt trägt der Abschnitt denselben Kasten wie alle anderen, und
     die Lesebreite sitzt dort, wo sie hingehört: an der Liste. */
  .faq-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* Linksbündig wie jede andere Abschnittsüberschrift. Zentriert war
     sie die einzige auf der ganzen Website — und das Etikett mit dem
     kurzen Strich davor funktioniert nur am linken Satzrand. */
  .faq-heading {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    margin: 0 0 2.5rem;
  }

  .faq-list {
    max-width: var(--container-narrow);
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .faq-term {
    margin: 0;
  }

  .faq-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--rinne-3);
    width: 100%;
    padding: 1.25rem 0;
    background: none;
    border: none;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--dk-schrift-karte);
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .faq-btn:hover {
    color: var(--color-primary-light);
  }

  .faq-btn:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .faq-btn__text {
    flex: 1;
    line-height: 1.5;
  }

  .faq-btn__icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform var(--transition-base);
  }

  .faq-btn[aria-expanded="true"] .faq-btn__icon {
    transform: rotate(180deg);
  }

  .faq-panel {
    margin: 0;
    overflow: hidden;
  }

  .faq-panel__inner {
    padding-bottom: 1.25rem;
    font-size: var(--dk-schrift-karte);
    color: var(--color-text-muted);
    line-height: 1.7;
  }
</style>

<script>
  function initFaq(section: Element) {
    const buttons = section.querySelectorAll<HTMLButtonElement>('.faq-btn');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        const panelId = btn.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;

        // Close all others in this accordion
        buttons.forEach((other) => {
          if (other !== btn) {
            other.setAttribute('aria-expanded', 'false');
            const otherId = other.getAttribute('aria-controls');
            const otherPanel = otherId ? document.getElementById(otherId) : null;
            if (otherPanel) otherPanel.hidden = true;
          }
        });

        // Toggle clicked
        btn.setAttribute('aria-expanded', String(!isOpen));
        if (panel) panel.hidden = isOpen;
      });
    });
  }

  document.querySelectorAll('.faq-section').forEach(initFaq);
</script>
