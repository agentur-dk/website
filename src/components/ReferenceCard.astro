---
type LogoVariant = 'blue' | 'green' | 'purple' | 'teal' | 'default';

interface Props {
  client: string;
  industry: string;
  text: string;
  tags: string[];
  logoInitials?: string;
  logoVariant?: LogoVariant;
  href?: string;
}

const {
  client,
  industry,
  text,
  tags,
  logoInitials,
  logoVariant = 'default',
  href,
} = Astro.props;
---

<article class="ref-card">
  <div class="ref-card__header">
    {logoInitials && (
      <div class={`ref-card__logo ref-card__logo--${logoVariant}`} aria-hidden="true">
        {logoInitials}
      </div>
    )}
    <div class="ref-card__meta">
      <h3 class="ref-card__client">{client}</h3>
      <p class="ref-card__industry">{industry}</p>
    </div>
  </div>
  <p class="ref-card__text">{text}</p>
  <ul class="ref-card__tags" role="list" aria-label="Projektkategorien">
    {tags.map((tag) => (
      <li class="ref-card__tag">{tag}</li>
    ))}
  </ul>
  {href && (
    <a href={href} class="ref-card__link">
      Projekt ansehen
      <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  )}
</article>

<style>
  .ref-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .ref-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .ref-card__header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .ref-card__logo {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--color-on-gradient);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background-color: var(--color-primary);
  }

  /* Gradient-system stop (#412848) used for purple variant */
  .ref-card__logo--blue    { background-color: var(--color-primary); }
  .ref-card__logo--green   { background-color: var(--color-success); }
  .ref-card__logo--purple  { background-color: #412848; }
  .ref-card__logo--teal    { background-color: var(--color-accent); }
  .ref-card__logo--default { background-color: var(--color-surface-alt); }

  .ref-card__meta {
    min-width: 0;
  }

  .ref-card__client {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0 0 0.125rem;
    overflow-wrap: break-word;
  }

  .ref-card__industry {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .ref-card__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }

  .ref-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ref-card__tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.2rem 0.6rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .ref-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary-light);
    text-decoration: none;
    margin-top: 0.25rem;
    transition: color var(--transition-fast);
  }

  .ref-card__link:hover {
    color: var(--color-text);
  }

  .ref-card__link:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
