---
import { leistungenNav, siteConfig } from '../config/site.config';
import Icon from './ui/Icon.astro';

const base        = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const aufSeite = (slug: string) => currentPath.endsWith(`/${slug}.html`);
/* Auf einer Leistungsseite ist „Leistungen" der Bereich, nicht die Seite:
   Der Menüpunkt wird nur sichtbar markiert, `aria-current` stünde falsch. */
const imLeistungsbereich = leistungenNav.some((l) => aufSeite(l.href));
---

<header class="site-header">
  <div class="site-header__inner">
    <a
      href={`${base}`}
      class="site-logo"
    >
      <span class="site-logo__name">agentur dk</span>
      <span class="site-logo__tagline">design & kommunikation</span>
      <span class="u-sr-only">— zur Startseite</span>
    </a>

    <a href={`tel:${siteConfig.contact.phone}`} class="site-header__telefon"
       aria-label={`Anrufen: ${siteConfig.contact.phoneDisplay}`}>
      <Icon name="phone" size={18} />
      <span class="site-header__nummer">{siteConfig.contact.phoneDisplay}</span>
    </a>

    <button
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Menü öffnen"
      class="nav-toggle"
    >
      <Icon name="menu" size={24} />
    </button>

    <nav id="nav-menu" aria-label="Hauptnavigation">
      <ul role="list" class="nav-list">
        <li>
          <a
            href={`${base}leistungen.html`}
            aria-current={aufSeite('leistungen') ? 'page' : undefined}
            class:list={['nav-link', imLeistungsbereich && 'nav-link--bereich']}
          >Leistungen</a>
        </li>
        <li>
          <a
            href={`${base}projekte.html`}
            aria-current={aufSeite('projekte') ? 'page' : undefined}
            class:list={['nav-link', aufSeite('marken') && 'nav-link--bereich']}
          >Referenzen</a>
        </li>
        <li>
          <a
            href={`${base}ueber-uns.html`}
            aria-current={aufSeite('ueber-uns') ? 'page' : undefined}
            class:list={['nav-link', aufSeite('jobs') && 'nav-link--bereich']}
          >Über uns</a>
        </li>
        <li>
          <a href={`${base}beratung.html`} class="nav-cta" aria-current={aufSeite('beratung') ? 'page' : undefined}>Sichtbarkeits-Check</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: var(--rinne-4);
  }

  .site-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .site-logo__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--dk-schrift-karte);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .site-logo__tagline {
    font-size: var(--dk-schrift-klein);
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--rinne-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--dk-schrift-karte);
    border-radius: var(--radius-md);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"],
  .nav-link--bereich {
    color: var(--color-text);
    background-color: var(--color-surface-alt);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.25rem;
    background-color: var(--color-primary);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: var(--dk-schrift-karte);
    border-radius: var(--radius-md);
    min-height: 44px;
    line-height: 1;
    transition: background-color var(--transition-fast);
  }

  .nav-cta:hover,
  .nav-cta[aria-current="page"] {
    background-color: var(--color-primary-hover);
  }

  .site-header__telefon {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--rinne-1);
    min-height: 44px;
    padding-inline: 0.5rem;
    color: var(--color-text);
    font-weight: 700;
    font-size: var(--dk-schrift-karte);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__telefon:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .site-header__nummer {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: block;
    }

    #nav-menu {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem 1.5rem;
      z-index: 199;
    }

    #nav-menu.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--rinne-1);
    }

    .nav-cta {
      justify-content: center;
      margin-top: 0.5rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    if (menu) menu.classList.toggle('is-open', !expanded);
  });

</script>
