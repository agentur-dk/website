---
const base = import.meta.env.BASE_URL;

const leistungenLinks = [
  { href: 'leistungen', label: 'Alle Leistungen' },
  { href: 'bfsg-wordpress-website-agentur', label: 'BFSG & Barrierefreiheit' },
  { href: 'wordpress-entwicklung', label: 'WordPress-Entwicklung' },
  { href: 'website-leasing', label: 'Website-Leasing' },
  { href: 'seo-geo', label: 'SEO & GEO' },
  { href: 'online-marketing', label: 'Online-Marketing' },
  { href: 'social-recruiting', label: 'Social Recruiting' },
  { href: 'corporate-design', label: 'Corporate Design' },
  { href: 'ki-services', label: 'KI-Services' },
];
---

<footer
  aria-label="Seiten-Footer"
  style="background: var(--gradient-footer);"
>
  <div
    style="
      max-width: var(--container-max);
      margin-inline: auto;
      padding-inline: 1.5rem;
      padding-block: 4rem 3rem;
    "
  >
    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
        gap: 2.5rem;
      "
    >
      <!-- Col 1: Agentur -->
      <div>
        <a
          href={`${base}`}
          aria-label="agentur dk – design & kommunikation – Zur Startseite"
          style="
            display: inline-flex;
            flex-direction: column;
            text-decoration: none;
            color: inherit;
            line-height: 1.2;
            margin-bottom: 1rem;
          "
        >
          <span
            style="
              font-family: var(--font-display);
              font-weight: 700;
              font-size: 1.1rem;
              color: #ffffff;
              letter-spacing: -0.02em;
            "
          >agentur dk</span>
          <span
            style="
              font-size: 0.7rem;
              color: #d4d4d4;
              letter-spacing: 0.08em;
              text-transform: uppercase;
            "
          >design & kommunikation</span>
        </a>
        <p style="font-size: 0.875rem; color: #d4d4d4; margin-bottom: 1rem; line-height: 1.6;">
          Professionelle Websites, Website-Leasing, SEO/GEO und Online-Marketing aus Köln. Persönlich, schnell, professionell.
        </p>
        <address style="font-style: normal; font-size: 0.875rem; color: #d4d4d4;">
          Sachsenring 57<br />D-50677 Köln
        </address>
      </div>

      <!-- Col 2: Leistungen -->
      <div>
        <h2
          style="
            font-family: var(--font-display);
            font-size: 0.8125rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #ffffff;
            margin-bottom: 1rem;
          "
        >Leistungen</h2>
        <nav aria-label="Leistungen im Footer">
          <ul role="list" style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            {leistungenLinks.map((l) => (
              <li>
                <a
                  href={`${base}${l.href}`}
                  style="color: #d4d4d4; text-decoration: none; font-size: 0.875rem; transition: color var(--transition-fast);"
                  onmouseover="this.style.color='#ffffff'"
                  onmouseout="this.style.color='#d4d4d4'"
                >{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Col 3: Unternehmen (Rechtliches) -->
      <div>
        <h2
          style="
            font-family: var(--font-display);
            font-size: 0.8125rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #ffffff;
            margin-bottom: 1rem;
          "
        >Unternehmen</h2>
        <nav aria-label="Unternehmen im Footer">
          <ul role="list" style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            <li>
              <a href={`${base}projekte`} style="color: #d4d4d4; text-decoration: none; font-size: 0.875rem;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#d4d4d4'">Referenzen & Projekte</a>
            </li>
            <li>
              <a href={`${base}barrierefreiheit`} style="color: #d4d4d4; text-decoration: none; font-size: 0.875rem;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#d4d4d4'">Barrierefreiheitserklärung</a>
            </li>
            <li>
              <a href={`${base}impressum`} style="color: #d4d4d4; text-decoration: none; font-size: 0.875rem;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#d4d4d4'">Impressum</a>
            </li>
            <li>
              <a href={`${base}datenschutz`} style="color: #d4d4d4; text-decoration: none; font-size: 0.875rem;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#d4d4d4'">Datenschutz</a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- Col 4: Kontakt -->
      <div>
        <h2
          style="
            font-family: var(--font-display);
            font-size: 0.8125rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #ffffff;
            margin-bottom: 1rem;
          "
        >Kontakt</h2>
        <ul role="list" style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
          <li>
            <a href="mailto:mail@dk-dk.de" style="color: #d4d4d4; text-decoration: none; font-size: 0.875rem;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#d4d4d4'">mail@dk-dk.de</a>
          </li>
          <li>
            <a href="tel:+4922198655229" style="color: #d4d4d4; text-decoration: none; font-size: 0.875rem;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#d4d4d4'">+49 221 986 55 229</a>
          </li>
          <li>
            <span style="color: #d4d4d4; font-size: 0.875rem;">Köln · Mo–Fr 9–18 Uhr</span>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/daniel-kontelis/"
              rel="noopener noreferrer"
              target="_blank"
              style="color: #d4d4d4; text-decoration: none; font-size: 0.875rem;"
              onmouseover="this.style.color='#ffffff'"
              onmouseout="this.style.color='#d4d4d4'"
            >LinkedIn<span style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0"> (öffnet in neuem Tab)</span></a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Footer bottom bar -->
  <div
    style="
      border-top: 1px solid rgba(255,255,255,0.15);
      padding-block: 1.25rem;
    "
  >
    <div
      style="
        max-width: var(--container-max);
        margin-inline: auto;
        padding-inline: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      "
    >
      <p style="font-size: 0.8125rem; color: #d4d4d4; margin: 0;">
        &copy; <span id="copyright-year"></span> agentur dk – design & kommunikation
      </p>
      <ul
        role="list"
        style="
          list-style: none;
          margin: 0;
          padding: 0;
          display: flex;
          gap: 1.5rem;
        "
      >
        <li><a href={`${base}impressum`} style="color: #d4d4d4; text-decoration: none; font-size: 0.8125rem;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#d4d4d4'">Impressum</a></li>
        <li><a href={`${base}datenschutz`} style="color: #d4d4d4; text-decoration: none; font-size: 0.8125rem;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#d4d4d4'">Datenschutz</a></li>
        <li><a href={`${base}barrierefreiheit`} style="color: #d4d4d4; text-decoration: none; font-size: 0.8125rem;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#d4d4d4'">Barrierefreiheit</a></li>
      </ul>
    </div>
  </div>
</footer>

<script>
  const yearEl = document.getElementById('copyright-year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
