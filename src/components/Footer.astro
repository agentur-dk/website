---
import MotionToggle from './MotionToggle.astro';
import Dither from './ui/Dither.astro';
import {
  siteConfig,
  footerLeistungenNav,
  footerUnternehmenNav,
  footerLegalNav,
} from '../config/site.config';

interface Props {
  /** Monochrome Seiten tragen im Footer eine gerasterte Fläche statt des
   *  Verlaufs. Auf allen anderen Seiten wird sie gar nicht erst gerendert —
   *  ein unsichtbares Canvas würde sonst 16 Seiten lang für nichts rechnen. */
  readonly mono?: boolean;
}

const { mono = false } = Astro.props;

const base = import.meta.env.BASE_URL;
---

<footer aria-label="Seiten-Footer" class="site-footer">
  {mono && <div class="footer__flaeche" aria-hidden="true"><Dither field="weave" cell={4} raster="fein" /></div>}
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <!-- Col 1: Agentur -->
      <div>
        <a
          href={`${base}`}
              class="footer-logo"
        >
          <span class="footer-logo__name">agentur dk</span>
          <span class="footer-logo__tagline">design & kommunikation</span>
          <span class="u-sr-only">— zur Startseite</span>
        </a>
        <p class="footer-desc">
          Professionelle Websites, Website-Leasing, SEO/GEO und Online-Marketing aus Köln. Persönlich, schnell, professionell.
        </p>
        <address class="footer-address">
          Sachsenring 57<br />D-50677 Köln
        </address>
      </div>

      <!-- Col 2: Leistungen -->
      <div>
        <h2 class="footer-heading">Leistungen</h2>
        <nav aria-label="Leistungen im Footer">
          <ul role="list" class="footer-nav-list">
            {footerLeistungenNav.map((l) => (
              <li>
                <a href={`${base}${l.href}.html`} class="footer-link">{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Col 3: Unternehmen -->
      <div>
        <h2 class="footer-heading">Unternehmen</h2>
        <nav aria-label="Unternehmen im Footer">
          <ul role="list" class="footer-nav-list">
            {footerUnternehmenNav.map((l) => (
              <li>
                <a href={`${base}${l.href}.html`} class="footer-link">{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Col 4: Kontakt -->
      <div>
        <h2 class="footer-heading">Kontakt</h2>
        <ul role="list" class="footer-nav-list">
          <li><a href={`mailto:${siteConfig.contact.email}`} class="footer-link">{siteConfig.contact.email}</a></li>
          <li><a href={`tel:${siteConfig.contact.phone}`} class="footer-link">{siteConfig.contact.phoneDisplay}</a></li>
          <li><span class="footer-text">{siteConfig.contact.city} · {siteConfig.contact.hours}</span></li>
          <li>
            <a
              href={siteConfig.contact.linkedin}
              rel="noopener noreferrer"
              target="_blank"
              class="footer-link"
            >LinkedIn<span class="sr-only"> (öffnet in neuem Tab)</span></a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Footer bottom bar -->
  <div class="site-footer__bottom">
    <div class="site-footer__bottom-inner">
      <p class="footer-copyright">
        &copy; <span id="copyright-year"></span> {siteConfig.name} – {siteConfig.tagline}
      </p>
      <ul role="list" class="footer-legal-list">
        {footerLegalNav.map((l) => (
          <li>
            <a href={`${base}${l.href}.html`} class="footer-link footer-link--sm">{l.label}</a>
          </li>
        ))}
        <li>
          {/*
            Der Widerruf gehört hierher, neben Impressum und Datenschutz.
            Art. 7 Abs. 3 DSGVO verlangt, dass das Zurücknehmen so leicht ist
            wie das Erteilen — und erteilt wird mit einem Klick. Ein Knopf und
            kein Link: Es wird nichts aufgerufen, sondern etwas geöffnet.
          */}
          <button type="button" class="footer-link footer-link--sm" data-consent-oeffnen>
            Cookie-Einstellungen
          </button>
        </li>
      </ul>
      <MotionToggle />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--gradient-footer);
    position: relative;
    overflow: hidden;
  }
  /* Der Inhalt muss über der Fläche liegen. */
  .site-footer__inner,
  .site-footer__bottom {
    position: relative;
    z-index: 1;
  }

  .site-footer__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: var(--raum-abschnitt);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--rinne-5);
  }

  /* Logo */
  .footer-logo {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .footer-logo__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--dk-schrift-karte);
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .footer-logo__tagline {
    font-size: var(--dk-schrift-klein);
    color: #d4d4d4;
    letter-spacing: 0.08em;
  }

  .footer-desc {
    font-size: var(--dk-schrift-klein);
    color: #d4d4d4;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .footer-address {
    font-style: normal;
    font-size: var(--dk-schrift-klein);
    color: #d4d4d4;
  }

  /* Column headings */
  .footer-heading {
    font-family: var(--font-display);
    font-size: var(--dk-schrift-klein);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  /* Nav lists */
  .footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--rinne-1);
  }

  /* Links */
  .footer-link {
    color: #d4d4d4;
    text-decoration: none;
    font-size: var(--dk-schrift-klein);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .footer-link--sm {
    font-size: var(--dk-schrift-klein);
  }

  .footer-text {
    color: #d4d4d4;
    font-size: var(--dk-schrift-klein);
  }

  /* Screen-reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* Bottom bar */
  .site-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-block: 1.25rem;
  }

  .site-footer__bottom-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--rinne-3);
  }

  .footer-copyright {
    font-size: var(--dk-schrift-klein);
    color: #d4d4d4;
    margin: 0;
  }

  .footer-legal-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--rinne-4);
    flex-wrap: wrap;
  }

  /* Der Knopf soll wie die Links daneben aussehen, nicht wie ein Knopf.

     Hier stand `font: inherit`, und es hat genau das Gegenteil bewirkt:
     Die Kurzform setzt auch die GRÖSSE, und zwar auf die geerbte —
     `--font-size-base`, also 19,2 px. Damit war „Cookie-Einstellungen"
     ein Drittel größer als „Impressum" und „Datenschutz" daneben.

     Dass es überhaupt gewinnen konnte, liegt an Astros Bereichsbindung:
     Sie hängt an JEDEN Selektor ein Attribut. Aus `.footer-legal-list
     button` (0,1,1) wird damit (0,3,1) und schlägt `.footer-link--sm`
     (0,2,0) — ohne die Bindung wäre es andersherum. Eine Regel, die im
     Quelltext harmlos aussieht, gewinnt im gebauten CSS.

     Deshalb hier keine Kurzform mehr, sondern die Eigenschaften, die
     wirklich gemeint sind. Die Größe bleibt, wo sie hingehört: an der
     Klasse, die auch die Links daneben tragen. */
  .footer-legal-list button {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    cursor: pointer;
    /* WCAG 2.5.8 verlangt 24 × 24 px Zielfläche. Bei 13 px Schrift misst
       die Zeile 21 px — zu wenig. Die Links daneben fallen unter die
       Inline-Ausnahme des Kriteriums, ein `<button>` nicht.

       Die drei Pixel oben und unten sind unsichtbar: Der Grund ist
       durchsichtig, der Text steht weiter auf einer Linie mit den
       Links. Es wächst die Fläche, nicht das Aussehen.

       Der Fehler entstand hier beim Entfernen von `font: inherit`: Die
       Kurzform hatte die Schrift auf 19,2 px gebläht, und mit ihr war
       die Zeile zufällig hoch genug. Eine Regel kann falsch sein und
       trotzdem etwas Richtiges bewirken — beim Aufräumen fällt das
       Zweite mit weg. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
</style>

<script>
  const yearEl = document.getElementById('copyright-year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
