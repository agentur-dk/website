---
/**
 * Head-Metadaten einer Seite.
 *
 * Canonical, Open Graph und Twitter Cards entstehen aus dem Slug und der
 * zentralen Konfiguration. Vorher fehlten og:url und og:site_name, und der
 * Canonical zeigte auf die GitHub-Pages-URL, während JSON-LD und llms.txt
 * dk-dk.de nannten — widersprüchliche Signale für Crawler.
 */
import { siteConfig, absolute, SITE_URL, NOINDEX_ALL } from '../../config/site.config';

/* `| undefined` an jedem optionalen Feld: Mit `exactOptionalPropertyTypes`
   ist ein fehlender Schlüssel nicht dasselbe wie einer mit dem Wert
   `undefined` — und aufrufende Seiten reichen genau das durch. */
interface Props {
  /** Seiten-Slug ohne Endung, '' für die Startseite. */
  slug:         string;
  title:        string;
  description:  string;
  noindex?:     boolean | undefined;
  ogImage?:     string | undefined;
  ogType?:      'website' | 'article' | undefined;
  canonical?:   string | undefined;
}

const {
  slug,
  title,
  description,
  noindex = false,
  ogImage,
  ogType = 'website',
  canonical: canonicalProp,
} = Astro.props;

const canonical       = canonicalProp ?? absolute(slug);
const resolvedOgImage = ogImage ?? `${SITE_URL}/${siteConfig.ogImage}`;

// Solange die Indexierungssperre steht, überschreibt sie jede Seiteneinstellung.
const blockIndex = NOINDEX_ALL || noindex;
---

<title>{title}</title>
<meta name="description" content={description} />

{blockIndex
  ? <>
      <meta name="robots" content="noindex, nofollow" />
      {/* googlebot und bingbot zusätzlich einzeln ansprechen: manche Dienste
          werten nur die auf sie gemünzte Direktive aus. */}
      <meta name="googlebot" content="noindex, nofollow" />
      <meta name="bingbot"   content="noindex, nofollow" />
    </>
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<link rel="canonical" href={canonical} />

<meta property="og:title"        content={title} />
<meta property="og:description"  content={description} />
<meta property="og:type"         content={ogType} />
<meta property="og:locale"       content="de_DE" />
<meta property="og:url"          content={canonical} />
<meta property="og:site_name"    content={siteConfig.name} />
<meta property="og:image"        content={resolvedOgImage} />
<meta property="og:image:width"  content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt"    content={`${siteConfig.legalName} — ${siteConfig.tagline}`} />

<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={resolvedOgImage} />
<meta name="twitter:image:alt"   content={`${siteConfig.legalName} — ${siteConfig.tagline}`} />

<meta name="author"    content={siteConfig.legalName} />
<meta name="publisher" content={siteConfig.legalName} />
<meta name="geo.region"    content="DE-NW" />
<meta name="geo.placename" content={siteConfig.contact.city} />
