---
/**
 * Einwilligungsbanner — SimpleCMP.
 *
 * Bis zum 01.09.2026 stand hier ein selbstgeschriebener Banner: 200 Zeilen
 * Markup und Skript, eine eigene Zustandsverwaltung in `src/lib/consent.ts`
 * und zwei Kategorien. Er funktionierte, war aber eine Eigenentwicklung an
 * einer rechtlich heiklen Stelle — und dieselbe Arbeit fiel in jedem
 * Projekt erneut an.
 *
 * Jetzt: SimpleCMP (BSD-3-Clause, Ableitung von Klaro). Verbindlich für
 * alle Websiteprojekte.
 *
 * **Selbst gebaut, mit Absicht dokumentiert:** Es gibt kein npm-Paket und
 * keine Bundles an den Releases, obwohl die Dokumentation
 * `pnpm add simplecmp` nennt. Das Bundle unter `public/vendor/simplecmp/`
 * ist aus dem Repository gebaut; Herkunft und Aktualisierungsweg stehen
 * dort in `HERKUNFT.txt`. Es gibt damit keine Fassungsverwaltung — eine
 * neue Fassung muss von Hand nachgezogen werden.
 *
 * **Blockiert wird über das Markup**, nicht über eine Rückmeldung im
 * Skript: Das Google-Tag steht als `type="text/plain"` mit `data-name` im
 * Dokument. Ohne Einwilligung führt der Browser es gar nicht erst aus —
 * das ist strenger als ein Skript, das erst nach der Zustimmung nachlädt,
 * denn es hängt nicht daran, dass unser eigener Code richtig läuft.
 */
interface Props {
  noConsent?: boolean;
}

const { noConsent = false } = Astro.props;
const base = import.meta.env.BASE_URL;

/** Messkennung. Ohne Einwilligung wird sie nirgends angefragt. */
const GA_ID = 'G-KJ0TV1QCMB';
---

{!noConsent && (
  <>
    <link rel="stylesheet" href={`${base}vendor/simplecmp/default.css`} />

    <!--
      Das Google-Tag, für den Browser zunächst nur Text. SimpleCMP tauscht
      den Typ erst, wenn für `google-analytics` eine Einwilligung vorliegt.
    -->
    <script
      type="text/plain"
      data-type="text/javascript"
      data-name="google-analytics"
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
      async
    ></script>
    <!--
      Bewusst `set:html` statt `define:vars`: Astro baut aus einem Skript mit
      `define:vars` ein gewöhnliches `<script>` und wirft dabei `type` weg.
      Der Block lief damit ohne Einwilligung — im Browser gemessen, im
      Markup nicht zu sehen. Mit `set:html` bleibt der Typ stehen.
    -->
    <script
      type="text/plain"
      data-type="text/javascript"
      data-name="google-analytics"
      is:inline
      set:html={`window.dataLayer=window.dataLayer||[];function gtag(){window.dataLayer.push(arguments)}` +
        `window.gtag=gtag;gtag('js',new Date());` +
        `gtag('config','${GA_ID}',{anonymize_ip:true});`}
    ></script>

    <script is:inline src={`${base}vendor/simplecmp/simplecmp.global.js`}></script>
    <script is:inline define:vars={{ base }}>
      SimpleCMP.init({
        storageName: 'dk-dk-consent',
        storageMethod: 'localStorage',
        lang: 'de',
        // Datenschutzerklärung und Impressum getrennt — in Deutschland
        // sind das zwei Pflichtangaben und nicht ein Sammellink.
        privacyPolicy: base + 'datenschutz.html',
        imprint: base + 'impressum.html',
        // Der Wiederaufruf. Ohne ihn liesse sich eine einmal erteilte
        // Einwilligung nicht mehr zurücknehmen, und genau das schreibt
        // Art. 7 Abs. 3 DSGVO vor.
        floatingTrigger: { label: 'Datenschutz-Einstellungen' },
        services: [
          {
            name: 'google-analytics',
            title: 'Google Analytics',
            description:
              'Misst anonymisiert, welche Seiten aufgerufen werden. ' +
              'Ohne Ihre Einwilligung wird das Google-Tag nicht geladen.',
            purposes: ['analytics'],
            cookies: [/^_ga/, '_gid', '_gat'],
            required: false,
            default: false,
          },
        ],
      });
    </script>
  </>
)}
