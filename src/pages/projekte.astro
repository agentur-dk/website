---
import BaseLayout from '../layouts/BaseLayout.astro';
import DitherBand from '../components/DitherBand.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaSection from '../components/CtaSection.astro';
import ReferenzKarte from '../components/ReferenzKarte.astro';
import { sichtbareReferenzen, vergebeneThemen, zeigtUnfreigegebenes, THEMEN } from '../data/referenzen';

const base = import.meta.env.BASE_URL;
const faelle = sichtbareReferenzen();
---

<BaseLayout
  slug="projekte"
  title="Referenzen & Projekte | agentur dk Köln"
  description="Projekte für Bundesministerium, TARGOBANK und Berufsförderungswerke: barrierefreie Portale, WordPress-Relaunches und Recruiting-Kampagnen."
  pageType={'CollectionPage'}
  mono
>

  <Header />

  <main id="main-content">

    <DitherBand field="dunes" label="Referenzen" cell={4} />

    <div class="page-header container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol class="breadcrumb__list">
          <li><a href={`${base}`}>Start</a></li>
          <li><span aria-current="page">Referenzen</span></li>
        </ol>
      </nav>
      <h1 class="page-header__title">Referenzen &amp; Projekte</h1>
      <p class="page-header__lead">Ausgewählte Projekte aus den Bereichen WordPress, BFSG, SEO, GEO, Online-Marketing und Corporate Design.</p>
    </div>

    <section class="section section--hell" aria-labelledby="projekte-heading">
      <div class="container">
        <h2 id="projekte-heading" class="u-sr-only">Projektübersicht</h2>

        <div class="filter-group-wrapper">
          <p class="section-label" aria-hidden="true">Filtern nach</p>
          <div
            id="filter-group"
            class="filter-group"
            role="group"
            aria-label="Projekte nach Leistung filtern"
          >
            <button type="button" class="chip chip--active" data-filter="all" aria-pressed="true">Alle</button>
            {vergebeneThemen().map((t) => (
              <button type="button" class="chip" data-filter={t} aria-pressed="false">{THEMEN[t]}</button>
            ))}
          </div>
          <p class="filter-status" id="filter-status" aria-live="polite" aria-atomic="true">{faelle.length} Projekte angezeigt</p>
        </div>

        {zeigtUnfreigegebenes() && (
          <p class="referenzen__warnung" role="note">
            <strong>Nur in der Vorschau sichtbar:</strong> Einzelne Fälle sind noch nicht vom
            Kunden freigegeben und erscheinen live erst nach der Freigabe.
          </p>
        )}
        <ul class="case-grid" id="projects-grid" role="list">
          {faelle.map((r) => <ReferenzKarte r={r} als="li" />)}
        </ul>
      </div>
    </section>

    <CtaSection
      title="Ihr Projekt ist das nächste?"
      text="Erzählen Sie uns von Ihrem Vorhaben – wir melden uns innerhalb von 24 Stunden."
      buttonLabel="Jetzt anfragen"
      buttonHref={`${base}#contact`}
    />

  </main>

  <Footer mono />

  <script>
  (function initProjectFilter() {
    'use strict';

    const filterGroup = document.getElementById('filter-group');
    const grid = document.getElementById('projects-grid');
    const statusEl = document.getElementById('filter-status');
    if (!filterGroup || !grid) return;

    const allCards = Array.from(grid.querySelectorAll<HTMLElement>('[data-tags]'));
    const totalCount = allCards.length;

    filterGroup.addEventListener('click', function (e) {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;

      const filter = btn.dataset.filter ?? 'all';

      filterGroup.querySelectorAll('[data-filter]').forEach(function (b) {
        const isActive = b === btn;
        b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        b.classList.toggle('chip--active', isActive);
      });

      let visibleCount = 0;

      allCards.forEach(function (card) {
        const tags = (card.dataset.tags ?? '').split(' ');
        const show = filter === 'all' || tags.includes(filter);
        card.hidden = !show;
        if (show) visibleCount++;
      });

      if (statusEl) {
        statusEl.textContent = visibleCount === totalCount
          ? totalCount + ' Projekte angezeigt'
          : visibleCount + ' von ' + totalCount + ' Projekten angezeigt';
      }
    });
  })();
  </script>
</BaseLayout>
