---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  slug="online-marketing"
  title="Online-Marketing Agentur Köln – Ads & Content | agentur dk"
  description="Google Ads, Meta- und LinkedIn-Kampagnen, Content- und E-Mail-Marketing aus Köln. Budget nach messbarem ROAS gesteuert statt nach Bauchgefühl."
    service={{
      name:        'Online-Marketing',
      description: 'Google Ads, Meta- und LinkedIn-Kampagnen, Content-Marketing und E-Mail-Marketing mit messbarer Steuerung über ROAS.',
      serviceType: 'Online Marketing',
      offers: ['Google Ads', 'Meta & Instagram Ads', 'LinkedIn Kampagnen', 'Content-Marketing', 'E-Mail-Marketing', 'Social Recruiting'],
    }}
>

  <Header />

  <main id="main-content" tabindex="-1">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <div class="container">
        <ol class="breadcrumb__list">
          <li><a href={`${base}`}>Start</a></li>
          <li><a href={`${base}leistungen.html`}>Leistungen</a></li>
          <li aria-current="page">Online-Marketing</li>
        </ol>
      </div>
    </nav>

    <!-- SECTION: Hero -->
    <section class="section section--hero" aria-labelledby="hero-heading">
      <div class="container">
        <p class="section__label">Online-Marketing</p>
        <h1 id="hero-heading" class="section__headline">Marketing, das sich rechnet</h1>
        <p class="section__lead">Google Ads, Meta &amp; LinkedIn Kampagnen, Content und E-Mail-Marketing – messbar, zielgruppengenau und auf Ihren ROAS optimiert. Aus Köln, für ganz Deutschland.</p>
        <div class="hero__actions">
          <a href="#contact" class="btn btn--primary btn--lg">Kampagne starten</a>
          <a href={`${base}seo-geo.html`} class="btn btn--outline btn--lg">SEO &amp; GEO dazu buchen</a>
        </div>
      </div>
    </section>

    <!-- SECTION: Problem / Benefits -->
    <section class="section section--dark" aria-labelledby="om-problem">
      <div class="container">
        <div class="section__grid section__grid--2col">
          <div class="section__col">
            <h2 id="om-problem" class="section__heading">Budget verbrannt statt Kunden gewonnen?</h2>
            <p>Viele Kampagnen verbrennen Budget, weil Strategie, Kreative und Tracking nicht zusammenspielen.</p>
            <p>Wir bauen Online-Marketing, das sich rechnet: sauberes Tracking, klare KPIs und laufende Optimierung – vom ersten Tag an.</p>
          </div>
          <div class="section__col">
            <h3 class="section__subheading">So steuern wir Ihr Marketing</h3>
            <ul class="checklist">
              <li class="checklist__item">Kampagnen mit klarem Ziel: Leads, Sales oder Markenbekanntheit</li>
              <li class="checklist__item">Datenbasiertes Budget-Management statt Bauchgefühl</li>
              <li class="checklist__item">Kreative, die zur Zielgruppe passen – nicht zum Mainstream</li>
              <li class="checklist__item">Regelmäßige Reportings: ROAS, CAC, Conversion-Rate</li>
              <li class="checklist__item">Abstimmung mit Website, SEO und Corporate Design</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: Leistungen -->
    <section class="section section--light" aria-labelledby="om-leistungen">
      <div class="container">
        <p class="section__label">Leistungen</p>
        <div class="card-grid card-grid--3col">
          <article class="card" data-reveal>
            <h3 class="card__heading">Google Ads</h3>
            <p class="card__body">Such- und Display-Kampagnen mit sauberem Tracking und optimiertem Keyword-Set.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">Meta &amp; Instagram Ads</h3>
            <p class="card__body">Social-Kampagnen mit ansprechenden Creatives und präziser Zielgruppenansprache.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">LinkedIn Kampagnen</h3>
            <p class="card__body">B2B-Marketing und Personalmarketing dort, wo Entscheider unterwegs sind.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">Content-Marketing</h3>
            <p class="card__body">Redaktionspläne, Artikel und Social-Content, die Ihre Expertise zeigen.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">E-Mail-Marketing</h3>
            <p class="card__body">Newsletter und Automation, die Kunden binden und wieder aktivieren.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">Social Recruiting</h3>
            <p class="card__body">Mitarbeitergewinnung über zielgenaue Kampagnen – mit KI unterstützt.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION: Prozess -->
    <section class="section section--light" aria-labelledby="om-prozess">
      <div class="container">
        <p class="section__label">So arbeiten wir</p>
        <h2 id="om-prozess" class="section__heading">In vier Schritten zum Ergebnis</h2>
        <ol class="process-list" role="list">
          <li class="process-list__item" data-reveal>
            <span class="process-list__number" aria-hidden="true">01</span>
            <div class="process-list__content">
              <h3 class="process-list__heading">Ziele &amp; Zielgruppe</h3>
              <p class="process-list__body">Wir definieren messbare Ziele und wissen, wen wir erreichen wollen.</p>
            </div>
          </li>
          <li class="process-list__item" data-reveal>
            <span class="process-list__number" aria-hidden="true">02</span>
            <div class="process-list__content">
              <h3 class="process-list__heading">Strategie &amp; Setup</h3>
              <p class="process-list__body">Kanalwahl, Tracking, Budgetverteilung – die Basis für saubere Ergebnisse.</p>
            </div>
          </li>
          <li class="process-list__item" data-reveal>
            <span class="process-list__number" aria-hidden="true">03</span>
            <div class="process-list__content">
              <h3 class="process-list__heading">Kampagnen &amp; Kreative</h3>
              <p class="process-list__body">Umsetzung mit Test-Setups: Was funktioniert, wird skaliert. Der Rest wird gestoppt.</p>
            </div>
          </li>
          <li class="process-list__item" data-reveal>
            <span class="process-list__number" aria-hidden="true">04</span>
            <div class="process-list__content">
              <h3 class="process-list__heading">Reporting &amp; Optimierung</h3>
              <p class="process-list__body">Transparente Zahlen, laufende Optimierung – und am Ende ein klares Ergebnis.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- SECTION: Weitere Leistungen -->
    <section class="section section--sm" aria-label="Passende Leistungen">
      <div class="container">
        <h2 class="section__subheading">Passende Leistungen</h2>
        <ul class="footer-col__list" role="list">
          <li><a href={`${base}social-recruiting.html`} class="footer-col__link">Social Recruiting</a></li>
          <li><a href={`${base}seo-geo.html`} class="footer-col__link">SEO &amp; GEO</a></li>
          <li><a href={`${base}corporate-design.html`} class="footer-col__link">Corporate Design</a></li>
          <li><a href={`${base}ki-services.html`} class="footer-col__link">KI-Services</a></li>
        </ul>
      </div>
    </section>

    <!-- SECTION: FAQ -->
    <FaqAccordion slug="online-marketing" />

    <!-- SECTION: Kontakt -->
    <LeadForm page="Online-Marketing" heading="Jetzt unverbindlich anfragen" />

  </main>

  <Footer />
</BaseLayout>
