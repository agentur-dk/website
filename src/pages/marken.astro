---
/**
 * Unsere Marken — was wir für uns selbst aufgebaut haben.
 *
 * ── Warum diese Seite ─────────────────────────────────────────────────
 * Auf der Startseite steht DU BIST GRIECHE in vier Sätzen als Beleg.
 * Das reicht, um zu sagen „wir können Reichweite"; es reicht nicht, um
 * zu zeigen, WIE eine Marke entsteht. Diese Seite zeigt die Teile: die
 * Idee, die Bausteine, die Jahre. Ein Interessent soll den Aufwand
 * sehen, nicht nur das Ergebnis.
 *
 * ── Woher die Angaben stammen ─────────────────────────────────────────
 * Nichts hier ist geschätzt.
 *
 *   750.000 Follower · 15.000 Streams je Folge · seit 2015
 *     aus website-referenzen.docx (Stand 21.09.2026), dieselbe Quelle
 *     wie in EigeneProjekte.astro. Was dort als unbelegt markiert war,
 *     steht auch hier nicht.
 *
 *   Podcastname, Themenfelder
 *     aus den Suchdaten der Marke (GA4/Search Console, Ausfuhr vom
 *     28.08.2026): der Pfad `podcast-der-satz-des-pitagyros` und die
 *     Suchanfragen, über die Menschen tatsächlich auf der Seite landen.
 *
 *   aposocial: Claim „Ihre tägliche Dosis Social Media"
 *     aus dem WordPress-Export der Seite (21.07.2025).
 *
 * ── Die Lücken ────────────────────────────────────────────────────────
 * Was nur Daniel weiß, steht als sichtbare Lücke im Text (.luecke) und
 * nicht als plausible Erfindung. Das betrifft vor allem den
 * Podcast-Folgenlink, die Newsletter-Angaben und die Frage, ob
 * aposocial als eigene Marke oder als Kundenmarke geführt wird — dazu
 * widersprechen sich die bestehenden Seiten (siehe unten).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DitherBand from '../components/DitherBand.astro';
import Dither from '../components/ui/Dither.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/ui/Icon.astro';

const base = import.meta.env.BASE_URL;

/**
 * Die beiden Marken in einer Zeile — das Erste, was man sieht.
 * `bausteine` zählt, was unten im Markensystem steht; `seit` ist belegt.
 */
const marken = [
  {
    id: 'dbg',
    logo: 'du-bist-grieche.svg',
    eigenfarben: true,
    // Quadratisch (1:1) — bei gleicher Höhe wie eine breite Wortmarke
    // wirkt sie wie eine Briefmarke. Dieselbe Abwägung steht in
    // kunden.ts neben der Logoleiste.
    logoHoehe: '4.25rem',
    name: 'DU BIST GRIECHE',
    seit: 2015,
    bausteine: 6,
    kurz: 'Die größte Plattform für Griechenland-Liebhaber im deutschsprachigen Raum.',
  },
  {
    id: 'aposocial',
    logo: 'aposocial.svg',
    eigenfarben: false,
    logoHoehe: '1.9rem',
    name: 'aposocial',
    seit: 2021,
    bausteine: null,
    kurz: 'Branchenplattform für Apotheken — „Ihre tägliche Dosis Social Media".',
  },
];

const JAHR_HEUTE = 2026;

/**
 * Nur, was belegt ist.
 *
 * Für Website (2015) und Shop (2026) steht das Jahr in der geprüften
 * Quelle. Für Agora, Podcast, Newsletter und Kanäle steht es nirgends —
 * und ein geschätztes Jahr auf einer Zeitleiste ist keine Schätzung
 * mehr, sondern eine Behauptung. Sie fehlen deshalb, sichtbar benannt
 * im Kasten darunter.
 */
const MEILENSTEINE: Record<number, string> = {
  2015: 'Erste Zeile',
  2026: 'Der Shop',
};

/**
 * Das Markensystem, nach Aufgabe gruppiert.
 *
 * Sechs Kacheln nebeneinander zeigen sechs Dinge. Drei Gruppen zeigen,
 * WIE sie zusammenhängen: Eine Marke zieht an, bindet und erlöst — und
 * erst das macht aus Einzelteilen ein System. Genau das war auf der
 * ersten Fassung dieser Seite nicht zu sehen.
 */
const dbgSystem = [
  {
    gruppe: 'Anziehen',
    zweck: 'Menschen finden die Marke, ohne sie zu kennen.',
    teile: [
      { icon: 'code',      titel: 'Website',  text: 'Der Kern seit 2015, über zehn Jahrgänge Archiv. Trägt die Suchsichtbarkeit.' },
      { icon: 'megaphone', titel: 'Kanäle',   text: '750.000 Follower im erweiterten Kanalumfeld. Die Eingangstür.' },
    ],
  },
  {
    gruppe: 'Binden',
    zweck: 'Aus Besuchern werden Wiederkehrer.',
    teile: [
      { icon: 'users', titel: 'Agora',      text: 'Der Community-Bereich. Die Leser reden miteinander, nicht nur mit uns.' },
      { icon: 'mic',   titel: 'Podcast',    text: '„Der Satz des Pitagyros" mit Panayota Petridou. 15.000 Streams je Folge.' },
      { icon: 'mail',  titel: 'Newsletter', text: 'Der Rückkanal, der uns gehört. Reichweite auf fremden Plattformen ist geliehen.' },
    ],
  },
  {
    gruppe: 'Erlösen',
    zweck: 'Aus Aufmerksamkeit wird ein Geschäft.',
    teile: [
      { icon: 'shopping-cart', titel: 'Shop', text: 'Seit 2026: Schmuck, graviert in Köln. Elf Jahre nach der ersten Zeile.' },
    ],
  },
] as const;

/** Wonach Menschen suchen, wenn sie auf der Plattform landen. */
const dbgThemen = [
  'Griechische Namenstage',
  'Griechische Nachnamen',
  'Aktuelle Waldbrandlagen mit Karte',
  'Identitätsformate („Welcher griechische Gott bin ich?")',
];

/** Die Chronik — wie aus einer Idee eine Marke wurde. */
const dbgChronik = [
  { jahr: '2015', text: 'Start als Inhalteseite. Kein Auftraggeber, kein Budget von außen, kein Gesellschafter — die Arbeit läuft vor, der Ertrag kommt später oder gar nicht.' },
  { jahr: 'Die Jahre danach', text: 'Täglich veröffentlichen. Das ist der ganze Trick und zugleich der Teil, den fast alle unterschätzen: Reichweite entsteht aus Wiederholung, nicht aus Kampagnen.' },
  { jahr: 'Community', text: 'Aus Lesern werden Teilnehmer. Die Agora macht aus der Seite einen Ort, an dem man bleibt, statt einen, den man liest und verlässt.' },
  { jahr: 'Podcast', text: 'Die Marke bekommt eine Stimme. Ein Gesicht von außen — Panayota Petridou — bringt Publikum mit, das die Seite allein nie erreicht hätte.' },
  { jahr: '2026', text: 'Der Shop. Erst an dieser Stelle wird die Reichweite zu Umsatz. Elf Jahre nach der ersten Zeile — das ist der ehrliche Zeitraum, über den Markenaufbau läuft.' },
];
---

<BaseLayout
  slug="marken"
  title="Unsere Marken – DU BIST GRIECHE & aposocial | agentur dk"
  description="Zwei Marken, die wir selbst aufgebaut haben: DU BIST GRIECHE seit 2015 und aposocial seit 2021 — Markenkern, Bausteine und der Weg dahin."
  mono
>

  <Header />
  <main id="main-content" tabindex="-1">

    <nav aria-label="Breadcrumb" class="breadcrumb">
      <div class="container">
        <ol class="breadcrumb__list">
          <li><a href={`${base}`}>Start</a></li>
          <li aria-current="page">Unsere Marken</li>
        </ol>
      </div>
    </nav>

    <section class="section section--hero" aria-labelledby="hero-heading">
      <div class="hero-flaeche hero-flaeche--rechts" aria-hidden="true"><Dither field="drift" cell={3} fps={12} /></div>
      <div class="container">
        <p class="section__label">Eigene Marken</p>
        <h1 id="hero-heading" class="section__headline">Zwei Marken, elf Jahre, kein Auftraggeber</h1>
        <p class="section__lead">
          Jede Agentur sagt, sie könne Markenaufbau. Hier steht, was wir dafür
          selbst riskiert haben — mit eigenem Geld, ohne Briefing und ohne
          Rückfahrkarte.
        </p>
        <!-- Beide Marken auf einen Blick: Marke, Spanne, Umfang.
             Vorher standen hier zwei Knöpfe — die sagten nichts über
             das, was dahintersteht. -->
        <ul class="markenliste" role="list">
          {marken.map((m) => (
            <li class="markenkarte">
              <a class="markenkarte__link" href={`#${m.id}`}>
                <img
                  class:list={['markenkarte__logo', m.eigenfarben && 'markenkarte__logo--eigen']}
                  src={`${base}logos/${m.logo}`} alt={m.name}
                  width="240" height="80" loading="lazy"
                  style={`--logo-hoehe: ${m.logoHoehe}`}
                />
                <span class="markenkarte__spanne">
                  <span class="markenkarte__jahr">{m.seit}</span>
                  <span class="markenkarte__strich" aria-hidden="true"></span>
                  <span class="markenkarte__jahr">heute</span>
                </span>
                <span class="markenkarte__zahlen">
                  <span class="markenkarte__zahl">
                    <b>{JAHR_HEUTE - m.seit}</b> Jahre
                  </span>
                  {m.bausteine && (
                    <span class="markenkarte__zahl">
                      <b>{m.bausteine}</b> Bausteine
                    </span>
                  )}
                </span>
                <span class="markenkarte__kurz">{m.kurz}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <DitherBand field="drift" label="Markenaufbau im eigenen Haus" cell={4} />

    <section class="section section--hell" aria-labelledby="warum-heading">
      <div class="container">
        <p class="section__label">Warum wir das zeigen</p>
        <h2 id="warum-heading" class="section__heading">Der Unterschied zwischen einem Auftrag und einem Risiko</h2>
        <div class="section__grid section__grid--2col">
          <div class="section__col">
            <p class="section__lead">
              Für einen Kunden zu bauen heißt: Es gibt ein Briefing, ein Budget und
              einen Abnahmetermin. Eine eigene Marke aufzubauen heißt: Es gibt nichts
              davon. Niemand bezahlt die ersten drei Jahre, und niemand sagt, ob es
              funktioniert.
            </p>
            <p class="section__lead">
              Genau deshalb steht das hier. Was wir Kunden über Positionierung,
              Inhalte und Ausdauer erzählen, haben wir zuerst an uns selbst
              ausprobiert — mit eigenem Geld und ohne Rückfahrkarte.
            </p>
          </div>
          <div class="section__col">
            <h3 class="section__subheading">Was dabei entsteht, das ein Briefing nicht liefert</h3>
            <ul class="checklist">
              <li class="checklist__item">Wie lange es wirklich dauert, bis Reichweite trägt</li>
              <li class="checklist__item">Welche Formate nach drei Jahren noch laufen — und welche nicht</li>
              <li class="checklist__item">Was es kostet, eine Community zu halten statt sie zu kaufen</li>
              <li class="checklist__item">Wann aus Aufmerksamkeit ein Produkt werden kann</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════ DU BIST GRIECHE ══════════════════ -->
    <section id="dbg" class="section" aria-labelledby="dbg-heading">
      <div class="container">
        <p class="section__label">Marke 01 · seit 2015</p>
        <h2 id="dbg-heading" class="section__heading">DU BIST GRIECHE</h2>
        <p class="section__lead">
          Die größte Plattform für Griechenland-Liebhaber im deutschsprachigen Raum.
          Aufgebaut ohne Auftraggeber, ohne Budget von außen, auf eigenes Risiko.
        </p>

        <!-- Die Spanne als Fläche, nicht als Satz.
             Zwölf Jahresblöcke, lückenlos gefüllt: Das ist der Beleg für
             Ausdauer, den eine Zahl allein nicht liefert. Die beiden
             Marken darunter im selben Maßstab — so sieht man, dass die
             eine doppelt so lange läuft wie die andere. -->
        <div class="leiste">
          <ol class="leiste__jahre" role="list" aria-label="Veröffentlichungsjahre">
            {Array.from({ length: JAHR_HEUTE - 2015 + 1 }, (_, i) => 2015 + i).map((jahr) => {
              const schritt = MEILENSTEINE[jahr];
              return (
                <li class:list={['leiste__jahr', schritt && 'leiste__jahr--punkt']}>
                  <span class="leiste__block" aria-hidden="true"></span>
                  <span class="leiste__zahl">{String(jahr).slice(2)}</span>
                  {schritt && <span class="leiste__marke">{schritt}</span>}
                </li>
              );
            })}
          </ol>
          <p class="leiste__legende">
            {Object.entries(MEILENSTEINE).map(([jahr, was]) => (
              <span class="leiste__legendeneintrag">
                <span class="leiste__punkt" aria-hidden="true"></span>{jahr} · {was}
              </span>
            ))}
          </p>
          <p class="leiste__fuss">
            Zwölf Jahrgänge, täglich veröffentlicht. Keine Kampagne, kein Relaunch —
            Wiederholung über elf Jahre ist der ganze Mechanismus. Markiert sind die
            beiden Jahre, für die uns ein Beleg vorliegt.
          </p>
        </div>

        <div class="section__grid section__grid--2col">
          <div class="section__col">
            <h3 class="section__subheading">Die DNA von DU BIST GRIECHE</h3>
            <p class="marke__text">
              Griechenland als Zugehörigkeit, nicht als Reiseziel. Die Marke spricht
              Menschen an, für die Griechenland Herkunft, Familie oder Sehnsuchtsort
              ist — und sie spricht sie als Gemeinschaft an, nicht als Zielgruppe.
            </p>
            <p class="marke__text">
              Der Ton ist dabei nie belehrend und nie touristisch. Zwischen Namenstagen
              und Waldbrandkarten liegt dieselbe Haltung: nützlich sein, bevor man
              unterhält.
            </p>
          </div>
          <div class="section__col">
            <h3 class="section__subheading">Der USP von DU BIST GRIECHE</h3>
            <p class="marke__text">
              <strong>Servicejournalismus statt Postkartenmotive.</strong> Wer
              „Griechenland" sagt, meint fast immer Urlaub. DU BIST GRIECHE besetzt
              das, was danach kommt: Alltag, Sprache, Namen, Nachrichten von zu Hause.
            </p>
            <p class="marke__text">
              Das ist der Grund, warum die Marke Suchanfragen gewinnt, für die kein
              Reiseanbieter je gebaut hätte. Wonach Menschen tatsächlich suchen, wenn
              sie hier landen:
            </p>
            <ul class="checklist">
              {dbgThemen.map((t) => <li class="checklist__item">{t}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--hell" aria-labelledby="dbg-teile-heading">
      <div class="container">
        <p class="section__label">Der Aufbau</p>
        <h2 id="dbg-teile-heading" class="section__heading">Aus welchen Teilen die Marke besteht</h2>
        <p class="section__lead">
          Eine Marke ist kein Logo und keine Website. Sie ist das, was zusammen
          funktioniert — und jeder dieser Teile hat Jahre gebraucht.
        </p>
        <div class="system">
          {dbgSystem.map((g) => (
            <section class="system__gruppe" aria-label={g.gruppe}>
              <header class="system__kopf">
                <h3 class="system__name">{g.gruppe}</h3>
                <p class="system__zweck">{g.zweck}</p>
              </header>
              <ul class="system__teile" role="list">
                {g.teile.map((teil) => (
                  <li class="system__teil">
                    <span class="system__ikon" aria-hidden="true"><Icon name={teil.icon} size={20} /></span>
                    <span class="system__text">
                      <b class="system__titel">{teil.titel}</b>
                      {teil.text}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <!--
          Die erste Folge, hörbar auf der Seite.

          Der Podigee-Player ist ein Dritter: Er lädt ein Skript von
          player.podigee-cdn.net und holt seine Einstellungen von
          dersatzdespitagyros.podigee.io. Beides überträgt die IP-Adresse
          des Besuchers. Vor der Einwilligung darf das nicht passieren
          (§ 25 TDDDG), deshalb steht das Skript als `type="text/plain"`
          im Markup — der Browser führt es gar nicht erst aus. Erst wenn
          der Zweck „einbettungen" angenommen ist, trägt CookieConsent es
          nach. Das hängt nicht daran, dass unser eigenes Skript richtig
          läuft.

          Solange es gesperrt ist, steht hier kein leerer Kasten, sondern
          eine Erklärung, ein Knopf, der die Auswahl öffnet, und ein
          gewöhnlicher Link auf die Folge. Die Inhalte bleiben ohne
          Einwilligung erreichbar — sonst wäre die Wahl keine.
        -->
        <figure class="folge">
          <figcaption class="folge__kopf">
            <span class="folge__reihe">Der Satz des Pitagyros · Folge 1 · 32:19</span>
            <h3 class="folge__titel">Wer zu viel Geld hat</h3>
          </figcaption>

          <div class="folge__platzhalter" data-folge-platzhalter>
            <p class="folge__hinweis">
              Der Player kommt von Podigee und erfährt dabei Ihre IP-Adresse.
              Deshalb laden wir ihn erst, wenn Sie zustimmen.
            </p>
            <p class="folge__wege">
              <button type="button" class="btn btn--secondary" data-consent-oeffnen>
                Player erlauben
              </button>
              <a class="folge__extern" href="https://dersatzdespitagyros.podigee.io/1-wer-zuviel-geld-hat"
                 target="_blank" rel="noopener noreferrer">
                Folge bei Podigee öffnen<span class="u-sr-only"> (öffnet in neuem Tab)</span>
              </a>
            </p>
          </div>

          <div class="folge__player" data-folge-player>
            <script
              type="text/plain"
              data-category="einbettungen"
              class="podigee-podcast-player"
              src="https://player.podigee-cdn.net/podcast-player/javascripts/podigee-podcast-player.js"
              data-configuration="https://dersatzdespitagyros.podigee.io/1-wer-zuviel-geld-hat/embed?context=external"
              is:inline
            ></script>
          </div>
        </figure>

        <p class="marke__nachtrag">
          <span class="luecke">Lücke: der Newsletter</span>
          Erscheinungsrhythmus und Abonnentenzahl kenne ich nicht — sag mir beides,
          dann steht es im Baustein oben statt einer allgemeinen Beschreibung.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="dbg-chronik-heading">
      <div class="container">
        <p class="section__label">Der Weg</p>
        <h2 id="dbg-chronik-heading" class="section__heading">Elf Jahre, in fünf Schritten</h2>
        <ol class="chronik" role="list">
          {dbgChronik.map((c) => (
            <li class="chronik__eintrag">
              <p class="chronik__jahr">{c.jahr}</p>
              <p class="chronik__text">{c.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <DitherBand field="pulse" label="aposocial" cell={4} />

    <!-- ══════════════════ aposocial ══════════════════ -->
    <section id="aposocial" class="section section--hell" aria-labelledby="apo-heading">
      <div class="container">
        <p class="section__label">Marke 02 · seit 2021</p>
        <h2 id="apo-heading" class="section__heading">aposocial</h2>
        <p class="section__lead">
          Eine Branchenplattform für Apotheken mit einem Versprechen im Claim:
          <strong>„Ihre tägliche Dosis Social Media."</strong> Die längste
          durchgehende Zusammenarbeit in unserem Bestand.
        </p>

        <p class="marke__nachtrag">
          <span class="luecke">Lücke: Eigene Marke oder Kundenmarke?</span>
          Die bestehenden Seiten widersprechen sich: <code>llms.txt</code> führt
          aposocial als eigene Marke, die Startseite schreibt „betreuen wir seit
          2021". Beides kann nicht stimmen, und die Antwort entscheidet, wie dieser
          Abschnitt formuliert sein darf. Bis dahin steht hier nur, was in beiden
          Fällen gilt: die Arbeit.
        </p>

        <div class="section__grid section__grid--2col">
          <div class="section__col">
            <h3 class="section__subheading">Die DNA von aposocial</h3>
            <p class="marke__text">
              Eine Apotheke ist ein Gesundheitsbetrieb mit Verkaufsfläche — und ein
              Arbeitgeber, der um Personal konkurriert. aposocial übersetzt genau
              diese Doppelrolle in Kommunikation, die im Alltag einer Offizin
              tatsächlich zu leisten ist.
            </p>
            <p class="marke__text">
              Der Claim sagt das Versprechen sehr genau: nicht Strategie, sondern
              <em>tägliche Dosis</em>. Etwas, das jeden Tag ohne Agenturtermin
              funktioniert.
            </p>
          </div>
          <div class="section__col">
            <h3 class="section__subheading">Der USP von aposocial</h3>
            <p class="marke__text">
              <strong>Branchentiefe statt Branchenbreite.</strong> Social Media für
              alle gibt es überall. Eine Plattform, die weiß, was eine Apotheke
              rechtlich sagen darf und was ihr Publikum interessiert, gibt es selten.
            </p>
            <p class="marke__text">
              <span class="luecke">Lücke: Bausteine</span>
              Aus welchen Teilen besteht aposocial heute — Redaktion, Vorlagen,
              Schulungen, Community, Newsletter? Nenne mir die Bausteine, dann baue
              ich sie hier genauso auf wie bei DU BIST GRIECHE.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="fazit-heading">
      <div class="container">
        <p class="section__label">Was daraus folgt</p>
        <h2 id="fazit-heading" class="section__heading">Was wir daraus für Ihre Marke mitbringen</h2>
        <div class="card-grid card-grid--3col">
          <article class="card" data-reveal>
            <h3 class="card__heading">Wir kennen die Durststrecke</h3>
            <p class="card__body">
              Die ersten Jahre einer Marke bringen nichts ein. Wir können sagen, wie
              lang sie dauert und woran man erkennt, dass man auf dem richtigen Weg
              ist — weil wir sie zweimal durchlaufen haben.
            </p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">Wir bauen für den Betrieb, nicht für die Präsentation</h3>
            <p class="card__body">
              Was täglich bespielt werden muss, muss ohne Agentur funktionieren.
              Diese Erfahrung steckt in jedem Redaktionsplan und jeder Vorlage, die
              wir für Kunden anlegen.
            </p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">Wir wissen, was eigene Flächen wert sind</h3>
            <p class="card__body">
              Reichweite auf fremden Plattformen ist geliehen. Website, Newsletter
              und Shop gehören Ihnen — und sie sind der Teil, der bleibt, wenn ein
              Kanal seine Regeln ändert.
            </p>
          </article>
        </div>
      </div>
    </section>

    <LeadForm
      heading="Eine eigene Marke aufbauen?"
      page="Unsere Marken"
      blau
    />

  </main>
  <Footer />
</BaseLayout>

<style>
  /* Fließtext in den Markenabschnitten. Die Grade kommen aus der Leiter,
     die Zeilenlänge aus dem Maß — beides siehe tokens/typography.css. */
  .marke__text {
    font-size: var(--dk-schrift-text);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
    max-width: var(--dk-measure-body);
    margin: 0 0 var(--rinne-4);
  }
  .marke__text strong { color: var(--color-text); }

  .marke__ikon {
    display: block;
    color: var(--color-accent);
    margin-bottom: var(--rinne-2);
  }

  /* Die Chronik: eine Zeitleiste, die ohne Jahreszahlen-Optik auskommt.
     Der senkrechte Strich links ist die Zeit, die Einträge sind die
     Schritte darauf. */
  .chronik {
    list-style: none;
    margin: var(--rinne-6) 0 0;
    padding: 0;
    border-left: 1px solid var(--color-border-strong);
    display: flex;
    flex-direction: column;
    gap: var(--rinne-6);
    max-width: 58rem;
  }
  .chronik__eintrag {
    position: relative;
    padding-left: var(--rinne-5);
  }
  /* Der Punkt sitzt auf der Linie, nicht daneben: -4px ist die halbe
     Punktbreite plus die halbe Linienbreite. */
  .chronik__eintrag::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .chronik__jahr {
    margin: 0 0 var(--rinne-1);
    font-family: var(--font-mono);
    font-size: var(--dk-schrift-klein);
    letter-spacing: var(--dk-tracking-mono);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .chronik__text {
    margin: 0;
    font-size: var(--dk-schrift-text);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
    max-width: var(--dk-measure-body);
  }

  /* Eine offene Stelle, die als solche zu erkennen ist.
     Lieber eine sichtbare Lücke als eine plausible Erfindung — was hier
     steht, weiß nur Daniel, und geraten wäre es eine Behauptung über
     sein eigenes Geschäft. */
  .marke__nachtrag {
    margin: var(--rinne-6) 0 0;
    padding: var(--rinne-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--dk-schrift-karte);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
    max-width: var(--dk-measure-body);
  }
  .luecke {
    display: block;
    margin-bottom: var(--rinne-1);
    font-family: var(--font-mono);
    font-size: var(--dk-schrift-klein);
    letter-spacing: var(--dk-tracking-mono);
    text-transform: uppercase;
    color: var(--color-text);
  }
  .marke__nachtrag code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-text);
  }

  /* ── Die beiden Marken im Kopf ──────────────────────────────────────
     Zwei Karten statt zweier Knöpfe. Wer die Seite öffnet, sieht sofort
     beide Marken, ihre Spanne und ihren Umfang — das war der Punkt, an
     dem die erste Fassung scheiterte: Sie behauptete Breite, statt sie
     zu zeigen. */
  .markenliste {
    list-style: none;
    margin: var(--rinne-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--rinne-4);
    max-width: 52rem;
  }
  .markenkarte { display: flex; }
  .markenkarte__link {
    display: flex;
    flex-direction: column;
    gap: var(--rinne-3);
    flex: 1;
    padding: var(--rinne-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }
  .markenkarte__link:hover { border-color: var(--color-primary); }
  .markenkarte__logo {
    height: var(--logo-hoehe, 2.6rem);
    width: auto;
    max-width: 14rem;
    object-fit: contain;
    object-position: left;
    /* Die Logos sind für dunklen Grund gedacht; eines bringt eigene
       Farben mit (siehe eigeneFarben in kunden.ts). */
    filter: brightness(0) invert(1);
  }
  .markenkarte__logo--eigen { filter: none; }

  /* Die Spanne als Strich: Anfangsjahr, Linie, heute. Eine Jahreszahl
     allein liest man, eine Strecke sieht man. */
  .markenkarte__spanne {
    display: flex;
    align-items: center;
    gap: var(--rinne-2);
  }
  .markenkarte__jahr {
    font-family: var(--font-mono);
    font-size: var(--dk-schrift-klein);
    letter-spacing: var(--dk-tracking-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .markenkarte__strich {
    flex: 1;
    height: 1px;
    background: var(--color-accent);
  }
  .markenkarte__zahlen {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rinne-4);
  }
  .markenkarte__zahl {
    font-size: var(--dk-schrift-klein);
    color: var(--color-text-muted);
  }
  .markenkarte__zahl b {
    display: block;
    font-family: var(--font-display);
    font-size: var(--dk-schrift-titel-3);
    font-weight: 400;
    letter-spacing: var(--dk-tracking-titel-3);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .markenkarte__kurz {
    font-size: var(--dk-schrift-karte);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
  }

  /* ── Die Jahresleiste ───────────────────────────────────────────────
     Zwölf gefüllte Blöcke. Der Beleg für Ausdauer ist die Fläche, nicht
     die Jahreszahl daneben. */
  .leiste { margin: var(--rinne-6) 0 var(--rinne-6); max-width: 52rem; }
  .leiste__jahre {
    list-style: none;
    margin: 0 0 var(--rinne-3);
    padding: 0;
    display: flex;
    gap: 3px;
  }
  .leiste__jahr {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--rinne-1);
    min-width: 0;
  }
  /* Ruhiger Grundton, damit die Leiste nicht schreit: #6c6c6c erreicht
     auf #101010 gemessen 3,62 : 1 und liegt damit über der Schwelle für
     grafische Objekte. Die belegten Jahre stehen im Akzent und heben
     sich dadurch ab — das ist die Bewegung, die man sehen soll. */
  .leiste__block {
    display: block;
    width: 100%;
    height: 2.75rem;
    background: #6c6c6c;
    border-radius: 1px;
  }
  .leiste__jahr--punkt .leiste__block { background: var(--color-accent); }
  .leiste__jahr--punkt .leiste__zahl { color: var(--color-text); }
  /* Die Beschriftung steht über dem Block, nicht neben ihm — sonst
     schiebt sie bei zwölf Spalten die ganze Leiste über den Rand.
     Gemessen bei 390 px: 395 px Dokumentbreite, also eine waagerechte
     Bildlaufleiste auf jedem Telefon. Deshalb absolut positioniert und
     unter 48 rem ganz weg; dort trägt die Legende darunter dieselbe
     Information, nur lesbar. */
  .leiste__jahr { position: relative; }
  .leiste__marke {
    position: absolute;
    bottom: calc(100% + var(--rinne-1));
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--dk-schrift-klein);
    letter-spacing: var(--dk-tracking-mono);
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .leiste__jahre { margin-top: 1.75rem; }

  .leiste__legende {
    display: none;
    margin: 0 0 var(--rinne-3);
    gap: var(--rinne-4);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--dk-schrift-klein);
    letter-spacing: var(--dk-tracking-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .leiste__legendeneintrag { display: inline-flex; align-items: center; gap: var(--rinne-1); }
  .leiste__punkt {
    width: 8px; height: 8px; border-radius: 1px;
    background: var(--color-accent);
  }

  @media (max-width: 48rem) {
    .leiste__marke { display: none; }
    .leiste__jahre { margin-top: 0; }
    .leiste__legende { display: flex; }
    /* Jedes zweite Jahr genügt, wenn zwölf Spalten auf 320 px müssen. */
    .leiste__jahr:nth-child(even) .leiste__zahl { visibility: hidden; }
  }
  .leiste__zahl {
    font-family: var(--font-mono);
    font-size: var(--dk-schrift-klein);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .leiste__fuss {
    margin: 0;
    font-size: var(--dk-schrift-karte);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
    max-width: var(--dk-measure-body);
  }

  /* ── Das Markensystem ───────────────────────────────────────────────
     Drei Gruppen statt sechs gleicher Kacheln. Die Gruppierung ist die
     Aussage: Eine Marke zieht an, bindet und erlöst. Sechs Kacheln
     nebeneinander zeigen sechs Dinge; drei Gruppen zeigen, wie sie
     zusammenhängen. */
  .system {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--rinne-5);
    margin-top: var(--rinne-6);
  }
  .system__gruppe {
    display: flex;
    flex-direction: column;
    gap: var(--rinne-4);
    padding-top: var(--rinne-3);
    border-top: 2px solid var(--color-accent);
  }
  .system__kopf { display: flex; flex-direction: column; gap: var(--rinne-1); }
  .system__name { margin: 0; }
  .system__zweck {
    margin: 0;
    font-size: var(--dk-schrift-karte);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
  }
  .system__teile {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--rinne-3);
  }
  .system__teil {
    display: flex;
    gap: var(--rinne-3);
    padding: var(--rinne-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  .system__ikon { flex-shrink: 0; color: var(--color-accent); }
  .system__text {
    font-size: var(--dk-schrift-karte);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
  }
  .system__titel {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-text);
  }

  /* ── Die eingebettete Folge ─────────────────────────────────────────
     Der Platzhalter und der Player tauschen die Plätze, sobald die
     Einwilligung vorliegt. Gesteuert über data-einbettungen am
     <html>-Element (siehe Consent.astro) — dasselbe Muster wie beim
     Bewegungsschalter.

     Ausgangszustand ist „Platzhalter sichtbar": Wer ohne Skript liest,
     bekommt die Erklärung und den Link, nicht eine leere Fläche. */
  .folge {
    margin: var(--rinne-6) 0 0;
    padding: var(--rinne-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    max-width: 44rem;
  }
  .folge__kopf { margin-bottom: var(--rinne-4); }
  .folge__reihe {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--dk-schrift-klein);
    letter-spacing: var(--dk-tracking-mono);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--rinne-1);
  }
  .folge__titel { margin: 0; }
  .folge__hinweis {
    margin: 0 0 var(--rinne-4);
    font-size: var(--dk-schrift-karte);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
    max-width: var(--dk-measure-body);
  }
  .folge__wege {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--rinne-4);
  }
  .folge__extern {
    font-size: var(--dk-schrift-karte);
    color: var(--color-primary-light);
  }

  .folge__player { display: none; }
  html[data-einbettungen='erlaubt'] .folge__player { display: block; }
  html[data-einbettungen='erlaubt'] .folge__platzhalter { display: none; }
</style>
