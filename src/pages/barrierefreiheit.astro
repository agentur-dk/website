---
import BaseLayout from '../layouts/BaseLayout.astro';
import DitherBand from '../components/DitherBand.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  slug="barrierefreiheit"
  title="Erklärung zur Barrierefreiheit | agentur dk"
  description="Barrierefreiheitserklärung der agentur dk nach BFSG/BGG: Konformitätsstatus WCAG 2.2 AA, Kontakt für Barrieremeldungen und Durchsetzungsstelle."
  mono
>

  <Header />

  <main id="main-content">

    <DitherBand field="pulse" label="Barrierefreiheit" cell={4} />

    <!-- Page Header -->
    <div class="page-header container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol class="breadcrumb__list">
          <li><a href={`${base}`}>Start</a></li>
          <li><span aria-current="page">Barrierefreiheit</span></li>
        </ol>
      </nav>
      <h1 class="page-header__title">Erklärung zur Barrierefreiheit</h1>
      <p class="page-header__lead">Barrierefreiheitserklärung nach BFSG (Barrierefreiheitsstärkungsgesetz) und WCAG 2.2</p>
    </div>

    <div class="section container container--narrow">

      <!-- Konformitätsstatus -->
      <section aria-labelledby="bf-konformitaet" data-reveal>
        <h2 id="bf-konformitaet">1. Konformitätsstatus</h2>
        <p>
          Die Website <strong>dk-dk.de</strong> (agentur dk – design &amp; kommunikation) ist <strong>weitgehend konform</strong> mit den Anforderungen der
          <abbr title="Web Content Accessibility Guidelines">WCAG</abbr> 2.2 Level AA sowie dem Europäischen Standard
          <abbr title="European Norm">EN</abbr> 301 549 (Accessibility requirements for ICT products and services).
        </p>
        <p>
          Die Konformität wurde durch eine interne Prüfung mit automatisierten Werkzeugen sowie einer manuellen Prüfung
          (Tastaturnavigation, Screenreader-Test) erreicht.
        </p>

        <h3>Nicht barrierefreie Inhalte</h3>
        <p>
          Zum Zeitpunkt dieser Erklärung sind keine bekannten dauerhaften Nicht-Konformitäten vorhanden.
          Neu eingepflegte Inhalte werden fortlaufend geprüft. Solltest Sie eine Barriere feststellen,
          bitten wir Sie, uns über den unten genannten Kontaktweg zu informieren.
        </p>
      </section>

      <!-- Erstellungsdatum -->
      <section aria-labelledby="bf-datum" data-reveal>
        <h2 id="bf-datum">2. Erstellungsdatum und letzte Prüfung</h2>
        <dl>
          <dt>Erstellt am:</dt>
          <dd><time datetime="2026-08-16">16. August 2026</time></dd>
          <dt>Letzte Prüfung:</dt>
          <dd><time datetime="2026-08-16">16. August 2026</time></dd>
        </dl>
        <p>Diese Erklärung wird regelmäßig, mindestens einmal jährlich sowie bei wesentlichen inhaltlichen oder technischen Änderungen der Website aktualisiert.</p>
      </section>

      <!-- Geprüfte Bereiche -->
      <section aria-labelledby="bf-bereiche" data-reveal>
        <h2 id="bf-bereiche">3. Geprüfte Bereiche</h2>
        <p>Die Prüfung umfasste alle zum Zeitpunkt der Erklärung veröffentlichten Seiten:</p>
        <ul>
          <li>Startseite (index.html) – vollständige Prüfung</li>
          <li>Leistungsseite BFSG &amp; WordPress (bfsg-wordpress-website-agentur.html) – vollständige Prüfung</li>
          <li>Referenzen &amp; Projekte (projekte.html) – vollständige Prüfung</li>
          <li>Barrierefreiheitserklärung (barrierefreiheit.html) – vollständige Prüfung</li>
          <li>Impressum (impressum.html) – vollständige Prüfung</li>
          <li>Datenschutzerklärung (datenschutz.html) – vollständige Prüfung</li>
        </ul>

        <h3>Prüfmethodik</h3>
        <ul>
          <li>Automatisierter Scan mit Axe und Lighthouse (WCAG 2.2 AA)</li>
          <li>Manuelle Tastaturnavigation (Tab, Shift+Tab, Enter, Space, Escape, Pfeiltasten)</li>
          <li>Kontrastverhältnisse geprüft anhand der Design-Token-Dokumentation (mind. 4,5:1 für Normal-, 3:1 für Großtext)</li>
          <li>Skip-Link und Landmark-Struktur verifiziert</li>
          <li>Alle Formulare auf Label-Zuordnung und Fehlermeldungen geprüft</li>
        </ul>
      </section>

      <!-- Kontakt / Barrieremeldung -->
      <section aria-labelledby="bf-kontakt" data-reveal>
        <h2 id="bf-kontakt">4. Kontakt bei Barrieren und Feedback</h2>
        <p>
          Wenn Sie Barrieren auf unserer Website feststellen oder Schwierigkeiten beim Zugang zu Inhalten haben,
          bitten wir Sie um eine Rückmeldung. Wir werden Meldungen zeitnah prüfen und – wo technisch und
          wirtschaftlich verhältnismäßig möglich – beheben.
        </p>
        <address>
          <strong>agentur dk – design &amp; kommunikation</strong><br>
          Daniel Kontelis<br>
          Sachsenring 57<br>
          D-50677 Köln<br>
          E-Mail: <a href="mailto:mail@dk-dk.de">mail@dk-dk.de</a><br>
          Telefon: <a href="tel:+4922198655229">+49 221 986 55 229</a><br>
          Reaktionszeit: in der Regel innerhalb von 5 Werktagen
        </address>
      </section>

      <!-- Durchsetzungsstelle -->
      <section aria-labelledby="bf-durchsetzung" data-reveal>
        <h2 id="bf-durchsetzung">5. Durchsetzungsstelle (BFSG / BGG)</h2>
        <p>
          Wenn Sie auf Ihre Rückmeldung keine zufriedenstellende Antwort erhalten haben, können Sie sich an
          die zuständige Durchsetzungsstelle wenden:
        </p>
        <address>
          <strong>Landesbeauftragte für Datenschutz und Informationsfreiheit Nordrhein-Westfalen (LDI NRW)</strong><br>
          Kavalleriestraße 2–4<br>
          40213 Düsseldorf<br>
          <a href="https://www.ldi.nrw.de" target="_blank" rel="noopener noreferrer">
            https://www.ldi.nrw.de<span class="u-sr-only"> (öffnet in neuem Tab)</span>
          </a>
        </address>
        <p>
          Für öffentliche Stellen des Bundes ist die Schlichtungsstelle nach § 16 BGG zuständig:
        </p>
        <address>
          <strong>Schlichtungsstelle nach dem Behindertengleichstellungsgesetz</strong><br>
          beim Beauftragten der Bundesregierung für die Belange von Menschen mit Behinderungen<br>
          Mauerstraße 53<br>
          10117 Berlin<br>
          <a href="https://www.schlichtungsstelle-bgg.de" target="_blank" rel="noopener noreferrer">
            https://www.schlichtungsstelle-bgg.de<span class="u-sr-only"> (öffnet in neuem Tab)</span>
          </a>
        </address>
      </section>

      <!-- Technische Spezifikationen -->
      <section aria-labelledby="bf-technik" data-reveal>
        <h2 id="bf-technik">6. Technische Spezifikationen</h2>
        <p>Die Barrierefreiheit dieser Website beruht auf folgenden Technologien:</p>
        <ul>
          <li>HTML 5 (semantisch strukturiert)</li>
          <li>CSS 3 (Custom Properties, Grid, Flexbox)</li>
          <li>JavaScript (ES2020+, vanilla, keine externen Abhängigkeiten)</li>
          <li>WCAG 2.2 AA (Konformitätsziel)</li>
          <li>EN 301 549 V3.2.1 (Europäischer Standard)</li>
        </ul>
        <p>
          Die Website wurde mit den folgenden Browsern und Hilfstechnologien getestet:
          Chrome 127 / NVDA, Firefox 128 / NVDA (Windows), Safari 17 / VoiceOver (macOS).
        </p>
      </section>

    </div>
  </main>

  <Footer mono />
</BaseLayout>
