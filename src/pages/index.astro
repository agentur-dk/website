---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import LogoStrip from '../components/LogoStrip.astro';
import { faqs } from '../data/faq';
import Icon from '../components/ui/Icon.astro';
import Dither from '../components/ui/Dither.astro';
import { HERO_FIELDS } from '../lib/dither';
import DitherBand from '../components/DitherBand.astro';
import Kernteam from '../components/Kernteam.astro';
import ReferenzKarte from '../components/ReferenzKarte.astro';
import { sichtbareReferenzen, zeigtUnfreigegebenes } from '../data/referenzen';

const base = import.meta.env.BASE_URL;

/** Drei Fälle als Spiegel; alle übrigen stehen auf der Projektseite. */
const referenzenAuswahl = sichtbareReferenzen().filter((r) => r.startseite);

/*
 * `datei` ist zugleich der Schlüssel, über den der Leistungs-Check die
 * passende Zeile findet: Er verweist auf dieselbe Datei (src/lib/quiz.ts).
 */
const leistungen = [
  { datei: 'website-leasing.html', titel: 'Website-Leasing', neu: true,
    text: 'Professionelle Website ohne hohe Einmalkosten: monatliche Flatrate, Wartung und Hosting auf Wunsch inklusive.' },
  { datei: 'bfsg-wordpress-website-agentur.html', titel: 'Barrierefreie Websites (BFSG)',
    text: 'BFSG- und WCAG-konform, von der Prüfung bis zur Konformitätserklärung. Keine rechtlichen Risiken, sondern echte Zugänglichkeit.' },
  { datei: 'wordpress-entwicklung.html', titel: 'WordPress-Entwicklung',
    text: 'Sauberer Code, schnelle Ladezeiten und eine Website, die Ihr Team ohne technisches Vorwissen selbst pflegt.' },
  { datei: 'seo-geo.html', titel: 'SEO & GEO',
    text: 'Suchmaschinenoptimierung und Generative Engine Optimization: gefunden werden bei Google und in Antworten von ChatGPT, Gemini und Co.' },
  { datei: 'online-marketing.html', titel: 'Online-Marketing',
    text: 'Content, Social Media und E-Mail-Kampagnen, die Ihre Zielgruppe dort erreichen, wo sie sich aufhält. Messbar.' },
  { datei: 'corporate-design.html', titel: 'Corporate Design',
    text: 'Logo, Farbwelt und Designsystem für einen Auftritt, der auf allen Kanälen gleich aussieht.' },
  { datei: 'ki-services.html', titel: 'KI-Services',
    text: 'Content-Produktion, Prozessautomatisierung und Telefon-Agenten: KI dort, wo sie messbar entlastet.' },
  { datei: 'social-recruiting.html', titel: 'Social Recruiting',
    text: 'Fachkräfte über LinkedIn, Meta und Co. gezielt ansprechen, statt auf Bewerbungen zu warten.' },
];

/* Quelle: Angabe Daniel Kontelis, 11.10.2026. */
const kennzahlen = [
  { wert: '20+',  label: 'Jahre Erfahrung' },
  { wert: '600+', label: 'Projekte umgesetzt' },
  { wert: '500+', label: 'Kunden betreut' },
];
---

<BaseLayout
  slug=""
  title="Digitalagentur Köln – WordPress, BFSG & SEO | agentur dk"
  description="Digitalagentur aus Köln für barrierefreie WordPress-Websites (BFSG), Website-Leasing, SEO/GEO und Online-Marketing. Kurze Wege, schnelle Entscheidungen."
  mono
>

  <Header />

  <main id="main-content">

    <section class="hero section" aria-labelledby="hero-headline">
      <div class="hero__flaeche" aria-hidden="true"><Dither field="brain" pool={HERO_FIELDS} cell={4} fps={12} /></div>
      <div class="container hero__inner">
        <div class="hero__content">
          {/*
            Die Rubrik trägt das Hauptkeyword, die H1 die Breite des Angebots,
            die Zeile darunter zählt sie zusammen. Dieselbe Phrase mehrfach
            bringt in der Suche nichts; eine zweite, andere Aussage schon.
          */}
          <p class="section-label">Digitalagentur aus Köln</p>
          <h1 id="hero-headline" class="hero__headline">Websites, Online-Marketing und KI-Lösungen</h1>
          <p class="hero__subline">Drei Bausteine, ein Ansprechpartner.</p>
          <div class="hero__actions">
            <a href="#contact" class="btn btn--accent btn--lg">Projekt anfragen</a>
          </div>

          <div class="leistungs-check" data-quiz data-base={base} role="region" aria-label="Leistungs-Check">
            <div class="quiz-widget__live u-sr-only" aria-live="polite" aria-atomic="true"></div>
            <div data-quiz-inner></div>
            {/* Vorlage für den Zurück-Pfeil: hält das Icon im Markup statt im Skript. */}
            <template data-quiz-icon="arrow-left"><Icon name="arrow-left" size={16} /></template>
          </div>
        </div>
      </div>
    </section>

    <LogoStrip />

    <section class="schwerpunkte-section section section--hell" aria-labelledby="schwerpunkte-heading">
      <div class="container">
        <h2 class="schwerpunkte-section__heading" id="schwerpunkte-heading">Gebaut, gefunden, entlastet</h2>
        <p class="schwerpunkte-section__lead">Die Website ist der Anfang, nicht das Ziel. Damit aus ihr Anfragen werden, muss sie gefunden werden, und was danach kommt, darf nicht an Ihrem Schreibtisch hängen bleiben.</p>
        <div class="schwerpunkte-grid">
          <article class="schwerpunkt-card" data-reveal>
            <div class="card-head" aria-hidden="true">
              <Dither field="pulse" cell={3} class="card-head__flaeche" />
            </div>
            <div class="schwerpunkt-card__icon" aria-hidden="true">
              <Icon name="briefcase-business" size={48} strokeWidth={1.5} />
            </div>
            <h3 class="schwerpunkt-card__title">Website-Leasing &amp; digitale Sichtbarkeit</h3>
            <p class="schwerpunkt-card__text">Monatliche Flatrate statt hoher Einmalkosten: Konzeption, Design, Umsetzung, Wartung und laufende Optimierung aus einer Hand, planbar und langfristig sicher.</p>
            <a href={`${base}website-leasing.html`} class="btn btn--outline schwerpunkt-card__link">Mehr zum Website-Leasing</a>
          </article>
          <article class="schwerpunkt-card" data-reveal>
            <div class="card-head" aria-hidden="true">
              <Dither field="drift" cell={3} class="card-head__flaeche" />
            </div>
            <div class="schwerpunkt-card__icon" aria-hidden="true">
              <Icon name="accessibility" size={48} strokeWidth={1.5} />
            </div>
            <h3 class="schwerpunkt-card__title">Gefunden werden, in Suche und KI</h3>
            <p class="schwerpunkt-card__text">Wer Sie sucht, soll Sie finden: bei Google und inzwischen auch dort, wo Antworten stehen statt Trefferlisten. Dazu gehört, dass die Seite technisch sauber gebaut ist: barrierefrei nach BFSG, schnell, verständlich für Mensch und Maschine.</p>
            <a href={`${base}bfsg-wordpress-website-agentur.html#bfsg-check`} class="btn btn--outline schwerpunkt-card__link">BFSG-Check starten</a>
          </article>
          {/* Karte C: Die H1 verspricht drei Bausteine. */}
          <article class="schwerpunkt-card" data-reveal>
            <div class="card-head" aria-hidden="true">
              <Dither field="brain" cell={3} class="card-head__flaeche" />
            </div>
            <div class="schwerpunkt-card__icon" aria-hidden="true">
              <Icon name="cpu" size={48} strokeWidth={1.5} />
            </div>
            <h3 class="schwerpunkt-card__title">KI, die Arbeit abnimmt</h3>
            <p class="schwerpunkt-card__text">Ein Assistent, der ans Telefon geht, wenn Sie am Patienten, im Termin oder auf der Baustelle sind. Terminbuchung ohne Rückruf. KI dort, wo sie messbar entlastet, nicht, weil sie gerade alle einbauen.</p>
            <a href={`${base}ki-services.html`} class="btn btn--outline schwerpunkt-card__link">Mehr zu KI-Services</a>
          </article>
        </div>
      </div>
    </section>

    {/*
      Die Referenzen stehen direkt hinter den Bausteinen: Wer gerade gelesen
      hat, was wir tun, fragt als Nächstes, für wen. Drei Fälle genügen als
      Spiegel; die übrigen stehen unter „Projekte".
    */}
    <section class="referenzen-section section section--hell" aria-labelledby="referenzen-heading">
      <div class="container">
        <h2 class="schwerpunkte-section__heading" id="referenzen-heading">Betriebe wie Ihrer</h2>
        <p class="schwerpunkte-section__lead">Praxis, Kanzlei, Verwaltung, Selbstständige. Die großen Namen stehen oben in der Leiste, hier stehen die Projekte, in denen Sie sich wiederfinden.</p>
        {zeigtUnfreigegebenes() && (
          <p class="referenzen__warnung" role="note">
            <strong>Nur in der Vorschau sichtbar:</strong> Einzelne Fälle sind noch nicht vom
            Kunden freigegeben. Sobald die Indexierungssperre fällt, erscheinen ausschließlich
            freigegebene Referenzen, ohne dass jemand daran denken muss.
          </p>
        )}
        <div class="case-grid">
          {referenzenAuswahl.map((r) => <ReferenzKarte r={r} />)}
        </div>
        <div class="referenzen-section__cta">
          <a href={`${base}projekte.html`} class="btn btn--outline">Alle Projekte ansehen</a>
          <a href={`${base}marken.html`} class="btn btn--outline">Unsere eigenen Marken</a>
        </div>
      </div>
    </section>

    <DitherBand field="drift" label="Kurze Wege" />

    <Kernteam />

    {/*
      Ein Verzeichnis statt eines vierten Kartenrasters: Wer hier ankommt,
      sucht eine bestimmte Leistung und will sie finden, nicht durchblättern.
      `data-leistung` ist die Datei, auf die der Leistungs-Check verweist;
      daran markiert er die passende Zeile (Skript unten).
    */}
    <section id="services" class="services section section--hell" aria-labelledby="leistungen-heading">
      <div class="container">
        <h2 class="section-title" id="leistungen-heading">Alle Leistungen im Überblick</h2>
        <ul class="leistungsindex" role="list">
          {leistungen.map((l) => (
            <li class="leistungsindex__zeile" data-leistung={l.datei} data-reveal>
              <h3 class="leistungsindex__titel">
                <a href={`${base}${l.datei}`} class="leistungsindex__link">{l.titel}</a>
                {l.neu && <span class="leistungsindex__neu">Neu</span>}
              </h3>
              <p class="leistungsindex__text">{l.text}</p>
              <p class="leistungsindex__marke" hidden>Passt zu Ihrer Antwort im Leistungs-Check</p>
              <Icon name="arrow-right" size={20} class="leistungsindex__pfeil" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="process section section--hell" aria-labelledby="vorgehen-heading">
      <div class="container">
        <h2 class="section-title" id="vorgehen-heading">So arbeiten wir zusammen</h2>
        <ol class="process__list" role="list">
          <li class="process__item" data-reveal>
            <div class="process__step-number" aria-hidden="true">1</div>
            <div class="process__step-content">
              <h3 class="process__step-title">Kennenlernen</h3>
              <p class="process__step-body">Kostenloses Erstgespräch, Analyse Ihrer Ziele und Ihrer aktuellen Situation. Wir hören zu, bevor wir handeln.</p>
            </div>
          </li>
          <li class="process__item" data-reveal>
            <div class="process__step-number" aria-hidden="true">2</div>
            <div class="process__step-content">
              <h3 class="process__step-title">Konzept</h3>
              <p class="process__step-body">Strategie und Maßnahmenplan, abgestimmt auf Ihre Ziele und Ihr Budget. Transparent, verständlich, verbindlich.</p>
            </div>
          </li>
          <li class="process__item" data-reveal>
            <div class="process__step-number" aria-hidden="true">3</div>
            <div class="process__step-content">
              <h3 class="process__step-title">Umsetzung</h3>
              <p class="process__step-body">Saubere, barrierefreie Entwicklung nach aktuellen Standards. Regelmäßige Updates halten Sie auf dem Laufenden.</p>
            </div>
          </li>
          <li class="process__item" data-reveal>
            <div class="process__step-number" aria-hidden="true">4</div>
            <div class="process__step-content">
              <h3 class="process__step-title">Wachstum</h3>
              <p class="process__step-body">Laufende Optimierung und Support. Wir messen, analysieren und verbessern, damit Ihre Website dauerhaft erfolgreich bleibt.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section id="faq" class="faq section section--hell" aria-labelledby="faq-heading">
      <div class="container">
        <h2 class="section-title" id="faq-heading">Häufige Fragen</h2>
        <div class="accordion">
          {(faqs['']?.items ?? []).map((item, i) => (
            <div class="accordion__item">
              <h3 class="accordion__heading">
                <button type="button" class="accordion__trigger" id={`faq-trigger-${i + 1}`} aria-expanded="false" aria-controls={`faq-panel-${i + 1}`}>
                  <span>{item.question}</span>
                  <Icon name="plus" size={20} class="accordion__icon" />
                </button>
              </h3>
              <div id={`faq-panel-${i + 1}`} class="accordion__panel" role="region" aria-labelledby={`faq-trigger-${i + 1}`} hidden>
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/*
      Der letzte Abschnitt ist das Ende, nicht ein weiterer Abschnitt: Danach
      kommt nur die Fußzeile. Die Kennzahlen stehen hier und nicht in einer
      eigenen Leiste, weil sie an dieser Stelle eine Entscheidung stützen.
    */}
    <section id="kontakt" class="contact section section--blau" aria-labelledby="kontakt-heading">
      <div class="container contact__inner">
        <div class="contact__info">
          <h2 class="section-title" id="kontakt-heading">Projekt anfragen</h2>
          <p class="contact__vorspann">
            Ein Gespräch kostet nichts außer einer halben Stunde. Erzählen Sie,
            was ansteht, und wir sagen Ihnen, ob und wie wir helfen können.
          </p>
          <dl class="contact__zahlen">
            {kennzahlen.map((k) => (
              <div class="contact__zahl" style={`--sc-ziel: ${parseInt(k.wert, 10)}`}>
                <dt>{k.label}</dt>
                <dd><span class="contact__zahl-wert">{k.wert}</span></dd>
              </div>
            ))}
          </dl>
          <address class="contact__address">
            <p>
              agentur dk – design &amp; kommunikation<br>
              Daniel Kontelis<br>
              Sachsenring 57<br>
              D-50677 Köln
            </p>
            <p>
              <a href="tel:+4922198655229" class="contact__link">
                <Icon name="phone" size={16} />
                +49 221 986 55 229
              </a>
              <span class="contact__zeit">Mo–Fr 9–18 Uhr</span>
            </p>
            <p>
              <a href="mailto:mail@dk-dk.de" class="contact__link">
                <Icon name="mail" size={16} />
                mail@dk-dk.de
              </a>
            </p>
            <p>
              <a href="https://www.linkedin.com/in/daniel-kontelis/" class="contact__link" rel="noopener noreferrer" target="_blank">
                <Icon name="linkedin" size={16} />
                LinkedIn<span class="u-sr-only"> (öffnet in neuem Tab)</span>
              </a>
            </p>
          </address>
        </div>

        <div class="contact__form-wrapper">
          <LeadForm page="Startseite" heading="Ihre Anfrage in drei Schritten" />
        </div>
      </div>
    </section>

  </main>

  <Footer mono />


  <style is:global>
    .referenzen-section__cta{display:flex;flex-wrap:wrap;justify-content:center;gap:var(--rinne-3);margin-top:var(--spacing-10)}

    /* Leistungsverzeichnis: eine Zeile je Leistung, die ganze Zeile ist
       Klickfläche. Der Link dehnt sich per ::after über die Zeile, damit
       es trotzdem genau ein Linkziel mit sprechendem Namen bleibt. */
    .leistungsindex{list-style:none;margin:0;padding:0;border-top:1px solid var(--color-border)}
    .leistungsindex__zeile{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:var(--rinne-5);row-gap:var(--rinne-1);padding-block:var(--rinne-4);border-bottom:1px solid var(--color-border)}
    @media (min-width:900px){
      .leistungsindex__zeile{grid-template-columns:minmax(14rem,2fr) minmax(0,3fr) auto;align-items:baseline}
    }
    .leistungsindex__titel{margin:0;font-size:var(--dk-schrift-vorspann);line-height:1.25}
    .leistungsindex__link{color:var(--color-text);text-decoration:none}
    .leistungsindex__link::after{content:"";position:absolute;inset:0}
    .leistungsindex__link:focus-visible{outline:none}
    .leistungsindex__link:focus-visible::after{outline:3px solid var(--color-focus);outline-offset:2px}
    .leistungsindex__zeile:hover .leistungsindex__link{text-decoration:underline;text-underline-offset:.2em}
    .leistungsindex__neu{display:inline-block;margin-left:var(--rinne-2);padding:.1em .5em;border:1px solid currentColor;font-size:var(--dk-schrift-klein);letter-spacing:.06em;text-transform:uppercase;vertical-align:middle}
    .leistungsindex__text{margin:0;color:var(--color-text-muted);font-size:var(--dk-schrift-karte);max-width:60ch;grid-column:1}
    @media (min-width:900px){ .leistungsindex__text{grid-column:2} }
    .leistungsindex__pfeil{grid-column:-2;grid-row:1;align-self:center;color:var(--color-text);transition:transform .2s ease}
    .leistungsindex__zeile:hover .leistungsindex__pfeil{transform:translateX(4px)}
    .leistungsindex__marke{margin:0;grid-column:1/-1;font-size:var(--dk-schrift-klein);font-weight:700;letter-spacing:.06em;text-transform:uppercase}

    /* Vom Leistungs-Check markiert: Balken links plus Textzeile, damit
       die Markierung nicht nur an einer Farbe hängt. */
    .leistungsindex__zeile[data-empfohlen]{box-shadow:inset 4px 0 0 var(--color-text);padding-left:var(--rinne-4)}
    @media (prefers-reduced-motion:no-preference){
      .leistungsindex__zeile{transition:box-shadow .3s ease,padding-left .3s ease}
    }
    @media (prefers-reduced-motion:reduce){
      .leistungsindex__pfeil{transition:none}
      .leistungsindex__zeile:hover .leistungsindex__pfeil{transform:none}
    }

    .contact__vorspann{margin:0 0 var(--rinne-4);font-size:var(--dk-schrift-text);color:var(--color-text);max-width:38ch}
    .contact__zahlen{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--rinne-3);margin:0 0 var(--rinne-5);padding-block:var(--rinne-4);border-block:1px solid var(--color-border)}
    /* Im Markup erst die Bezeichnung, dann der Wert, damit ein Screenreader
       „Jahre Erfahrung: 20+" liest; sichtbar steht die Zahl oben. */
    .contact__zahl{display:grid;grid-template-rows:auto 1fr;gap:var(--rinne-1)}
    .contact__zahl dd{order:1}
    .contact__zahl dt{order:2;font-size:var(--dk-schrift-klein);color:var(--color-text-muted);line-height:1.3}
    .contact__zahl dd{margin:0;font-family:var(--font-display);font-size:var(--dk-schrift-titel-3);line-height:1;color:var(--color-text)}
    .contact__zeit{display:block;font-size:var(--dk-schrift-klein);color:var(--color-text-muted);padding-left:calc(16px + var(--rinne-1))}

    /* ============================================================
       Bewegung beim Scrollen (Dramaturgie: docs/startseite-brief.md).
       Reines CSS über Scroll-Zeitleisten, kein Skript: Ohne Unterstützung
       steht die Seite einfach still da. Animiert werden nur Lage und
       Ausschnitt, nie die Deckkraft, damit Text in jeder Scrollposition
       seinen vollen Kontrast hat. Aus bei „Bewegung reduzieren" und beim
       Pausenknopf in der Fußzeile.

       Zeitleiste und Bereich stehen jeweils in einer zweiten Regel mit
       verdoppelter Klasse: Der Verdichter zöge sie sonst in die
       Kurzschreibweise `animation`, die Chrome dort nicht annimmt.
       ============================================================ */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        /* Kopf: zwei Ebenen, die sich trennen. Die Kugel bleibt zurück,
           während der Satz normal wegscrollt. Der Satz selbst bewegt sich
           nicht schneller: Er geriete sonst unter die Kopfleiste, wenn
           jemand per Tastatur hineinspringt (WCAG 2.4.11). */
        html:not([data-motion="paused"]) .hero__flaeche { animation: sc-kugel linear both; }
        html:not([data-motion="paused"]) .hero__flaeche.hero__flaeche {
          animation-timeline: scroll(root);
          animation-range: 0 100svh;
        }

        /* Referenzen: Das Raster wird aufgedeckt wie ein Abzug. */
        html:not([data-motion="paused"]) .case-card__visual--dither { animation: sc-aufdecken linear both; }
        html:not([data-motion="paused"]) .case-card__visual--dither.case-card__visual--dither {
          animation-timeline: view();
          animation-range: entry 10% cover 35%;
        }

        /* Verzeichnis: Die Trennlinie zieht sich unter jede Zeile. */
        html:not([data-motion="paused"]) .leistungsindex__zeile {
          border-bottom-color: transparent;
          background: linear-gradient(var(--color-border-strong), var(--color-border-strong)) left bottom / 0% 1px no-repeat;
          animation: sc-linie linear both;
        }
        html:not([data-motion="paused"]) .leistungsindex__zeile.leistungsindex__zeile {
          animation-timeline: view();
          animation-range: entry 30% cover 40%;
        }

        /* Am Ende zählen die Zahlen bis zu ihrem Wert. Der Wert selbst
           bleibt als Text für Screenreader stehen; die gezählte Fassung
           ist mit `/ ""` für sie stumm. */
        html:not([data-motion="paused"]) .contact__zahl-wert {
          position: absolute; width: 1px; height: 1px; overflow: hidden;
          clip-path: inset(50%); white-space: nowrap;
        }
        html:not([data-motion="paused"]) .contact__zahl dd::before {
          counter-reset: sc-zahl var(--sc-zahl);
          content: counter(sc-zahl) "+" / "";
          animation: sc-zaehlen linear both;
        }
        html:not([data-motion="paused"]) .contact__zahl.contact__zahl dd::before {
          animation-timeline: view();
          animation-range: entry 40% cover 45%;
        }
      }
    }
    @property --sc-zahl { syntax: "<integer>"; inherits: false; initial-value: 0; }
    @keyframes sc-kugel    { to { transform: translateY(30svh) scale(1.12); } }
    @keyframes sc-aufdecken{ from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
    @keyframes sc-linie    { to { background-size: 100% 1px; } }
    @keyframes sc-zaehlen  { from { --sc-zahl: 0; } to { --sc-zahl: var(--sc-ziel); } }
  </style>

  <script>
  import { SERVICES as QUIZ_SERVICES, STEP1_OPTIONS, getStep2Config, hasStep2 } from '../lib/quiz';

  (function initLeistungsCheck() {
    'use strict';

    const widget = document.querySelector('[data-quiz]');
    if (!widget) return;

    const BASE = (widget as HTMLElement).dataset.base ?? '/website/';
    const inner      = widget.querySelector('[data-quiz-inner]');
    const liveRegion = widget.querySelector('.quiz-widget__live');

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const SERVICES = Object.fromEntries(
      Object.entries(QUIZ_SERVICES).map(([k, v]) => [k, { ...v, href: BASE + v.href }])
    );

    let selectedTopic: string | null = null;
    let selectedDetailLabel: string | null = null;

    function announce(msg: string) {
      if (!liveRegion) return;
      liveRegion.textContent = '';
      requestAnimationFrame(function () { liveRegion.textContent = msg; });
    }

    function track(obj: Record<string, string>) {
      if ((window as any).dataLayer) (window as any).dataLayer.push(obj);
    }

    function focusFirst(container: Element) {
      const el = container.querySelector('button') as HTMLButtonElement | null;
      if (el) el.focus({ preventScroll: true });
    }

    function makeOptionBtn(label: string, compact: boolean, onSelect: () => void) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = compact ? 'lc-option lc-option--compact' : 'lc-option';
      btn.setAttribute('aria-pressed', 'false');
      btn.textContent = label;
      btn.addEventListener('click', function () { onSelect(); });
      return btn;
    }

    function backArrowNode(): Node | null {
      const tpl = document.querySelector('template[data-quiz-icon="arrow-left"]');
      return tpl instanceof HTMLTemplateElement ? tpl.content.cloneNode(true) : null;
    }

    /*
     * Die Antwort oben ändert die Seite darunter: Die passende Zeile im
     * Leistungsverzeichnis wird markiert, mit Balken und einer Textzeile.
     * Verschoben wird nichts; die Reihenfolge bleibt, wie man sie gelesen
     * hat, und ohne Skript fehlt nur die Markierung.
     */
    function markiereLeistung(datei: string | null) {
      document.querySelectorAll<HTMLElement>('[data-leistung]').forEach(function (zeile) {
        const treffer = datei !== null && zeile.dataset.leistung === datei;
        zeile.toggleAttribute('data-empfohlen', treffer);
        const marke = zeile.querySelector<HTMLElement>('.leistungsindex__marke');
        if (marke) marke.hidden = !treffer;
      });
    }

    function renderStep1(fromRestart: boolean) {
      markiereLeistung(null);
      selectedTopic = null;
      selectedDetailLabel = null;
      delete (widget as HTMLElement).dataset.quizTopic;
      delete (widget as HTMLElement).dataset.quizDetail;
      if (inner) inner.innerHTML = '';

      const step = document.createElement('div');
      step.className = 'lc-step';

      const question = document.createElement('p');
      question.className = 'lc-question';
      question.textContent = 'Was möchten Sie erreichen?';
      step.appendChild(question);

      const fieldset = document.createElement('fieldset');
      fieldset.className = 'lc-fieldset';

      const legend = document.createElement('legend');
      legend.className = 'u-sr-only';
      legend.textContent = 'Was möchten Sie erreichen?';
      fieldset.appendChild(legend);

      const grid = document.createElement('div');
      grid.className = 'lc-grid';
      fieldset.appendChild(grid);

      STEP1_OPTIONS.forEach(function (opt) {
        grid.appendChild(makeOptionBtn(opt.label, false, function () {
          selectedTopic = opt.key;
          (widget as HTMLElement).dataset.quizTopic = opt.key;
          track({ event: 'quiz_answer', question: 'need', answer: opt.key });
          announce('Gewählt: ' + opt.label);
          if (hasStep2(opt.key)) {
            renderStep2(opt.key, opt.label);
          } else {
            renderResult();
          }
        }));
      });

      step.appendChild(fieldset);
      if (inner) inner.appendChild(step);

      if (fromRestart) {
        focusFirst(step);
        announce('Leistungs-Check neu gestartet. Schritt 1: Was möchten Sie erreichen?');
      }
    }

    function renderStep2(topicKey: string, topicLabel: string) {
      if (inner) inner.innerHTML = '';
      const cfg = getStep2Config(topicKey);
      if (!cfg) return;

      announce('Schritt 2: ' + cfg.question);

      const step = document.createElement('div');
      step.className = 'lc-step';

      const backBtn = document.createElement('button');
      backBtn.type = 'button';
      backBtn.className = 'lc-back';
      const pfeil = backArrowNode();
      if (pfeil) backBtn.appendChild(pfeil);
      backBtn.appendChild(document.createTextNode(' Zurück'));
      backBtn.addEventListener('click', function () { renderStep1(true); });
      step.appendChild(backBtn);

      const breadcrumb = document.createElement('p');
      breadcrumb.className = 'lc-breadcrumb';
      breadcrumb.setAttribute('aria-hidden', 'true');
      breadcrumb.textContent = topicLabel + ' \u2192';
      step.appendChild(breadcrumb);

      const question = document.createElement('p');
      question.className = 'lc-question';
      question.textContent = cfg.question;
      step.appendChild(question);

      const fieldset = document.createElement('fieldset');
      fieldset.className = 'lc-fieldset';

      const legend = document.createElement('legend');
      legend.className = 'u-sr-only';
      legend.textContent = cfg.question;
      fieldset.appendChild(legend);

      const grid = document.createElement('div');
      grid.className = 'lc-grid lc-grid--compact';
      fieldset.appendChild(grid);

      cfg.options.forEach(function (opt) {
        grid.appendChild(makeOptionBtn(opt.label, true, function () {
          selectedDetailLabel = opt.label;
          (widget as HTMLElement).dataset.quizDetail = opt.key;
          track({ event: 'quiz_answer', question: 'detail', answer: opt.key });
          announce('Gewählt: ' + opt.label + '. Lade Empfehlung …');
          renderResult();
        }));
      });

      step.appendChild(fieldset);
      if (inner) inner.appendChild(step);
      focusFirst(step);
    }

    function renderResult() {
      if (inner) inner.innerHTML = '';
      if (!selectedTopic) return;
      /* `selectedTopic` stammt aus derselben Tabelle wie SERVICES — der Typ
         kennt diesen Zusammenhang nicht. Ohne Treffer wird nichts gezeigt,
         statt mit `undefined` weiterzurechnen. */
      const service = SERVICES[selectedTopic];
      if (!service) return;
      const roh = QUIZ_SERVICES[selectedTopic];
      markiereLeistung(roh ? roh.href : null);
      announce('Unsere Empfehlung: ' + service.title + '. In der Leistungsübersicht weiter unten ist sie markiert.');
      track({ event: 'quiz_complete', topic: selectedTopic });

      const result = document.createElement('div');
      result.className = 'lc-result';

      const tag = document.createElement('span');
      tag.className = 'lc-result__tag';
      tag.setAttribute('aria-hidden', 'true');
      tag.textContent = 'Unsere Empfehlung';
      result.appendChild(tag);

      const title = document.createElement('p');
      title.className = 'lc-result__title';
      title.setAttribute('tabindex', '-1');
      title.textContent = service.title;
      result.appendChild(title);

      const blurb = document.createElement('p');
      blurb.className = 'lc-result__blurb';
      blurb.textContent = service.blurb;
      result.appendChild(blurb);

      const actions = document.createElement('div');
      actions.className = 'lc-result__actions';

      const ctaBtn = document.createElement('button');
      ctaBtn.type = 'button';
      ctaBtn.className = 'btn btn--accent';
      ctaBtn.textContent = 'Anfrage stellen';
      ctaBtn.addEventListener('click', function () { transferToForm(service); });
      actions.appendChild(ctaBtn);

      const learnLink = document.createElement('a');
      learnLink.href = service.href;
      learnLink.className = 'btn btn--outline';
      learnLink.textContent = 'Mehr erfahren';
      actions.appendChild(learnLink);

      result.appendChild(actions);

      const restartBtn = document.createElement('button');
      restartBtn.type = 'button';
      restartBtn.className = 'lc-restart';
      restartBtn.textContent = '\u21BA Neu starten';
      restartBtn.addEventListener('click', function () { renderStep1(true); });
      result.appendChild(restartBtn);

      if (inner) inner.appendChild(result);
      title.focus({ preventScroll: true });
    }

    function transferToForm(service: { formValue: string; title: string }) {
      const checkbox = document.querySelector(
        'input[name="interesse[]"][value="' + service.formValue + '"]'
      ) as HTMLInputElement | null;
      if (checkbox) {
        checkbox.checked = true;
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      }

      const step1Option = STEP1_OPTIONS.find(function (o) { return o.key === selectedTopic; });
      const topicLabel = step1Option ? step1Option.label : service.title;
      const note = selectedDetailLabel
        ? 'Anfrage \u00FCber den Leistungs-Check: ' + topicLabel + ' \u2192 ' + selectedDetailLabel
        : 'Anfrage \u00FCber den Leistungs-Check: ' + topicLabel;

      const msgField = document.querySelector('#lf-message') as HTMLTextAreaElement | null;
      if (msgField && !msgField.value) {
        msgField.value = note;
      }

      const contactSection = document.querySelector('#contact');
      if (contactSection) {
        contactSection.scrollIntoView({
          behavior: prefersReduced ? 'auto' : 'smooth',
          block: 'start',
        });
      }

      if (checkbox) {
        setTimeout(function () {
          checkbox.focus({ preventScroll: true });
        }, prefersReduced ? 0 : 600);
      }

      track({ event: 'quiz_cta_click', topic: selectedTopic ?? '' });
    }

    renderStep1(false);
  })();
  </script>

</BaseLayout>
