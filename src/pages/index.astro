---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import StatsStrip from '../components/StatsStrip.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="agentur dk – Websites, Website-Leasing & Digital-Agentur Köln"
  description="Ihre Agentur in Köln für professionelle WordPress-Websites, Website-Leasing, barrierefreies Webdesign (BFSG), SEO/GEO und Online-Marketing. Persönlich, schnell, professionell."
>
  <Fragment slot="head">
    <!-- JSON-LD: Organization + LocalBusiness -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Organization", "ProfessionalService"],
  "@id": "https://dk-dk.de/#organization",
  "name": "agentur dk \u2013 design & kommunikation",
  "url": "https://dk-dk.de",
  "logo": "https://dk-dk.de/images/og-image-website.png",
  "image": "https://dk-dk.de/images/og-image-website.png",
  "description": "Agentur f\u00fcr barrierefreie WordPress-Websites (BFSG), SEO, GEO und Online-Marketing in K\u00f6ln.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Sachsenring 57",
    "addressLocality": "K\u00f6ln",
    "postalCode": "50677",
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 50.9286,
    "longitude": 6.9604
  },
  "telephone": "+49-221-986-55-229",
  "email": "mail@dk-dk.de",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "09:00",
    "closes": "18:00"
  },
  "sameAs": ["https://www.linkedin.com/in/daniel-kontelis/"],
  "founder": { "@type": "Person", "name": "Daniel Kontelis" }
}
    </script>

    <!-- JSON-LD: FAQPage -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was ist Website-Leasing und f\u00fcr wen lohnt es sich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Beim Website-Leasing erhalten Sie eine professionell entwickelte WordPress-Website gegen eine feste monatliche Rate \u2014 ohne hohe Einmalinvestition. Das Modell eignet sich besonders f\u00fcr Unternehmen, die schnell einen hochwertigen Webauftritt ben\u00f6tigen, aber keine gro\u00dfe Anfangsinvestition t\u00e4tigen m\u00f6chten. Wartung und Hosting sind auf Wunsch inklusive."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet eine professionelle WordPress-Website?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Je nach Umfang und bestehendem System beginnen WordPress-Projekte bei ca. 2.500 \u20ac. Alternativ bieten wir Website-Leasing ab einer monatlichen Rate an \u2014 ohne Einmalkosten. F\u00fcr gr\u00f6\u00dfere Relaunches kalkulieren wir individuell und erstellen ein transparentes Festpreisangebot."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert ein WordPress-Relaunch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Typische Projekte dauern 4\u20138 Wochen \u2013 abh\u00e4ngig von Seitenanzahl, Funktionsumfang und der Verf\u00fcgbarkeit von Inhalten. Dank flacher Hierarchien und direkter Kommunikation halten wir Zeitpl\u00e4ne zuverl\u00e4ssig ein."
      }
    },
    {
      "@type": "Question",
      "name": "Bieten Sie auch laufende Betreuung an?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, wir bieten flexible Wartungs- und Support-Pakete an: von monatlichen Updates und Sicherheits-Patches bis hin zu laufendem SEO und Content-Pflege. So bleibt Ihre Website dauerhaft performant, sicher und BFSG-konform."
      }
    },
    {
      "@type": "Question",
      "name": "Was ist GEO (Generative Engine Optimization)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GEO bezeichnet die Optimierung von Inhalten f\u00fcr KI-Systeme wie ChatGPT, Google Gemini oder Perplexity, damit Ihr Unternehmen in KI-generierten Antworten sichtbar wird. Dies erg\u00e4nzt klassisches SEO und sichert Ihnen Reichweite im Zeitalter der generativen Suche."
      }
    },
    {
      "@type": "Question",
      "name": "Was ist das BFSG und gilt es f\u00fcr uns?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Das BFSG (Barrierefreiheitsst\u00e4rkungsgesetz) verpflichtet ab dem 28. Juni 2025 Anbieter privater Websites und digitaler Produkte zur Barrierefreiheit gem\u00e4\u00df EN 301 549. Es gilt f\u00fcr Unternehmen mit mehr als 10 Mitarbeitenden oder einem Jahresumsatz \u00fcber 2 Mio. \u20ac, die Verbrauchern digitale Dienstleistungen anbieten. Wir pr\u00fcfen kostenlos, ob Ihre Website betroffen ist."
      }
    },
    {
      "@type": "Question",
      "name": "K\u00f6nnen Sie auch bestehende Websites pr\u00fcfen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, wir f\u00fchren Accessibility-Audits durch und pr\u00fcfen Ihre bestehende Website auf BFSG-Konformit\u00e4t, technische SEO-Fehler und Conversion-Potenziale. Sie erhalten einen priorisierten Ma\u00dfnahmenplan mit konkreten Handlungsempfehlungen."
      }
    }
  ]
}
    </script>

    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": "https://dk-dk.de",
  "name": "agentur dk",
  "inLanguage": "de-DE"
}
    </script>
  </Fragment>

  <Header />

  <main id="main-content">

    <!-- Hero Section -->
    <section class="hero section" aria-label="Online-Agentur Köln">
      <div class="container hero__inner">
        <div class="hero__content">
          <h1 class="hero__headline" aria-label="Sichtbarkeit, die wirkt. Barrierefreiheit, die überzeugt.">
            <span id="typewriter-text" data-texts='["Sichtbarkeit, die wirkt.", "Barrierefreiheit, die überzeugt.", "WordPress, das performt.", "Marketing, das konvertiert."]'>Sichtbarkeit, die wirkt.</span><span class="typewriter-caret" aria-hidden="true"></span>
          </h1>
          <p class="hero__subline">
            agentur dk macht Ihr Unternehmen digital sichtbar — mit Website-Leasing, professioneller WordPress-Entwicklung (barrierefrei nach BFSG), strategischem SEO/GEO und zielgruppengenauem Online-Marketing.
          </p>
          <div class="hero__actions">
            <a href="#contact" class="btn btn--accent btn--lg">Projekt anfragen</a>
