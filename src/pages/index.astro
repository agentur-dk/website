---
import '../styles/mono.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaSection from '../components/CtaSection.astro';
import LeadForm from '../components/LeadForm.astro';
import StatsStrip from '../components/StatsStrip.astro';
import LogoStrip from '../components/LogoStrip.astro';
import { faqs } from '../data/faq';
import Icon from '../components/ui/Icon.astro';
import Dither from '../components/ui/Dither.astro';
import DitherBand from '../components/DitherBand.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  slug=""
  title="Digitalagentur Köln – WordPress, BFSG & SEO | agentur dk"
  description="Digitalagentur aus Köln für barrierefreie WordPress-Websites (BFSG), Website-Leasing, SEO/GEO und Online-Marketing. Direkt beim Inhaber."
  mono
>

  <Header />

  <main id="main-content">

    <!-- Hero Section -->
    <section class="hero section" aria-label="Online-Agentur Köln">
      <div class="hero__flaeche" aria-hidden="true"><Dither field="sphere" cell={4} fps={12} /></div>
      <div class="container hero__inner">
        <div class="hero__content">
          <p class="section-label" aria-hidden="true">Digitalagentur Köln</p>
          <h1 class="hero__headline">Digitalagentur aus Köln für barrierefreie WordPress-Websites,<span class="hero__headline-soft"> die im Alltag tragen.</span></h1>
          <p class="hero__claim" aria-hidden="true">
            <span id="typewriter-text" data-texts='["Sichtbarkeit, die wirkt.", "Barrierefreiheit, die überzeugt.", "WordPress, das performt.", "Marketing, das konvertiert."]'>Sichtbarkeit, die wirkt.</span><span class="typewriter-caret"></span>
          </p>
          <p class="hero__subline">
            agentur dk macht Ihr Unternehmen digital sichtbar — mit Website-Leasing, professioneller WordPress-Entwicklung (barrierefrei nach BFSG), strategischem SEO/GEO und zielgruppengenauem Online-Marketing.
          </p>
          <div class="hero__actions">
            <a href="#contact" class="btn btn--accent btn--lg">Projekt anfragen</a>
          </div>

          <!-- Leistungs-Check -->
          <div class="leistungs-check" data-quiz data-base={base} role="region" aria-label="Leistungs-Check">
            <div class="quiz-widget__live u-sr-only" aria-live="polite" aria-atomic="true"></div>
            <div data-quiz-inner></div>
            <!-- Vorlage für den Zurück-Pfeil: hält das Icon im Markup statt im Skript. -->
            <template data-quiz-icon="arrow-left"><Icon name="arrow-left" size={16} /></template>
          </div>
        </div>
      </div>
    </section>

    <DitherBand field="wave" label="Kunden" />

    <!-- Kundenlogo-Leiste -->
    <LogoStrip />

    <!-- Unsere Schwerpunkte -->
    <section class="schwerpunkte-section section" aria-labelledby="schwerpunkte-heading">
      <div class="container">
        <p class="schwerpunkte-section__eyebrow">Unsere Schwerpunkte</p>
        <h2 class="schwerpunkte-section__heading" id="schwerpunkte-heading">Unsere zwei Schwerpunkte</h2>
        <p class="schwerpunkte-section__lead">Zwei Bereiche, in denen wir besonders stark sind – und in denen wir Unternehmen nachweislich weiterhelfen.</p>
        <div class="schwerpunkte-grid">
          <!-- Karte A -->
          <article class="schwerpunkt-card" data-reveal>
            <div class="card-head" aria-hidden="true">
              <Dither field="ripple" cell={3} class="card-head__flaeche" />
            </div>
            <div class="schwerpunkt-card__icon" aria-hidden="true">
              <Icon name="briefcase-plus" size={48} strokeWidth={1.5} />
            </div>
            <h3 class="schwerpunkt-card__title">Website-Leasing &amp; digitale Sichtbarkeit</h3>
            <p class="schwerpunkt-card__text">Monatliche Flatrate statt hoher Einmalkosten: Konzeption, Design, Umsetzung, Wartung und laufende Optimierung aus einer Hand – planbar und langfristig sicher.</p>
            <a href={`${base}website-leasing.html`} class="btn btn--outline schwerpunkt-card__link">Mehr zum Website-Leasing</a>
          </article>
          <!-- Karte B -->
          <article class="schwerpunkt-card" data-reveal>
            <div class="card-head" aria-hidden="true">
              <Dither field="noise" cell={3} class="card-head__flaeche" />
            </div>
            <div class="schwerpunkt-card__icon" aria-hidden="true">
              <Icon name="accessibility" size={48} strokeWidth={1.5} />
            </div>
            <h3 class="schwerpunkt-card__title">BFSG &amp; digitale Barrierefreiheit</h3>
            <p class="schwerpunkt-card__text">Seit Juni 2025 gilt das BFSG. Wir machen Ihre Website barrierearm nach EN 301 549 / WCAG 2.2 AA – rechtssicher und im echten Code, ohne Overlay-Plugins.</p>
            <a href={`${base}bfsg-wordpress-website-agentur.html#bfsg-check`} class="btn btn--outline schwerpunkt-card__link">BFSG-Check starten</a>
          </article>
        </div>
      </div>
    </section>

    <DitherBand field="noise" label="Leistungen" />

    <!-- Services Section -->
    <section id="services" class="services section">
      <div class="container">
        <p class="section-label" aria-hidden="true">Leistungen</p>
        <h2 class="section-title">Alle Leistungen im Überblick</h2>
        <ul class="services__grid" role="list">

          <!-- Card 0: Website-Leasing (hervorgehoben) -->
          <li class="service-card service-card--featured" data-reveal>
            <span class="service-card__number" aria-hidden="true">Neu</span>
            <div class="card__icon">
              <Icon name="briefcase-plus" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">Website-Leasing</h3>
            <p class="card__body">
              Professionelle Website ohne hohe Einmalkosten – monatliche Flatrate, Wartung und Hosting auf Wunsch inklusive.
            </p>
            <a href={`${base}website-leasing.html`} class="card__link">Mehr erfahren<span class="u-sr-only"> über Website-Leasing</span></a>
          </li>

          <!-- Card 1: Barrierefreie Websites -->
          <li class="service-card" data-reveal>
            <span class="service-card__number" aria-hidden="true">01</span>
            <div class="card__icon">
              <Icon name="accessibility" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">Barrierefreie Websites (BFSG)</h3>
            <p class="card__body">
              Wir entwickeln digitale Angebote, die BFSG- und WCAG-konform sind. Von der Prüfung bis zur Konformitätserklärung – alles aus einer Hand. Keine rechtlichen Risiken, sondern echte Zugänglichkeit.
            </p>
            <a href={`${base}bfsg-wordpress-website-agentur.html`} class="card__link">Mehr erfahren<span class="u-sr-only"> über Barrierefreie Websites (BFSG)</span></a>
          </li>

          <!-- Card 2: WordPress-Entwicklung -->
          <li class="service-card" data-reveal>
            <span class="service-card__number" aria-hidden="true">02</span>
            <div class="card__icon">
              <Icon name="code" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">WordPress-Entwicklung</h3>
