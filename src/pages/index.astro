---
/**
 * Die Startseite hat eine Aufgabe: In fünf Sekunden muss klar sein, was
 * wir tun (sichtbar machen), für wen (Betriebe mit 10 bis 50
 * Mitarbeitern) und was der erste Schritt ist (der Sichtbarkeits-Check).
 * Jeder Abschnitt stützt genau eine dieser drei Aussagen; was keine
 * stützt, steht auf einer Unterseite.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogoStrip from '../components/LogoStrip.astro';
import ReferenzKarte from '../components/ReferenzKarte.astro';
import Sprachnachricht from '../components/Sprachnachricht.astro';
import Icon from '../components/ui/Icon.astro';
import { faqs } from '../data/faq';
import { LANG } from '../data/sprachnachricht';
import { siteConfig } from '../config/site.config';
import { sichtbareReferenzen, zeigtUnfreigegebenes } from '../data/referenzen';
import portraet from '../assets/team/daniel-kontelis.jpg';

const base = import.meta.env.BASE_URL;
const { phone, phoneDisplay, hours } = siteConfig.contact;

const referenzenAuswahl = sichtbareReferenzen().filter((r) => r.startseite);

/* Porträts nur mit Einverständnis der Person; ohne Foto stehen die
   Initialen, damit niemand als Platzhalterbild erscheint. */
const team = [
  { name: 'Daniel Kontelis', rolle: 'Projektleitung, SEO, Online-Marketing', bild: portraet },
  { name: 'Filipos Makkas',  rolle: 'Projektleitung, Design, Kundenkontakt' },
  { name: 'Julius Heinisch', rolle: 'Programmierung, Datenbanken' },
  { name: 'Shakil Rifaat',   rolle: 'UX-Design, Corporate Design' },
];
const initialen = (name: string) => name.split(' ').map((t) => t[0]).join('');

const wege = [
  {
    id: 'weg-bestand',
    kicker: 'In Ihrer Zielgruppe',
    titel: 'Gefunden werden von denen, die suchen',
    text: 'Wer nach Ihrer Leistung sucht, soll bei Ihnen landen und schnell verstehen, warum er bleiben sollte. Dafür sorgen eine Website, die Anfragen bringt, ein Google-Eintrag, der stimmt, und Inhalte, die auch KI-Assistenten zitieren.',
    punkte: ['Website oder Website-Leasing', 'SEO und GEO', 'Erscheinungsbild und Barrierefreiheit'],
    link: 'leistungen.html#auftritt',
    linkText: 'So werden Sie gefunden',
  },
  {
    id: 'weg-neu',
    kicker: 'In einer neuen Zielgruppe',
    titel: 'Gesehen werden von denen, die Sie noch nicht kennen',
    text: 'Wer Sie nicht kennt, sucht auch nicht nach Ihnen. Diese Menschen erreichen Sie dort, wo sie ohnehin sind: mit Anzeigen, Social Media und Kampagnen, auch wenn Sie neue Mitarbeiter suchen.',
    punkte: ['Anzeigen bei Google und Meta', 'Social Media und Inhalte', 'Social Recruiting'],
    link: 'leistungen.html#reichweite',
    linkText: 'So erreichen Sie neue Kunden',
  },
];

const schritte = [
  {
    titel: 'Hinsehen',
    text: 'Im Sichtbarkeits-Check prüfen wir, wie man Sie heute findet und wo Interessenten abspringen. 30 Minuten, kostenfrei.',
  },
  {
    titel: 'Planen',
    text: 'Sie bekommen einen Plan mit Reihenfolge und Festpreis: was zuerst kommt, was warten kann, was Sie selbst erledigen können. Gebaut wird erst, wenn Sie zustimmen.',
  },
  {
    titel: 'Umsetzen',
    text: 'Website, Texte, Anzeigen und Technik aus einer Hand, mit einem Ansprechpartner. Danach messen wir, was es bringt, und justieren nach.',
  },
];
---

<BaseLayout
  slug=""
  title="Sichtbarkeit für Ihr Unternehmen – Agentur Köln | agentur dk"
  description="agentur dk aus Köln macht Betriebe mit 10 bis 50 Mitarbeitern sichtbar, mit Website, SEO und Online-Marketing. Start: der kostenfreie Sichtbarkeits-Check."
  mono
>

  <Header />

  <main id="main-content">

    <section class="start-kopf" aria-labelledby="hero-headline">
      <div class="container start-kopf__inner">
        <div>
          <p class="section-label">Agentur aus Köln für Betriebe mit 10 bis 50 Mitarbeitern</p>
          <h1 id="hero-headline" class="hero__headline">Wir machen Ihr Unternehmen sichtbar.</h1>
          <p class="hero__subline">
            Bei den Kunden, die Sie schon haben, und bei denen, die Sie noch
            nicht kennen. Mit Erfahrung, einem klaren Plan und sauberer Umsetzung.
          </p>
          <div class="start-kopf__aktionen">
            <a href={`${base}beratung.html`} class="btn btn--primary btn--lg">Sichtbarkeits-Check vereinbaren</a>
            <a href={`tel:${phone}`} class="start-telefon">
              <Icon name="phone" size={18} />
              <span>oder anrufen: {phoneDisplay}</span>
            </a>
          </div>
          <p class="start-kopf__hinweis">
            30 Minuten, kostenfrei. Sie gehen mit mindestens zwei Dingen heraus,
            die Sie sofort ändern können.
          </p>
        </div>

        <figure class="start-kopf__person">
          <Image src={portraet} alt="Daniel Kontelis"
                 widths={[320, 480, 640]} sizes="(min-width: 1024px) 400px, 70vw"
                 class="start-kopf__bild" loading="eager" fetchpriority="high" />
          <figcaption>
            <strong>Daniel Kontelis</strong>
            <span>Ihr Ansprechpartner für den Sichtbarkeits-Check</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <LogoStrip />

    <section class="section section--hell" aria-labelledby="wege-heading">
      <div class="container">
        <p class="section-label">Was wir für Sie tun</p>
        <h2 id="wege-heading" class="section-title">Sichtbar werden heißt zweierlei</h2>
        <p class="section-lead">
          Manche Kunden suchen Sie schon, andere wissen noch nicht, dass es Sie
          gibt. Für beide gibt es einen eigenen Weg, und meistens braucht es beide.
        </p>
        <div class="wege">
          {wege.map((w) => (
            <article class="weg" aria-labelledby={w.id}>
              <p class="weg__kicker">{w.kicker}</p>
              <h3 id={w.id} class="weg__titel">{w.titel}</h3>
              <p class="weg__text">{w.text}</p>
              <ul class="weg__punkte" role="list">
                {w.punkte.map((p) => <li><Icon name="check" size={18} />{p}</li>)}
              </ul>
              <a href={`${base}${w.link}`} class="weg__link">{w.linkText}<span aria-hidden="true">&nbsp;→</span></a>
            </article>
          ))}
        </div>
        <p class="wege__zusatz">
          Und wenn im Betrieb zu viel liegen bleibt: KI-Assistenten, die ans Telefon
          gehen oder Termine vergeben. <a href={`${base}ki-services.html`}>Mehr zu KI im Betrieb</a>
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="vorgehen-heading">
      <div class="container">
        <p class="section-label">So gehen wir vor</p>
        <h2 id="vorgehen-heading" class="section-title">Erfahrung, ein klarer Plan, saubere Umsetzung</h2>
        <ol class="schritte" role="list">
          {schritte.map((s, i) => (
            <li class="schritt">
              <span class="schritt__nr" aria-hidden="true">{i + 1}</span>
              <h3 class="schritt__titel">{s.titel}</h3>
              <p class="schritt__text">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--hell" aria-labelledby="kernteam-heading">
      <div class="container team-start">
        <div>
          <p class="section-label">Wer für Sie arbeitet</p>
          <h2 id="kernteam-heading" class="section-title">Sie wissen, mit wem Sie sprechen</h2>
          <p class="section-lead">
            Ein kleines Team in der Kölner Südstadt. Ihr Ansprechpartner bleibt
            derselbe, vom ersten Gespräch bis lange nach dem Start.
          </p>
          <ul class="team-start__liste" role="list">
            {team.map((t) => (
              <li class="person">
                {t.bild ? (
                  <Image src={t.bild} alt="" width={96} height={96} class="person__bild" loading="lazy" />
                ) : (
                  <span class="person__bild person__bild--initialen" aria-hidden="true">{initialen(t.name)}</span>
                )}
                <span class="person__name">{t.name}</span>
                <span class="person__rolle">{t.rolle}</span>
              </li>
            ))}
          </ul>
          <p class="team-start__weiter">
            <a href={`${base}ueber-uns.html`} class="weg__link">Mehr über uns<span aria-hidden="true">&nbsp;→</span></a>
          </p>
        </div>

        <div class="team-start__seite">
          <Sprachnachricht aufnahme={LANG} class="kt__nachricht" />
          <aside class="empfehlung" aria-labelledby="empfehlung-heading">
            <h3 id="empfehlung-heading" class="empfehlung__titel">Sie wurden uns empfohlen?</h3>
            <p class="empfehlung__text">
              Dann rufen Sie einfach an und sagen Sie, wer Sie schickt.
              Ein Formular brauchen Sie dafür nicht.
            </p>
            <a href={`tel:${phone}`} class="empfehlung__nummer">
              <Icon name="phone" size={20} />
              {phoneDisplay}
            </a>
            <p class="empfehlung__zeit">{hours}</p>
          </aside>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="referenzen-heading">
      <div class="container">
        <p class="section-label">Referenzen</p>
        <h2 class="section-title" id="referenzen-heading">Betriebe wie Ihrer</h2>
        <p class="section-lead">
          Eine Hausverwaltung, eine Praxis, eine Kanzlei: Hier sehen Sie die
          Websites, die wir für sie gebaut haben.
        </p>
        {zeigtUnfreigegebenes() && (
          <p class="referenzen__warnung" role="note">
            <strong>Nur in der Vorschau sichtbar:</strong> Einzelne Fälle sind noch nicht vom
            Kunden freigegeben. Sobald die Indexierungssperre fällt, erscheinen ausschließlich
            freigegebene Referenzen.
          </p>
        )}
        <div class="case-grid">
          {referenzenAuswahl.map((r) => <ReferenzKarte r={r} />)}
        </div>
        <p class="referenzen__weiter">
          <a href={`${base}projekte.html`} class="btn btn--secondary">Alle Referenzen ansehen</a>
        </p>
      </div>
    </section>

    <section id="faq" class="faq section section--hell" aria-labelledby="faq-heading">
      <div class="container">
        <h2 class="section-title" id="faq-heading">Häufige Fragen</h2>
        <div class="accordion">
          {(faqs['']?.items ?? []).map((item, i) => (
            <div class="accordion__item">
              <h3 class="accordion__heading">
                <button type="button" class="accordion__trigger" id={`faq-trigger-${i + 1}`} aria-expanded="false" aria-controls={`faq-panel-${i + 1}`}>
                  <span>{item.question}</span>
                  <Icon name="plus" size={20} class="accordion__icon" />
                </button>
              </h3>
              <div id={`faq-panel-${i + 1}`} class="accordion__panel" role="region" aria-labelledby={`faq-trigger-${i + 1}`} hidden>
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="kontakt" class="section section--blau" aria-labelledby="kontakt-heading">
      <div class="container abschluss__inner">
        <div>
          <p class="section-label">Sichtbarkeits-Check · 30 Minuten · kostenfrei</p>
          <h2 class="section-title" id="kontakt-heading">Wo verlieren Sie heute Kunden?</h2>
          <p class="abschluss__text">
            Nach einer halben Stunde wissen Sie es. Wir sehen uns vorher an, wie man
            Sie findet, und sagen Ihnen im Gespräch, was Sie als Erstes ändern sollten.
          </p>
          <ul class="abschluss__liste" role="list">
            <li><Icon name="check" size={18} />Vorher angesehen: Website, Google, KI-Antworten</li>
            <li><Icon name="check" size={18} />Mindestens zwei Dinge, die Sie sofort umsetzen können</li>
            <li><Icon name="check" size={18} />Am Telefon oder bei uns am Sachsenring</li>
          </ul>
        </div>
        <div class="abschluss__wege">
          <a href={`${base}beratung.html`} class="btn btn--primary btn--lg">Sichtbarkeits-Check vereinbaren</a>
          <a href={`tel:${phone}`} class="abschluss__nummer">
            <Icon name="phone" size={20} />
            {phoneDisplay}
          </a>
          <p class="abschluss__adresse">
            agentur dk – design &amp; kommunikation<br />
            Sachsenring 57, 50677 Köln<br />
            {hours}
          </p>
        </div>
      </div>
    </section>

  </main>

  <Footer mono />

</BaseLayout>

<style>
  .start-kopf {
    padding-block: var(--raum-abschnitt) var(--raum-abschnitt-weit);
  }
  .start-kopf__inner {
    display: grid;
    gap: var(--rinne-spalte);
    align-items: center;
  }
  @media (min-width: 900px) {
    .start-kopf__inner {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }
  .start-kopf .hero__headline {
    margin: var(--rinne-3) 0 var(--rinne-4);
    max-width: 14ch;
  }
  .start-kopf .hero__subline {
    margin: 0;
    max-width: 34ch;
    color: var(--color-text-muted);
  }
  .start-kopf__aktionen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--rinne-3) var(--rinne-5);
    margin-top: var(--rinne-5);
  }
  .start-telefon,
  .abschluss__nummer,
  .empfehlung__nummer {
    display: inline-flex;
    align-items: center;
    gap: var(--rinne-1);
    min-height: 44px;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }
  .start-telefon:hover,
  .empfehlung__nummer:hover,
  .abschluss__nummer:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .start-kopf__hinweis {
    margin: var(--rinne-3) 0 0;
    font-size: var(--dk-schrift-karte);
    color: var(--color-text-muted);
    max-width: 46ch;
  }
  .start-kopf__person {
    margin: 0;
    justify-self: center;
    width: min(100%, 400px);
  }
  .start-kopf__bild {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
  }
  .start-kopf__person figcaption {
    display: flex;
    flex-direction: column;
    margin-top: var(--rinne-2);
    font-size: var(--dk-schrift-karte);
    line-height: 1.4;
  }
  .start-kopf__person figcaption span {
    color: var(--color-text-muted);
  }
  @media (max-width: 899px) {
    .start-kopf__person {
      justify-self: start;
      width: min(100%, 280px);
    }
  }

  .section-lead {
    max-width: var(--dk-measure-lead);
  }

  .wege {
    display: grid;
    gap: var(--rinne-4);
    margin-top: var(--rinne-6);
  }
  @media (min-width: 800px) {
    .wege { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .weg {
    display: flex;
    flex-direction: column;
    gap: var(--rinne-2);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .weg__kicker {
    margin: 0;
    font-size: var(--dk-schrift-karte);
    font-weight: 700;
    color: var(--color-accent);
  }
  .weg__titel {
    margin: 0;
    max-width: 22ch;
  }
  .weg__text {
    margin: 0;
    font-size: var(--dk-schrift-karte);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
  }
  .weg__punkte {
    list-style: none;
    margin: var(--rinne-1) 0 0;
    padding: 0;
    display: grid;
    gap: var(--rinne-1);
    font-size: var(--dk-schrift-karte);
  }
  .weg__punkte li,
  .abschluss__liste li {
    display: flex;
    align-items: center;
    gap: var(--rinne-1);
  }
  .weg__punkte :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent);
  }
  .weg__link {
    margin-top: auto;
    padding-top: var(--rinne-3);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }
  .weg__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .wege__zusatz {
    margin: var(--rinne-5) 0 0;
    font-size: var(--dk-schrift-karte);
    color: var(--color-text-muted);
    max-width: 70ch;
  }

  .schritte {
    list-style: none;
    margin: var(--rinne-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--rinne-5);
    counter-reset: none;
  }
  @media (min-width: 800px) {
    .schritte { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .schritt {
    display: flex;
    flex-direction: column;
    gap: var(--rinne-2);
    padding-top: var(--rinne-4);
    border-top: 2px solid var(--color-text);
  }
  .schritt__nr {
    font-size: var(--dk-schrift-titel-3);
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
  }
  .schritt__titel {
    margin: 0;
  }
  .schritt__text {
    margin: 0;
    font-size: var(--dk-schrift-karte);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
    max-width: 40ch;
  }

  .team-start {
    display: grid;
    gap: var(--rinne-6);
  }
  @media (min-width: 960px) {
    .team-start { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: start; }
  }
  .team-start__liste {
    list-style: none;
    margin: var(--rinne-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: var(--rinne-4);
  }
  .person {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: var(--rinne-3);
    align-items: center;
  }
  .person__bild {
    grid-row: span 2;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }
  .person__bild--initialen {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #14365F;
    color: #ffffff;
    font-weight: 700;
    font-size: var(--dk-schrift-karte);
  }
  .person__name {
    align-self: end;
    font-weight: 700;
    font-size: var(--dk-schrift-karte);
  }
  .person__rolle {
    align-self: start;
    font-size: var(--dk-schrift-klein);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .team-start__weiter {
    margin: var(--rinne-5) 0 0;
  }
  .team-start__seite {
    display: grid;
    gap: var(--rinne-4);
  }
  .empfehlung {
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
  }
  .empfehlung__titel {
    margin: 0 0 var(--rinne-2);
  }
  .empfehlung__text {
    margin: 0 0 var(--rinne-2);
    font-size: var(--dk-schrift-karte);
    color: var(--color-text-muted);
  }
  .empfehlung__nummer {
    font-size: var(--dk-schrift-vorspann);
    color: var(--color-accent);
  }
  .empfehlung__zeit {
    margin: 0;
    font-size: var(--dk-schrift-klein);
    color: var(--color-text-muted);
  }

  .referenzen__weiter {
    margin: var(--rinne-5) 0 0;
  }
  .case-grid {
    margin-top: var(--rinne-5);
  }

  .abschluss__inner {
    display: grid;
    gap: var(--rinne-6);
    align-items: end;
  }
  @media (min-width: 900px) {
    .abschluss__inner { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  }
  .abschluss__text {
    margin: 0;
    max-width: 44ch;
    font-size: var(--dk-schrift-text);
    color: var(--color-text-muted);
  }
  .abschluss__liste {
    list-style: none;
    margin: var(--rinne-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--rinne-1);
    font-size: var(--dk-schrift-karte);
  }
  .abschluss__wege {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--rinne-3);
  }
  .abschluss__nummer {
    font-size: var(--dk-schrift-vorspann);
    color: #ffffff;
  }
  .abschluss__adresse {
    margin: 0;
    font-size: var(--dk-schrift-klein);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>
