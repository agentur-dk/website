    <!-- FAQ Section -->
    <section id="faq" class="faq section">
      <div class="container">
        <p class="section-label" aria-hidden="true">FAQ</p>
        <h2 class="section-title">Häufige Fragen</h2>
        <div class="accordion">
          {faqs[''].items.map((item, i) => (
            <div class="accordion__item">
              <h3 class="accordion__heading">
                <button type="button" class="accordion__trigger" id={`faq-trigger-${i + 1}`} aria-expanded="false" aria-controls={`faq-panel-${i + 1}`}>
                  <span>{item.question}</span>
                  <Icon name="plus" size={20} class="accordion__icon" />
