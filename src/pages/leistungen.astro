---
/**
 * Die Leistungen in drei Feldern statt acht gleichrangiger Angebote. Wer
 * hier ankommt, kennt seine Lage, nicht unsere Begriffe: Deshalb beginnt
 * jede Leistung mit dem Satz, den ein Kunde selbst sagen würde.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaSection from '../components/CtaSection.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { leistungen, type Feld } from '../data/leistungen';

const base = import.meta.env.BASE_URL;

/* Die Ausgangslage je Leistung, in den Worten eines Kunden. */
const lage: Record<string, string> = {
  'website-leasing.html':                '„Wir brauchen eine gute Website, aber nicht die Einmalkosten.“',
  'wordpress-entwicklung.html':          '„Unsere Website ist alt, langsam oder schwer zu pflegen.“',
  'seo-geo.html':                        '„Wir werden bei Google und in KI-Antworten nicht gefunden.“',
  'bfsg-wordpress-website-agentur.html': '„Wir sind unsicher, ob uns das BFSG betrifft.“',
  'corporate-design.html':               '„Unser Auftritt wirkt uneinheitlich und beliebig.“',
  'online-marketing.html':               '„Wir geben Geld für Werbung aus und wissen nicht, was zurückkommt.“',
  'social-recruiting.html':              '„Wir finden keine Mitarbeiter mehr.“',
  'ki-services.html':                    '„Anrufe bleiben liegen, Routinearbeit frisst Zeit.“',
};

const felder: { id: Feld; nr: string; titel: string; text: string }[] = [
  {
    id: 'auftritt',
    nr: 'Feld 1 · In Ihrer Zielgruppe',
    titel: 'Gefunden werden',
    text: 'Wer nach Ihrer Leistung sucht, soll bei Ihnen landen und verstehen, warum er bleiben sollte. Dafür muss alles zusammenpassen: Website, Google-Eintrag, Erscheinungsbild und die Inhalte, die Suchmaschinen und KI-Assistenten lesen.',
  },
  {
    id: 'reichweite',
    nr: 'Feld 2 · In einer neuen Zielgruppe',
    titel: 'Neue Menschen erreichen',
    text: 'Wer Sie nicht kennt, sucht auch nicht nach Ihnen. Diese Menschen erreichen Sie dort, wo sie ohnehin sind: mit Anzeigen, Social Media und Kampagnen, ob Sie Kunden suchen oder Mitarbeiter.',
  },
  {
    id: 'entlastung',
    nr: 'Feld 3 · Im Betrieb',
    titel: 'Entlastet werden',
    text: 'Mehr Sichtbarkeit bringt mehr Anfragen. Damit die nicht liegen bleiben, übernehmen KI-Assistenten Routinearbeit: Sie gehen ans Telefon, vergeben Termine und beantworten wiederkehrende Fragen.',
  },
];
---

<BaseLayout
  slug="leistungen"
  title="Leistungen: Website, SEO, Marketing, KI | agentur dk Köln"
  description="Die Leistungen der agentur dk aus Köln in drei Feldern: gefunden werden, neue Menschen erreichen, entlastet werden. Von Website bis KI-Assistent."
  mono
>
  <Header />

  <main id="main-content">
    <div class="page-header container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol class="breadcrumb__list">
          <li><a href={`${base}`}>Start</a></li>
          <li><span aria-current="page">Leistungen</span></li>
        </ol>
      </nav>
      <h1 class="page-header__title">Drei Felder, ein Ziel: Sie werden gesehen.</h1>
      <p class="page-header__lead">
        Alles, was wir tun, zahlt auf Ihre Sichtbarkeit ein. Welche Felder Sie
        brauchen und in welcher Reihenfolge, klären wir im Sichtbarkeits-Check.
      </p>
      <nav class="feld-sprung" aria-label="Felder auf dieser Seite">
        {felder.map((f) => <a href={`#${f.id}`}>{f.titel}</a>)}
      </nav>
    </div>

    {felder.map((f, i) => (
      <section id={f.id} class:list={['section', i % 2 === 0 && 'section--hell']} aria-labelledby={`${f.id}-heading`}>
        <div class="container">
          <p class="section-label">{f.nr}</p>
          <h2 id={`${f.id}-heading`} class="section-title">{f.titel}</h2>
          <p class="section-lead feld__text">{f.text}</p>
          <ul class="leistungskarten" role="list">
            {leistungen.filter((l) => l.feld === f.id).map((l) => (
              <li class="leistungskarte">
                <p class="leistungskarte__lage">{lage[l.datei]}</p>
                <h3 class="leistungskarte__titel">
                  <a href={`${base}${l.datei}`}>{l.titel}</a>
                </h3>
                <p class="leistungskarte__text">{l.text}</p>
                <span class="leistungskarte__mehr" aria-hidden="true">Mehr erfahren →</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}

    <FaqAccordion slug="leistungen" />

    <CtaSection
      label="Sichtbarkeits-Check · 30 Minuten · kostenfrei"
      title="Nicht sicher, wo Sie anfangen sollen?"
      text="Dafür ist der Sichtbarkeits-Check da. Wir sehen uns vorher an, wie man Sie findet, und sagen Ihnen, welches Feld zuerst dran ist."
      buttonLabel="Sichtbarkeits-Check vereinbaren"
      buttonHref={`${base}beratung.html`}
    />
  </main>

  <Footer mono />
</BaseLayout>

<style>
  .feld-sprung {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rinne-2);
    margin-top: var(--rinne-5);
  }
  .feld-sprung a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: 700;
    font-size: var(--dk-schrift-karte);
    text-decoration: none;
  }
  .feld-sprung a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .feld__text {
    max-width: var(--dk-measure-lead);
  }

  .leistungskarten {
    list-style: none;
    margin: var(--rinne-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--rinne-4);
  }
  /* Die ganze Karte ist klickbar, der Link bleibt aber die Überschrift:
     So liest ein Screenreader einen Linktext statt eines ganzen Absatzes. */
  .leistungskarte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--rinne-2);
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .leistungskarte:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 8px 24px rgb(27 27 31 / 0.08);
  }
  .leistungskarte:focus-within {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .leistungskarte__lage {
    margin: 0;
    font-size: var(--dk-schrift-karte);
    color: var(--color-text-muted);
  }
  .leistungskarte__titel {
    margin: 0;
  }
  .leistungskarte__titel a {
    color: var(--color-text);
    text-decoration: none;
  }
  .leistungskarte__titel a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .leistungskarte__titel a:focus-visible {
    outline: none;
  }
  .leistungskarte__text {
    margin: 0;
    font-size: var(--dk-schrift-karte);
    line-height: var(--dk-leading-body);
    color: var(--color-text-muted);
  }
  .leistungskarte__mehr {
    margin-top: auto;
    padding-top: var(--rinne-2);
    font-weight: 700;
    font-size: var(--dk-schrift-karte);
    color: var(--color-accent);
  }
</style>
