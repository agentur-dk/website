---
import BaseLayout from '../layouts/BaseLayout.astro';
import DitherBand from '../components/DitherBand.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaSection from '../components/CtaSection.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Icon from '../components/ui/Icon.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  slug="leistungen"
  title="Leistungen – Web, BFSG, SEO & Marketing | agentur dk"
  description="Website-Leasing, barrierefreie WordPress-Entwicklung, SEO/GEO, Online-Marketing, Social Recruiting, Corporate Design und KI-Services aus Köln."
  mono
>

  <Header />

  <main id="main-content">

    <DitherBand field="orbit" label="Leistungen" cell={3} />

    <!-- Page Header -->
    <div class="page-header container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol class="breadcrumb__list">
          <li><a href={`${base}`}>Start</a></li>
          <li><span aria-current="page">Leistungen</span></li>
        </ol>
      </nav>
      <h1 class="page-header__title">Leistungen für Website, Sichtbarkeit und Marke</h1>
      <p class="page-header__lead">Von BFSG-barrierefreien WordPress-Websites über SEO &amp; GEO bis zu KI-Services: Alle Leistungen der agentur dk im Überblick.</p>
    </div>

    <!-- Unsere Schwerpunkte -->
    <section class="schwerpunkte-section section" aria-labelledby="schwerpunkte-heading-l">
      <div class="container">
        <p class="schwerpunkte-section__eyebrow">Was wir tun</p>
        <h2 class="schwerpunkte-section__heading" id="schwerpunkte-heading-l">Digitale Lösungen mit Schwerpunkt</h2>
        <p class="schwerpunkte-section__lead">Neben unserem vollständigen Leistungsspektrum haben wir zwei Kernbereiche, in denen wir besonders tiefes Know-how und nachgewiesene Ergebnisse vorweisen können.</p>
        <div class="schwerpunkte-grid">
          <!-- Karte A -->
          <article class="schwerpunkt-card" data-reveal>
            <div class="schwerpunkt-card__icon" aria-hidden="true">
              <Icon name="briefcase-business" size={48} strokeWidth={1.5} />
            </div>
            <h3 class="schwerpunkt-card__title">Website-Leasing &amp; digitale Sichtbarkeit</h3>
            <p class="schwerpunkt-card__text">Monatliche Flatrate statt hoher Einmalkosten: Konzeption, Design, Umsetzung, Wartung und laufende Optimierung aus einer Hand – planbar und langfristig sicher.</p>
            <a href={`${base}website-leasing.html`} class="btn btn--outline schwerpunkt-card__link">Mehr zum Website-Leasing</a>
          </article>
          <!-- Karte B -->
          <article class="schwerpunkt-card" data-reveal>
            <div class="schwerpunkt-card__icon" aria-hidden="true">
              <Icon name="accessibility" size={48} strokeWidth={1.5} />
            </div>
            <h3 class="schwerpunkt-card__title">BFSG &amp; digitale Barrierefreiheit</h3>
            <p class="schwerpunkt-card__text">Seit Juni 2025 gilt das BFSG. Wir machen Ihre Website barrierearm nach EN 301 549 / WCAG 2.2 AA – rechtssicher und im echten Code, ohne Overlay-Plugins.</p>
            <a href={`${base}bfsg-wordpress-website-agentur.html#bfsg-check`} class="btn btn--outline schwerpunkt-card__link">BFSG-Check starten</a>
          </article>
        </div>
      </div>
    </section>


    <!-- Orientierung: Ausgangslage → passende Leistung -->
    <section class="section" aria-labelledby="orientation-heading">
      <div class="container">
        <h2 class="section-title" id="orientation-heading">Welche Leistung passt zu Ihrer Situation?</h2>
        <p class="orientation__lead">
          Die meisten Anfragen lassen sich einer von sieben Ausgangslagen zuordnen.
          Wenn Sie sich in einer davon wiederfinden, führt der Link direkt zur passenden Seite.
        </p>
        <dl class="orientation__list">
          <div class="orientation__row">
            <dt class="orientation__case">„Wir sind unsicher, ob uns das BFSG betrifft."</dt>
            <dd class="orientation__answer">
              Der kostenlose Selbstcheck klärt in vier Fragen, ob Ihr Angebot unter das
              Barrierefreiheitsstärkungsgesetz fällt.
              <a href={`${base}bfsg-wordpress-website-agentur.html#bfsg-check`} class="text-link">Zum BFSG-Check</a>
            </dd>
          </div>
          <div class="orientation__row">
            <dt class="orientation__case">„Unsere Website ist alt, langsam oder schwer zu pflegen."</dt>
            <dd class="orientation__answer">
              Relaunch auf WordPress mit sauberem Code, Core-Web-Vitals-Optimierung und einer
              Redaktion, die Ihr Team ohne technisches Vorwissen bedient.
              <a href={`${base}wordpress-entwicklung.html`} class="text-link">Zur WordPress-Entwicklung</a>
            </dd>
          </div>
          <div class="orientation__row">
            <dt class="orientation__case">„Wir brauchen eine gute Website, aber nicht die Einmalkosten."</dt>
            <dd class="orientation__answer">
              Website-Leasing verteilt die Investition auf eine feste Monatsrate — Wartung,
              Hosting und Support auf Wunsch inklusive.
              <a href={`${base}website-leasing.html`} class="text-link">Zum Website-Leasing</a>
            </dd>
          </div>
          <div class="orientation__row">
            <dt class="orientation__case">„Wir werden bei Google und in KI-Antworten nicht gefunden."</dt>
            <dd class="orientation__answer">
              Technisches SEO für klassische Suche, GEO für ChatGPT, Claude, Gemini und
              Perplexity — inklusive strukturierter Daten und llms.txt.
              <a href={`${base}seo-geo.html`} class="text-link">Zu SEO &amp; GEO</a>
            </dd>
          </div>
          <div class="orientation__row">
            <dt class="orientation__case">„Wir geben Budget für Werbung aus, ohne zu wissen, was zurückkommt."</dt>
            <dd class="orientation__answer">
              Kampagnen auf Google, Meta und LinkedIn mit Messung entlang des ROAS statt
              entlang von Reichweitenzahlen.
              <a href={`${base}online-marketing.html`} class="text-link">Zum Online-Marketing</a>
            </dd>
          </div>
          <div class="orientation__row">
            <dt class="orientation__case">„Wir finden keine Mitarbeitenden mehr."</dt>
            <dd class="orientation__answer">
              Social Recruiting spricht Fachkräfte dort an, wo sie sind — statt auf
              Bewerbungen auf ausgeschriebene Stellen zu warten.
              <a href={`${base}social-recruiting.html`} class="text-link">Zum Social Recruiting</a>
            </dd>
          </div>
          <div class="orientation__row">
            <dt class="orientation__case">„Unser Auftritt wirkt uneinheitlich und beliebig."</dt>
            <dd class="orientation__answer">
              Logo, Farbwelt, Typografie und Anwendungsregeln in einem Manual, das über alle
              Kanäle hinweg trägt.
              <a href={`${base}corporate-design.html`} class="text-link">Zum Corporate Design</a>
            </dd>
          </div>
          <div class="orientation__row">
            <dt class="orientation__case">„Anrufe bleiben liegen, Routineaufgaben fressen Zeit."</dt>
            <dd class="orientation__answer">
              KI-Telefon-Agenten nehmen rund um die Uhr an und buchen Termine; KI-gestützte
              Textarbeit entlastet die Redaktion.
              <a href={`${base}ki-services.html`} class="text-link">Zu den KI-Services</a>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Services Grid Section -->
    <DitherBand field="dunes" label="Alle Leistungen" cell={4} />

    <section class="services section">
      <div class="container">
        <ul class="services__grid" role="list">

          <!-- Card 1: Barrierefreie Websites -->
          <li class="service-card" data-reveal>
            <span class="service-card__number" aria-hidden="true">01</span>
            <div class="card__icon">
              <Icon name="accessibility" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">Barrierefreie Websites (BFSG)</h3>
            <p class="card__body">
              Wir entwickeln digitale Angebote, die BFSG- und WCAG-konform sind. Von der Prüfung bis zur Konformitätserklärung – alles aus einer Hand. Keine rechtlichen Risiken, sondern echte Zugänglichkeit.
            </p>
            <a href={`${base}bfsg-wordpress-website-agentur.html`} class="card__link">Mehr erfahren<span class="u-sr-only"> über Barrierefreie Websites (BFSG)</span></a>
          </li>

          <!-- Card 2: WordPress-Entwicklung -->
          <li class="service-card" data-reveal>
            <span class="service-card__number" aria-hidden="true">02</span>
            <div class="card__icon">
              <Icon name="code" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">WordPress-Entwicklung</h3>
            <p class="card__body">
              Maßgeschneiderte WordPress-Websites mit sauberem Code, schnellen Ladezeiten und nahtloser Bedienung. Wir bauen Websites, die Ihr Team selbst pflegen kann – ohne technisches Vorwissen.
            </p>
            <a href={`${base}wordpress-entwicklung.html`} class="card__link">Mehr erfahren<span class="u-sr-only"> über WordPress-Entwicklung</span></a>
          </li>

          <!-- Card 3: SEO & GEO -->
          <li class="service-card" data-reveal>
            <span class="service-card__number" aria-hidden="true">03</span>
            <div class="card__icon">
              <Icon name="search-check" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">SEO &amp; GEO</h3>
            <p class="card__body">
              Klassische Suchmaschinenoptimierung kombiniert mit Generative Engine Optimization (GEO) für ChatGPT, Google Gemini und Co. Wir sichern Ihre Sichtbarkeit – heute und morgen.
            </p>
            <a href={`${base}seo-geo.html`} class="card__link">Mehr erfahren<span class="u-sr-only"> über SEO und GEO</span></a>
          </li>

          <!-- Card 4: Online-Marketing -->
          <li class="service-card" data-reveal>
            <span class="service-card__number" aria-hidden="true">04</span>
            <div class="card__icon">
              <Icon name="megaphone" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">Online-Marketing</h3>
            <p class="card__body">
              Strategisches Online-Marketing, das Ihre Zielgruppe dort erreicht, wo sie sich aufhält. Von Content-Strategie über Social Media bis hin zu E-Mail-Kampagnen – messbar und effizient.
            </p>
            <a href={`${base}online-marketing.html`} class="card__link">Mehr erfahren<span class="u-sr-only"> über Online-Marketing</span></a>
          </li>

          <!-- Card 5: Corporate Design -->
          <li class="service-card" data-reveal>
            <span class="service-card__number" aria-hidden="true">05</span>
            <div class="card__icon">
              <Icon name="palette" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">Corporate Design</h3>
            <p class="card__body">
              Ein einheitliches Erscheinungsbild, das Vertrauen schafft. Wir entwickeln Logo, Farbwelt und Designsystem für eine konsistente Markenkommunikation auf allen Kanälen.
            </p>
            <a href={`${base}corporate-design.html`} class="card__link">Mehr erfahren<span class="u-sr-only"> über Corporate Design</span></a>
          </li>

          <!-- Card 6: KI-Services -->
          <li class="service-card" data-reveal>
            <span class="service-card__number" aria-hidden="true">06</span>
            <div class="card__icon">
              <Icon name="cpu" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">KI-Services</h3>
            <p class="card__body">
              KI-gestützte Content-Produktion, Prozessautomatisierung und GEO-Strategien für Ihr Unternehmen. Wir setzen künstliche Intelligenz da ein, wo sie echten Mehrwert bringt.
            </p>
            <a href={`${base}ki-services.html`} class="card__link">Mehr erfahren<span class="u-sr-only"> über KI-Services</span></a>
          </li>

          <!-- Card 7: Social Recruiting -->
          <li class="service-card" data-reveal>
            <span class="service-card__number" aria-hidden="true">07</span>
            <div class="card__icon">
              <Icon name="users" size={32} strokeWidth={1.8} />
            </div>
            <h3 class="card__title">Social Recruiting</h3>
            <p class="card__body">
              Fachkräfte aktiv über LinkedIn, Meta &amp; Co. ansprechen – mit KI-gestützter Zielgruppenanalyse und Kampagnen, die Bewerbungen bringen. Statt Warten: gezielt finden.
            </p>
            <a href={`${base}social-recruiting.html`} class="card__link">Mehr erfahren<span class="u-sr-only"> über Social Recruiting</span></a>
          </li>

        </ul>
      </div>
    </section>

    <!-- Closing CTA -->
    <CtaSection
      title="Bereit, Ihr Projekt zu starten?"
      text="Kostenloses Erstgespräch, unverbindlich. Wir melden uns innerhalb von 24 Stunden."
      buttonLabel="Projekt anfragen"
      buttonHref={`${base}#contact`}
    />

  </main>

  <Footer mono />
</BaseLayout>    <FaqAccordion slug="leistungen" />

  <style>
    /* Orientierungsabschnitt: Ausgangslage links, Antwort rechts.
       Als <dl> ausgezeichnet, weil genau das die Struktur ist —
       Begriff und zugehörige Erläuterung. Screenreader kündigen die
       Paare dadurch als Liste an, und Parser lesen die Zuordnung
       verlässlich, was der Zitierfähigkeit in KI-Antworten zugutekommt. */
    .orientation__lead {
      max-width: 62ch;
      margin: 0 auto var(--space-10, 2.5rem);
      color: var(--color-text-muted);
      line-height: 1.7;
      text-align: center;
    }
    .orientation__list {
      max-width: var(--container-narrow, 720px);
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .orientation__row {
      display: grid;
      gap: 0.375rem 2rem;
      padding-block: 1.25rem;
      border-top: 1px solid var(--color-border);
    }
    .orientation__row:last-child { border-bottom: 1px solid var(--color-border); }
    .orientation__case {
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--color-text);
      line-height: 1.4;
    }
    .orientation__answer {
      margin: 0;
      color: var(--color-text-muted);
      line-height: 1.7;
    }
    .orientation__answer .text-link { white-space: nowrap; }

    @media (min-width: 48rem) {
      .orientation__row { grid-template-columns: 15rem 1fr; align-items: start; }
    }
  </style>
