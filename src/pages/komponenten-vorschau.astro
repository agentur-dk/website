  {
    number: '06',
    title: 'KI-Services',
    text: 'KI-gestützte Content-Produktion, Prozessautomatisierung und GEO-Strategien für Ihr Unternehmen. Wir setzen künstliche Intelligenz da ein, wo sie echten Mehrwert bringt.',
    href: 'ki-services',
    icon: '<rect x="7" y="7" width="10" height="10" rx="1"/><line x1="9" y1="3" x2="9" y2="7"/><line x1="15" y1="3" x2="15" y2="7"/><line x1="9" y1="17" x2="9" y2="21"/><line x1="15" y1="17" x2="15" y2="21"/><line x1="3" y1="9" x2="7" y2="9"/><line x1="3" y1="15" x2="7" y2="15"/><line x1="17" y1="9" x2="21" y2="9"/><line x1="17" y1="15" x2="21" y2="15"/>',
  },
  {
    number: '07',
    title: 'Social Recruiting',
    text: 'Fachkräfte aktiv über LinkedIn, Meta & Co. ansprechen – mit KI-gestützter Zielgruppenanalyse und Kampagnen, die Bewerbungen bringen. Statt Warten: gezielt finden.',
    href: 'social-recruiting',
    icon: '<circle cx="9" cy="7" r="3"/><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/><circle cx="18" cy="7" r="2.5"/><path d="M22 21v-2a3.5 3.5 0 00-2.5-3.35"/>',
  },
];

const referenceCards = [
  {
    client: 'Bundesministerium für Familie, Senioren, Frauen und Jugend',
    industry: 'Öffentliche Hand',
    text: 'Konzeption, Gestaltung und Umsetzung eines deutschlandweiten Eltern-Anfrageportals für Familienhotels. Fokus auf sozialschwache Familien mit Kindern mit Handicap.',
    tags: ['BFSG', 'WordPress'],
    logoInitials: 'BMFSFJ',
    logoVariant: 'blue' as const,
    href: '/website/projekte',
  },
  {
    client: 'TARGOBANK AG',
    industry: 'Finanzdienstleistung',
    text: 'Social-Recruiting-Kampagne für NRW mit Konzeption, Planung und Videodreh. Moderner Recruitingprozess in bestehende Konzernprozesse integriert.',
    tags: ['Online-Marketing', 'Social Recruiting'],
    logoInitials: 'TARG',
    logoVariant: 'green' as const,
    href: '/website/projekte',
  },
  {
    client: 'Berufsförderungswerk Düren & Mainz',
    industry: 'Bildung',
    text: 'Konzeption, Gestaltung und Entwicklung einer Website für die Zielgruppe blinde Menschen. Usability und Design für sehende und blinde Menschen kombiniert.',
    tags: ['BFSG', 'Barrierefreiheit', 'WordPress'],
    logoInitials: 'BFW',
    logoVariant: 'purple' as const,
    href: '/website/projekte',
  },
