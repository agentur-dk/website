---
/**
 * Komponenten-Vorschau – Phase 2 (wird vor Deploy gelöscht)
 * Nur für Entwicklung/Build-Verifikation. Nicht verlinken, nicht indexieren.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaSection from '../components/CtaSection.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ReferenceCard from '../components/ReferenceCard.astro';
import LogoStrip from '../components/LogoStrip.astro';
import StatsStrip from '../components/StatsStrip.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import TabNav from '../components/TabNav.astro';
import LeadForm from '../components/LeadForm.astro';

const serviceCards = [
  {
    number: '01',
    title: 'Barrierefreie Websites (BFSG)',
    text: 'Wir entwickeln digitale Angebote, die BFSG- und WCAG-konform sind. Von der Prüfung bis zur Konformitätserklärung – alles aus einer Hand. Keine rechtlichen Risiken, sondern echte Zugänglichkeit.',
    href: 'bfsg-wordpress-website-agentur',
    icon: '<circle cx="12" cy="5" r="2"/><path d="M8 11l-3 2v3h2v5h2v-3h2v3h2v-5h2v-3l-3-2"/><path d="M5 17a7 7 0 0114 0"/>',
  },
  {
    number: '02',
    title: 'WordPress-Entwicklung',
    text: 'Maßgeschneiderte WordPress-Websites mit sauberem Code, schnellen Ladezeiten und nahtloser Bedienung. Wir bauen Websites, die Ihr Team selbst pflegen kann – ohne technisches Vorwissen.',
