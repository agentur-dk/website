const logos = [
  { name: 'TARGOBANK' },
  { name: 'BMFSFJ' },
  { name: 'Berufsförderungswerk' },
  { name: 'Kundenlogo 1' },
  { name: 'Kundenlogo 2' },
];

const stats = [
  { number: '15', suffix: '+', label: 'Jahre Erfahrung' },
  { number: '150', suffix: '+', label: 'Projekte abgeschlossen' },
  { number: '80', suffix: '+', label: 'Zufriedene Kunden' },
  { number: '100', suffix: '%', label: 'WCAG-Konformität' },
];

const faqItems = [
  {
    question: 'Was ist Website-Leasing und für wen lohnt es sich?',
    answer: 'Beim Website-Leasing erhalten Sie eine professionell entwickelte WordPress-Website gegen eine feste monatliche Rate — ohne hohe Einmalinvestition. Das Modell eignet sich besonders für Unternehmen, die schnell einen hochwertigen Webauftritt benötigen, aber keine große Anfangsinvestition tätigen möchten. Wartung und Hosting sind auf Wunsch inklusive.',
  },
  {
    question: 'Was kostet eine professionelle WordPress-Website?',
    answer: 'Je nach Umfang und bestehendem System beginnen WordPress-Projekte bei ca. 2.500 €. Alternativ bieten wir Website-Leasing ab einer monatlichen Rate an — ohne Einmalkosten. Für größere Relaunches mit Design, Entwicklung und BFSG-Konformitätserklärung kalkulieren wir individuell. Wir erstellen Ihnen ein transparentes Festpreisangebot.',
  },
  {
    question: 'Wie lange dauert ein WordPress-Relaunch?',
    answer: 'Typische Projekte dauern 4–8 Wochen – abhängig von Seitenanzahl, Funktionsumfang und der Verfügbarkeit von Inhalten. Dank flacher Hierarchien und direkter Kommunikation halten wir Zeitpläne zuverlässig ein.',
  },
  {
    question: 'Bieten Sie auch laufende Betreuung an?',
    answer: 'Ja, wir bieten flexible Wartungs- und Support-Pakete an: von monatlichen Updates und Sicherheits-Patches bis hin zu laufendem SEO und Content-Pflege. So bleibt Ihre Website dauerhaft performant, sicher und BFSG-konform.',
  },
  {
    question: 'Was ist das BFSG und gilt es für uns?',
    answer: 'Das BFSG (Barrierefreiheitsstärkungsgesetz) verpflichtet ab dem 28. Juni 2025 Anbieter privater Websites und digitaler Produkte zur Barrierefreiheit gemäß EN 301 549. Es gilt für Unternehmen mit mehr als 10 Mitarbeitenden oder einem Jahresumsatz über 2 Mio. €, die Verbrauchern digitale Dienstleistungen anbieten. Wir prüfen kostenlos, ob Ihre Website betroffen ist.',
  },
];

const tabItems = [
  { label: 'Alle Leistungen', href: '#leistungen' },
  { label: 'BFSG & Barrierefreiheit', href: '#bfsg' },
  { label: 'WordPress', href: '#wordpress' },
  { label: 'SEO & GEO', href: '#seo' },
  { label: 'Online-Marketing', href: '#marketing' },
];
---

<BaseLayout
  title="Komponenten-Vorschau – Phase 2 (wird vor Deploy gelöscht)"
  noindex={true}
>
  <Header />

  <main id="main-content">
    <!-- Vorschau-Banner -->
    <div class="preview-banner">
      <strong>Komponenten-Vorschau – Phase 2</strong>
      (wird vor dem produktiven Deploy gelöscht)
    </div>

    <!-- 1. CtaSection -->
    <section class="preview-section" aria-label="Vorschau CtaSection">
      <div class="preview-label">CtaSection</div>
      <CtaSection
        title="Bereit für Ihre neue Website?"
        text="Kostenloses Erstgespräch, unverbindlich. Wir melden uns innerhalb von 24 Stunden."
        buttonLabel="Jetzt anfragen"
        buttonHref="#contact"
      />
    </section>

    <!-- 2. ServiceCards -->
    <section class="preview-section" aria-label="Vorschau ServiceCard">
      <div class="preview-label">ServiceCard (7 Leistungen)</div>
      <div class="preview-grid preview-grid--cards">
        {serviceCards.map((card) => (
          <ServiceCard
            title={card.title}
            text={card.text}
            href={card.href}
            icon={card.icon}
            number={card.number}
          />
        ))}
      </div>
    </section>

    <!-- 3. ReferenceCards -->
    <section class="preview-section" aria-label="Vorschau ReferenceCard">
      <div class="preview-label">ReferenceCard (BMFSFJ, TARGOBANK, BFW)</div>
      <div class="preview-grid preview-grid--refs">
        {referenceCards.map((ref) => (
          <ReferenceCard
            client={ref.client}
            industry={ref.industry}
            text={ref.text}
            tags={ref.tags}
            logoInitials={ref.logoInitials}
            logoVariant={ref.logoVariant}
            href={ref.href}
          />
        ))}
      </div>
    </section>

    <!-- 4. LogoStrip -->
    <section class="preview-section" aria-label="Vorschau LogoStrip">
      <div class="preview-label">LogoStrip (scrollend, Pause bei Hover, reduzierte Bewegung: statisch)</div>
      <LogoStrip logos={logos} label="Unsere Kunden" />
    </section>

    <!-- 5. StatsStrip -->
    <section class="preview-section" aria-label="Vorschau StatsStrip">
      <div class="preview-label">StatsStrip</div>
      <StatsStrip stats={stats} />
    </section>

    <!-- 6. FaqAccordion -->
    <section class="preview-section" aria-label="Vorschau FaqAccordion">
      <div class="preview-label">FaqAccordion (eines offen gleichzeitig, keyboard-operable)</div>
      <FaqAccordion
        items={faqItems}
        heading="Häufig gestellte Fragen"
      />
    </section>

    <!-- 7. TabNav -->
    <section class="preview-section" aria-label="Vorschau TabNav">
      <div class="preview-label">
        TabNav (Sektions-Navigation – Anker-Links; kein echtes Tab-Muster in Legacy vorhanden)
      </div>
      <TabNav items={tabItems} ariaLabel="Leistungs-Navigation" />
    </section>

    <!-- 8. LeadForm -->
    <section class="preview-section" aria-label="Vorschau LeadForm">
      <div class="preview-label">
        LeadForm (2-Schritte, Honeypot, Zeitstempel-Spam-Schutz, aria-live Status)
      </div>
      <LeadForm page="Komponenten-Vorschau" heading="Projekt anfragen" />
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .preview-banner {
    background-color: var(--color-primary);
    color: var(--color-on-gradient);
    text-align: center;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    position: sticky;
    top: 64px;
    z-index: 100;
  }

  .preview-section {
    position: relative;
    border-bottom: 2px dashed var(--color-border);
  }

  .preview-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary-light);
    background-color: var(--color-surface-alt);
    border-bottom: 1px solid var(--color-border);
    padding: 0.5rem 1.5rem;
  }

  .preview-grid {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 2.5rem;
  }

  .preview-grid--cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }

  .preview-grid--refs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }
</style>
