---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BfsgCheck from '../components/BfsgCheck.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  slug="bfsg-wordpress-website-agentur"
  title="Barrierefreie WordPress-Website nach BFSG | agentur dk"
  description="BFSG-konforme WordPress-Websites aus Köln nach EN 301 549 und WCAG 2.2 AA: Audit, Umsetzung, Erklärung. Kostenloser Selbstcheck in zwei Minuten."
    service={{
      name:        'BFSG-konforme WordPress-Entwicklung',
      description: 'Accessibility-Audit, technische Umsetzung nach EN 301 549 / WCAG 2.2 AA und Erstellung der Barrierefreiheitserklärung nach § 12 BFSG.',
      serviceType: 'Web Accessibility Consulting',
      offers: ['Accessibility-Audit', 'WCAG 2.2 AA Umsetzung', 'Barrierefreiheits-Erklärung', 'Tastaturbedienbarkeit', 'Screenreader-Optimierung', 'Laufende Überwachung'],
    }}
>

  <Header />

  <main id="main-content" tabindex="-1">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <div class="container">
        <ol class="breadcrumb__list">
          <li><a href={`${base}`}>Start</a></li>
          <li><a href={`${base}leistungen.html`}>Leistungen</a></li>
          <li><span aria-current="page">BFSG WordPress</span></li>
        </ol>
      </div>
    </nav>

    <!-- SECTION: Page Hero -->
    <section class="section section--hero" aria-labelledby="hero-heading">
      <div class="container">
        <p class="section__label">BFSG &amp; WordPress</p>
        <h1 id="hero-heading" class="section__headline">Barrierefreie WordPress-Websites nach BFSG</h1>
        <p class="section__lead">Das Barrierefreiheitsstärkungsgesetz (BFSG) verpflichtet ab dem 28. Juni 2025 zur digitalen Barrierefreiheit. Wir entwickeln WordPress-Websites, die EN 301 549 und WCAG 2.2 AA erfüllen — rechtssicher, modern, performant.</p>
        <div class="hero__actions">
          <a href="#bfsg-check" class="btn btn--primary">BFSG-Selbstcheck starten</a>
          <a href="#contact" class="btn btn--secondary">Beratung anfragen</a>
        </div>
      </div>
    </section>

    <!-- SECTION: Das BFSG -->
    <section class="section section--dark" aria-labelledby="bfsg-was-heading">
      <div class="container">
        <div class="section__grid section__grid--2col">
          <div class="section__col">
            <h2 id="bfsg-was-heading" class="section__heading">Das BFSG: Pflicht, nicht Kür</h2>
            <p>Das Barrierefreiheitsstärkungsgesetz trat am 28. Juni 2022 in Kraft und gilt ab dem 28. Juni 2025 für alle privaten Anbieter digitaler Produkte und Dienstleistungen in der EU, die sich an Verbraucher richten.</p>
            <p>Rechtliche Grundlage ist der European Accessibility Act (EAA), der in Deutschland als BFSG umgesetzt wurde. Betroffen sind insbesondere Websites mit Online-Shops, Buchungs- und Bestellstrecken sowie digitale Services für Endverbraucher.</p>
            <p>Bei Verstößen drohen Abmahnungen durch Wettbewerber und Verbände sowie Bußgelder von bis zu 100.000 €. Die Marktüberwachungsbehörde kann außerdem den Betrieb der Website untersagen.</p>
          </div>
          <div class="section__col">
            <h3 class="section__subheading">Kernpflichten im Überblick</h3>
            <ul class="checklist">
              <li class="checklist__item">WCAG 2.2 Konformitätsstufe AA</li>
              <li class="checklist__item">EN 301 549 (Europäischer Zugänglichkeitsstandard)</li>
              <li class="checklist__item">Barrierefreiheits-Erklärung nach §12 BFSG</li>
              <li class="checklist__item">Feedback-Mechanismus für Nutzerinnen und Nutzer</li>
              <li class="checklist__item">Konformitätserklärung auf Anfrage</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: Leistungsumfang -->
    <section class="section section--light" aria-labelledby="leistungen-heading">
      <div class="container">
        <p class="section__label">Was wir liefern</p>
        <h2 id="leistungen-heading" class="section__heading">Unser BFSG-Leistungsumfang</h2>
        <div class="card-grid card-grid--3col">
          <article class="card" data-reveal>
            <h3 class="card__heading">Accessibility-Audit</h3>
            <p class="card__body">Analyse Ihrer bestehenden Website nach EN 301 549 — automatisiert und manuell mit Screenreader und Tastatur.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">WCAG 2.2 AA Umsetzung</h3>
            <p class="card__body">Technische Korrektur aller identifizierten Barrieren im Theme-Code, in Plugins und in den Inhalten.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">Barrierefreiheits-Erklärung</h3>
            <p class="card__body">Rechtssichere Dokumentation des Konformitätsstatus Ihrer Website nach §12 BFSG inklusive Feedback-Mechanismus.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">Tastaturbedienbarkeit</h3>
            <p class="card__body">Vollständige Tastaturnavigation für alle interaktiven Elemente — Menüs, Formulare, Akkordeons und Modaldialoge.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">Screenreader-Optimierung</h3>
            <p class="card__body">ARIA-Markup, semantische HTML-Struktur und korrektes Fokus-Management für assistive Technologien.</p>
          </article>
          <article class="card" data-reveal>
            <h3 class="card__heading">Laufende Überwachung</h3>
            <p class="card__body">Kontinuierliches Monitoring und Reporting — damit Ihre Website auch nach Updates BFSG-konform bleibt.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- BFSG-Selbstcheck -->
    <section id="bfsg-check" class="bfsg-check-section section" aria-labelledby="bfsg-check-heading">
      <div class="container container--narrow">
        <p class="section__label">Selbstcheck</p>
        <h2 class="section__heading" id="bfsg-check-heading">BFSG-Selbstcheck: Fällt Ihr Unternehmen unter das Gesetz?</h2>
        <p class="section__lead">Beantworten Sie vier Fragen – wir zeigen Ihnen, ob das Barrierefreiheitsstärkungsgesetz für Ihr Unternehmen gilt.</p>
        <BfsgCheck />
      </div>
    </section>

    <!-- SECTION: Ablauf -->
    <section class="section section--light" aria-labelledby="ablauf-heading">
      <div class="container">
        <h2 id="ablauf-heading" class="section__heading">So läuft Ihr BFSG-Projekt ab</h2>
        <ol class="process-list">
          <li class="process-list__item" data-reveal>
            <span class="process-list__number" aria-hidden="true">01</span>
            <div class="process-list__content">
              <h3 class="process-list__heading">Erstgespräch &amp; Audit</h3>
              <p class="process-list__body">Analyse der bestehenden Website, Identifikation aller Barrieren nach EN 301 549 mit automatisierten und manuellen Prüfmethoden.</p>
            </div>
          </li>
          <li class="process-list__item" data-reveal>
            <span class="process-list__number" aria-hidden="true">02</span>
            <div class="process-list__content">
              <h3 class="process-list__heading">Konzept &amp; Angebot</h3>
              <p class="process-list__body">Maßnahmenplan mit Priorisierung und transparente Kostenübersicht — damit Sie genau wissen, was auf Sie zukommt.</p>
            </div>
          </li>
          <li class="process-list__item" data-reveal>
            <span class="process-list__number" aria-hidden="true">03</span>
            <div class="process-list__content">
              <h3 class="process-list__heading">Umsetzung</h3>
              <p class="process-list__body">Technische Implementierung aller Maßnahmen, kontinuierliches Testing mit Screenreader (NVDA, VoiceOver) und Tastatur.</p>
            </div>
          </li>
          <li class="process-list__item" data-reveal>
            <span class="process-list__number" aria-hidden="true">04</span>
            <div class="process-list__content">
              <h3 class="process-list__heading">Abnahme &amp; Dokumentation</h3>
              <p class="process-list__body">Erstellung der Barrierefreiheits-Erklärung nach §12 BFSG und rechtssicherer Nachweis der Konformität für Ihre Unterlagen.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- SECTION: FAQ -->
    <FaqAccordion slug="bfsg-wordpress-website-agentur" />

    <!-- SECTION: Weitere Leistungen -->
    <section class="section section--sm" aria-label="Weitere Leistungen">
      <div class="container">
        <h2 class="section__subheading">Weitere Leistungen der agentur dk</h2>
        <ul class="footer-col__list" role="list">
          <li><a href={`${base}wordpress-entwicklung.html`} class="footer-col__link">WordPress-Entwicklung</a></li>
          <li><a href={`${base}seo-geo.html`} class="footer-col__link">SEO &amp; GEO</a></li>
          <li><a href={`${base}online-marketing.html`} class="footer-col__link">Online-Marketing</a></li>
          <li><a href={`${base}social-recruiting.html`} class="footer-col__link">Social Recruiting</a></li>
          <li><a href={`${base}corporate-design.html`} class="footer-col__link">Corporate Design</a></li>
          <li><a href={`${base}ki-services.html`} class="footer-col__link">KI-Services</a></li>
        </ul>
      </div>
    </section>

    <!-- SECTION: Kontakt -->
    <LeadForm page="BFSG & Barrierefreiheit" heading="BFSG-Beratung anfragen" />

  </main>

  <Footer />
</BaseLayout>
